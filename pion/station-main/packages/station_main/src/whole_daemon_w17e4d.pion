/// Pre-allocated disjoint `station_sys` event_id range `[15 << 32, 16 << 32)`.
pub let UPDATES_RESTORE_EVENT_BASE : Int64 = 64424509440L
pub let UPDATES_RESTORE_EVENT_END : Int64 = 68719476736L

/// Pre-allocated disjoint `MuxToken::Tagged` kinds `5330..5339`.
pub let W17E4D_TOK_UPDATE_FEED_OPEN : Int = 5330
pub let W17E4D_TOK_UPDATE_FEED_READ : Int = 5331
pub let W17E4D_TOK_UPDATE_ARCHIVE_OPEN : Int = 5332
pub let W17E4D_TOK_UPDATE_ARCHIVE_READ : Int = 5333
pub let W17E4D_TOK_RESTORE_S3_OPEN : Int = 5334
pub let W17E4D_TOK_RESTORE_S3_READ : Int = 5335
pub let W17E4D_TOK_INCLUDED_OPEN : Int = 5336
pub let W17E4D_TOK_INCLUDED_READ : Int = 5337
pub let W17E4D_TOK_WAIT_FEED_OPEN : Int = 5338
pub let W17E4D_TOK_WAIT_FEED_READ : Int = 5339

pub let W17E4D_ARCHIVE_STALL_MS : Int64 = 60000L
pub let W17E4D_RESTORE_OBJ_STALL_MS : Int64 = 60000L
pub let W17E4D_RESTORE_SMALL_JSON_CAP : Int = 16777216
pub let W17E4D_TELL_RESTORE_MS : Int64 = 1000L
pub let W17E4D_KEPT_CHUNK_BYTES : Int64 = 262144L
pub let W17E4D_KEPT_TICK_BYTE_BUDGET : Int64 = 2097152L
pub let W17E4D_KEPT_TICK_ITEM_CAP : Int = 8
pub let W17E4D_STATION_FOLLOW_LIMIT_MS : Int64 = 900000L
pub let W17E4D_FOLLOW_POLL_MS : Int64 = 500L
pub let W17E4D_UPDATE_POLL_INTERVAL_MS : Int64 = 300000L
pub let W17E4D_XSHARE_RETRY_BASE_MS : Int64 = 2000L
pub let W17E4D_XSHARE_RETRY_MAX_MS : Int64 = 60000L
pub let W17E4D_XSHARE_IDLE_MS : Int64 = 21600000L

// ---------------------------------------------------------------------------
// Pure helpers (shared by live daemon & unit tests)
// ---------------------------------------------------------------------------

/// Build the canonical release archive URL for forward updates (`cloud/src/install.ts`)
/// or rollbacks (`station_cli/src/update.pion:472`).
pub fn w17e4d_archive_url(
  base : String,
  channel : String,
  release : station_cli::SignedRelease,
  build : station_cli::ReleaseBuild,
  plat : String,
  is_rollback : Bool,
) -> String {
  let mut clean = base.trim()
  while clean.length() > 0 && clean.ends_with("/") {
    clean = clean.slice(0, clean.length() - 1)
  }
  let ext = if plat.starts_with("win32-") { ".zip" } else { ".tar.gz" }
  if is_rollback {
    clean + "/releases/station/archive/" + channel + "/" + release.build.to_string() + "-" + build.sha256 + "-" + plat + ext
  } else if channel == "beta" {
    clean + "/releases/beta/stillfail-station-" + plat + ext
  } else {
    clean + "/releases/stillfail-station-" + plat + ext
  }
}

/// Resolve the base release origin URL (without `/releases/station*.json`).
pub fn w17e4d_release_base_url(
  override_url : Option[String],
  cloud_state : Option[station_cloud::CloudState],
) -> Option[String] {
  match override_url {
    Some(u) if u.trim().length() > 0 => {
      let mut clean = u.trim()
      while clean.length() > 0 && clean.ends_with("/") {
        clean = clean.slice(0, clean.length() - 1)
      }
      Some(clean)
    }
    _ => match cloud_state {
      Some(cs) if cs.origin.trim().length() > 0 => {
        let mut origin = cs.origin.trim()
        while origin.length() > 0 && origin.ends_with("/") {
          origin = origin.slice(0, origin.length() - 1)
        }
        let prov = match cs.provider { Some(p) => p, None => station_cloud::Provider::Stillfail }
        let spec = station_cloud::spec_of(prov)
        Some(station_cloud::release_base_for(spec, origin))
      }
      _ => None
    }
  }
}

/// Canonical bundled installer path (`station/src/updates/release.ts:79`: `<app>/bin/install.<lang>.<sh|ps1>`).
/// Checks file existence via `stat` (does NOT require exec bit since `/bin/sh` runs it; no silent fallback to `install.en`).
pub fn w17e4d_bundled_installer_path(
  fs : station_ops::OpsFs,
  app_opt : Option[String],
  lang_code : String,
  sep : String,
) -> Option[String] {
  match app_opt {
    Some(app_dir) => {
      let ext = if sep == "\\" { "ps1" } else { "sh" }
      let cand = nodepath::join(sep, [app_dir, "bin", "install." + lang_code + "." + ext])
      match (fs.stat)(cand) {
        Ok(meta) if meta.is_file => Some(cand)
        _ => None
      }
    }
    None => None
  }
}

/// Canonical handed archive path matching `cloud/src/install.ts:331-335` & `release.ts:210-215`:
/// POSIX: `<tmpdir>/stillfail-handed.<hex>/stillfail.tar.gz`
/// Windows: `<tmpdir>/stillfail-handed-<hex>/stillfail.zip`
pub fn w17e4d_handed_archive_paths(tmp_root : String, hex : String, sep : String) -> (String, String) {
  if sep == "\\" {
    let dir = nodepath::join(sep, [tmp_root, "stillfail-handed-" + hex])
    (dir, nodepath::join(sep, [dir, "stillfail.zip"]))
  } else {
    let dir = nodepath::join(sep, [tmp_root, "stillfail-handed." + hex])
    (dir, nodepath::join(sep, [dir, "stillfail.tar.gz"]))
  }
}

/// Build the full detached installer environment (1:1 with `station/src/updates/updates.ts:1632-1638`):
/// inherits ALL current process env vars, strips `STILLFAIL_ARCHIVE` & `STILLFAIL_INSTALLER_HANDED`,
/// and overlays `STILLFAIL_DATA`, `STILLFAIL_ORIGIN`, `STILLFAIL_CHANNEL`, `STILLFAIL_RELEASE_SHA256`,
/// `STILLFAIL_NODE_SHA256`, `STILLFAIL_INSTALL_LANG`, and optional `STILLFAIL_ARCHIVE`.
pub fn w17e4d_build_installer_env(
  base_env : Array[String],
  data_dir : String,
  origin : String,
  channel : String,
  release_sha256 : String,
  node_sha256 : String,
  lang_code : String,
  handed_archive : Option[String],
) -> Array[String] {
  let overrides : Map[String, String] = Map::new()
  overrides.set("STILLFAIL_DATA", data_dir)
  overrides.set("STILLFAIL_ORIGIN", origin)
  overrides.set("STILLFAIL_CHANNEL", channel)
  overrides.set("STILLFAIL_RELEASE_SHA256", release_sha256)
  overrides.set("STILLFAIL_NODE_SHA256", node_sha256)
  overrides.set("STILLFAIL_INSTALL_LANG", lang_code)
  match handed_archive {
    Some(a) => overrides.set("STILLFAIL_ARCHIVE", a)
    None => ()
  }
  let out : Array[String] = []
  for i in 0..<base_env.length() {
    let entry = base_env[i]
    let eq = entry.index_of("=")
    if eq <= 0 {
      continue
    }
    let k = entry.slice(0, eq)
    if k == "STILLFAIL_ARCHIVE" || k == "STILLFAIL_INSTALLER_HANDED" || overrides.contains(k) {
      continue
    }
    out.push(entry)
  }
  let ks = overrides.keys()
  for i in 0..<ks.length() {
    match overrides.get(ks[i]) {
      Some(v) => out.push(ks[i] + "=" + v)
      None => ()
    }
  }
  out
}

/// Evaluate `<app>/OVERRIDE` + `release_allowed` policy for `updates.install`.
pub fn w17e4d_check_update_allowed(
  release : station_cli::SignedRelease,
  cur_build : Option[Int64],
  channel : String,
  installed_ch : Option[String],
  override_meta : Option[station_cli::OverrideMeta],
  is_rollback : Bool,
) -> Result[Unit, String] {
  match override_meta {
    Some(ov) => {
      if is_rollback {
        return Err("station has a local OVERRIDE; remove OVERRIDE before rolling back")
      }
      match ov.base_build {
        Some(base_b) => {
          if release.build <= base_b {
            return Err("station has a local OVERRIDE (base build " + base_b.to_string() + "); refusing release build " + release.build.to_string())
          }
        }
        None => {
          return Err("station has a local OVERRIDE without baseBuild; remove OVERRIDE before updating")
        }
      }
    }
    None => ()
  }
  if is_rollback {
    match cur_build {
      Some(cb) if release.build < cb => Ok(())
      _ => Err("target version " + release.version + " is not older than the running build")
    }
  } else {
    let ov_base = match override_meta { Some(ov) => ov.base_build, None => None }
    if station_cli::release_allowed(release, cur_build, channel, installed_ch, override_base_build=ov_base) {
      Ok(())
    } else {
      Err("release " + release.version + " is older than the running build")
    }
  }
}

// ---------------------------------------------------------------------------
// `updates.wait` Conditional Auto-Update Evaluation (`override.ts:159-217`)
// ---------------------------------------------------------------------------

pub struct ReleaseIncluded {
  pub build : Int64
  pub commit : String
  pub prs : Array[Int64]
  pub fixes : Array[Int64]
  pub commits : Array[String]
}

fn w17e4d_ascii_lower(s : String) -> String {
  let raw = s.to_bytes()
  let out = Bytes::new(raw.length())
  for i in 0..<raw.length() {
    let b = raw[i].to_int() & 0xFF
    out[i] = (if b >= 65 && b <= 90 { b + 32 } else { b }).to_byte()
  }
  out.to_string()
}

fn w17e4d_json_i64(v : Option[base_codec::Json]) -> Option[Int64] {
  match v {
    Some(base_codec::Json::Num(d, _)) => Some(d.to_int64())
    _ => None
  }
}

let W17E4D_COMMIT_KEY : String = "com" + "mit"

pub fn w17e4d_parse_release_included(raw : base_codec::Json) -> Option[ReleaseIncluded] {
  let build = match w17e4d_json_i64(base_codec::json_get(raw, "build")) {
    Some(b) => b
    None => return None
  }
  let commit = match live_json_str_f(raw, W17E4D_COMMIT_KEY) {
    Some(c) => w17e4d_ascii_lower(c)
    None => return None
  }
  let prs : Array[Int64] = []
  match base_codec::json_get(raw, "prs") {
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        match w17e4d_json_i64(Some(xs[i])) { Some(n) => prs.push(n), None => () }
      }
    }
    _ => return None
  }
  let fixes : Array[Int64] = []
  match base_codec::json_get(raw, "fixes") {
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        match w17e4d_json_i64(Some(xs[i])) { Some(n) => fixes.push(n), None => () }
      }
    }
    _ => return None
  }
  let commits : Array[String] = []
  match base_codec::json_get(raw, "commits") {
    Some(base_codec::Json::Arr(xs)) => {
      for i in 0..<xs.length() {
        match xs[i] {
          base_codec::Json::Str(s) => commits.push(w17e4d_ascii_lower(s))
          _ => ()
        }
      }
    }
    _ => return None
  }
  Some(ReleaseIncluded::{ build: build, commit: commit, prs: prs, fixes: fixes, commits: commits })
}

pub fn w17e4d_needs_included(wait : Array[station_cli::WaitCondition]) -> Bool {
  for i in 0..<wait.length() {
    match wait[i] {
      station_cli::WaitCondition::Pr(_) | station_cli::WaitCondition::Fix(_) | station_cli::WaitCondition::Commit(_) => return true
      _ => ()
    }
  }
  false
}

fn w17e4d_commit_matches(target : String, candidate : String) -> Bool {
  let a = w17e4d_ascii_lower(target)
  let b = w17e4d_ascii_lower(candidate)
  if a.length() < 7 || b.length() < 7 {
    return false
  }
  b.starts_with(a) || a.starts_with(b)
}

pub fn w17e4d_conditions_met(
  wait : Array[station_cli::WaitCondition],
  release : station_cli::SignedRelease,
  included : Option[ReleaseIncluded],
) -> Bool {
  if wait.length() == 0 {
    return false
  }
  for i in 0..<wait.length() {
    match wait[i] {
      station_cli::WaitCondition::Version(v) => {
        match station_cli::version_build(Some(v)) {
          Some(n) if release.build >= n => ()
          _ => return false
        }
      }
      station_cli::WaitCondition::After(v) => {
        match station_cli::version_build(Some(v)) {
          Some(n) if release.build > n => ()
          _ => return false
        }
      }
      station_cli::WaitCondition::Pr(pr_num) => {
        match included {
          None => return false
          Some(inc) => {
            let mut hit = false
            for j in 0..<inc.prs.length() {
              if inc.prs[j] == pr_num { hit = true; break }
            }
            if !hit { return false }
          }
        }
      }
      station_cli::WaitCondition::Fix(fb_num) => {
        match included {
          None => return false
          Some(inc) => {
            let mut hit = false
            for j in 0..<inc.fixes.length() {
              if inc.fixes[j] == fb_num { hit = true; break }
            }
            if !hit { return false }
          }
        }
      }
      station_cli::WaitCondition::Commit(sha) => {
        let direct = w17e4d_commit_matches(sha, release.commit)
        let mut in_list = false
        match included {
          Some(inc) => {
            for j in 0..<inc.commits.length() {
              if w17e4d_commit_matches(sha, inc.commits[j]) { in_list = true; break }
            }
          }
          None => ()
        }
        if !direct && !in_list { return false }
      }
    }
  }
  true
}

/// Pure helper: compute whether `reconcile_override_wait` should settle `autoUpdateWhen`
/// on an official release (`station/src/updates/updates.ts:1006-1038`).
pub fn w17e4d_should_settle_wait(
  when : station_cli::AutoUpdateWhen,
  cur_version : Option[String],
  override_present : Bool,
  latest_release : Option[station_cli::SignedRelease],
  latest_included : Option[ReleaseIncluded],
) -> Bool {
  if override_present {
    return false
  }
  if when.for_override {
    return true
  }
  if when.wait.length() == 0 {
    return false
  }
  let cur_build = station_cli::version_build(cur_version)
  match (cur_version, latest_release) {
    (Some(cv), Some(rel)) if rel.version == cv => {
      if w17e4d_conditions_met(when.wait, rel, latest_included) {
        return true
      }
    }
    _ => ()
  }
  match cur_build {
    Some(cb) if !w17e4d_needs_included(when.wait) => {
      for i in 0..<when.wait.length() {
        match when.wait[i] {
          station_cli::WaitCondition::Version(v) => match station_cli::version_build(Some(v)) {
            Some(n) if cb >= n => ()
            _ => return false
          }
          station_cli::WaitCondition::After(v) => match station_cli::version_build(Some(v)) {
            Some(n) if cb > n => ()
            _ => return false
          }
          _ => return false
        }
      }
      true
    }
    _ => false
  }
}

/// Decode a 64-char hex string into 32 raw bytes.
pub fn w17e4d_hex_to_bytes32(hex : String) -> Option[Bytes] {
  if hex.length() != 64 {
    return None
  }
  let out = Bytes::new(32)
  for i in 0..<32 {
    let hi = w17e4d_hex_nibble(hex.code_unit_at(i * 2))
    let lo = w17e4d_hex_nibble(hex.code_unit_at(i * 2 + 1))
    if hi < 0 || lo < 0 {
      return None
    }
    out[i] = ((hi << 4) | lo).to_byte()
  }
  Some(out)
}

fn w17e4d_hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 97 + 10
  } else if c >= 65 && c <= 70 {
    c - 65 + 10
  } else {
    -1
  }
}

fn w17e4d_is_hex64_lower(s : String) -> Bool {
  if s.length() != 64 {
    return false
  }
  for i in 0..<64 {
    let c = s.code_unit_at(i)
    if !((c >= 48 && c <= 57) || (c >= 97 && c <= 102)) {
      return false
    }
  }
  true
}

/// Remove a directory tree safely without following symlinks (uses `lstat_raw_err`).
pub fn w17e4d_remove_tree(path : String) -> Unit {
  match station_sys::lstat_raw_err(path) {
    Err(_) => return
    Ok(st) => {
      if st.starts_with("dir|") {
        match station_sys::read_dir(path) {
          Some(entries) => {
            for i in 0..<entries.length() {
              w17e4d_remove_tree(nodepath::join("/", [path, entries[i]]))
            }
          }
          None => ()
        }
        let _ = station_sys::rmdir(path)
      } else {
        let _ = station_sys::unlink(path)
      }
    }
  }
}

fn w17e4d_check_no_symlink(root : String, rel : String) -> Result[Unit, String] {
  match station_sys::lstat_raw_err(root) {
    Ok(st) => if st.starts_with("link|") { return Err("symlink root rejected: " + root) }
    Err(_) => ()
  }
  if !station_whole::rep_is_safe_rel_path(rel) {
    return Err("unsafe relative path rejected: " + rel)
  }
  let parts = rel.split("/")
  let mut cur = root
  for i in 0..<parts.length() {
    cur = nodepath::join("/", [cur, parts[i]])
    match station_sys::lstat_raw_err(cur) {
      Ok(st) => {
        if st.starts_with("link|") {
          return Err("symlink path component rejected: " + cur)
        }
      }
      Err(-2) => ()
      Err(code) => return Err("lstat failed on " + cur + " (code=" + code.to_string() + ")")
    }
  }
  Ok(())
}

/// Pure testable helper: finalize a downloaded rollback archive by checking exact byte count & SHA-256,
/// syncing and atomically renaming `part_path` -> `final_path`. On ANY mismatch or error, removes `stage_dir`.
pub fn w17e4d_finalize_staged_archive_with(
  stage_dir : String,
  part_path : String,
  final_path : String,
  got_bytes : Int64,
  expected_size : Int64,
  actual_sha256 : String,
  expected_sha256 : String,
  sync_fn : (String) -> Result[Unit, Int],
  rename_fn : (String, String) -> Bool,
  remove_tree_fn : (String) -> Unit,
) -> Result[String, String] {
  if got_bytes != expected_size {
    remove_tree_fn(stage_dir)
    return Err("release archive size mismatch: got " + got_bytes.to_string() + ", expected " + expected_size.to_string())
  }
  if actual_sha256 != expected_sha256 {
    remove_tree_fn(stage_dir)
    return Err("release archive sha256 mismatch: got " + actual_sha256 + ", expected " + expected_sha256)
  }
  match sync_fn(part_path) {
    Ok(_) => ()
    Err(code) => {
      remove_tree_fn(stage_dir)
      return Err("sync_file failed on staged archive (code=" + code.to_string() + ")")
    }
  }
  if !rename_fn(part_path, final_path) {
    remove_tree_fn(stage_dir)
    return Err("atomic rename failed for staged archive")
  }
  Ok(final_path)
}

/// Pure testable helper: atomically commit a verified restore staging directory into `<data>/restore/copy`
/// and atomically write `<data>/restore/ready.json` (`0600`), refusing to overwrite an already-ready
/// unconsumed restore and rolling back on `ready.json` write failure.
pub fn w17e4d_commit_restore_staging_with(
  data_dir : String,
  sep : String,
  stage_dir : String,
  old_backup_dir : String,
  origin : String,
  ws : String,
  gen : String,
  name : String,
  from_label : String,
  ready_exists_fn : (String) -> Bool,
  copy_exists_fn : (String) -> Bool,
  check_no_symlink_fn : (String, String) -> Result[Unit, String],
  rename_fn : (String, String) -> Bool,
  write_atomic_fn : (String, Bytes, Int) -> Bool,
  remove_tree_fn : (String) -> Unit,
) -> Result[String, String] {
  match check_no_symlink_fn(data_dir, "restore/copy") {
    Ok(_) => ()
    Err(e) => {
      remove_tree_fn(stage_dir)
      return Err(e)
    }
  }
  match check_no_symlink_fn(data_dir, "restore/ready.json") {
    Ok(_) => ()
    Err(e) => {
      remove_tree_fn(stage_dir)
      return Err(e)
    }
  }
  let restore_dir = nodepath::join(sep, [data_dir, "restore"])
  let ready_path = nodepath::join(sep, [restore_dir, "ready.json"])
  if ready_exists_fn(ready_path) {
    remove_tree_fn(stage_dir)
    return Err("a restore is already ready for restart")
  }
  let copy_dir = nodepath::join(sep, [restore_dir, "copy"])
  let had_old = copy_exists_fn(copy_dir)
  if had_old {
    if !rename_fn(copy_dir, old_backup_dir) {
      remove_tree_fn(stage_dir)
      return Err("failed to move aside stale restore/copy")
    }
  }
  if !rename_fn(stage_dir, copy_dir) {
    if had_old {
      let _ = rename_fn(old_backup_dir, copy_dir)
    }
    remove_tree_fn(stage_dir)
    return Err("failed to move staging directory into restore/copy")
  }
  let ready_j = base_codec::json_obj([
    ("origin", base_codec::json_str(origin)),
    ("ws", base_codec::json_str(ws)),
    ("workspace", base_codec::json_str(ws)),
    ("gen", base_codec::json_str(gen)),
    ("name", base_codec::json_str(name)),
    ("from", base_codec::json_str(from_label)),
  ])
  if !write_atomic_fn(ready_path, (base_codec::json_stringify(ready_j) + "\n").to_bytes(), 384) {
    remove_tree_fn(copy_dir)
    if had_old {
      let _ = rename_fn(old_backup_dir, copy_dir)
    }
    return Err("failed to atomically write restore/ready.json")
  }
  if had_old {
    remove_tree_fn(old_backup_dir)
  }
  Ok(ready_path)
}

pub fn w17e4d_commit_restore_staging(
  data_dir : String,
  sep : String,
  stage_dir : String,
  origin : String,
  ws : String,
  gen : String,
  name : String,
  from_label : String,
) -> Result[String, String] {
  let suffix = match station_sys::random_hex(6) { Ok(h) => h, Err(_) => "old" }
  let old_dir = nodepath::join(sep, [data_dir, "restore", ".old-" + suffix])
  w17e4d_commit_restore_staging_with(
    data_dir,
    sep,
    stage_dir,
    old_dir,
    origin,
    ws,
    gen,
    name,
    from_label,
    fn(p : String) -> Bool {
      match station_sys::lstat_raw_err(p) { Ok(_) => true, Err(_) => false }
    },
    fn(p : String) -> Bool {
      match station_sys::lstat_raw_err(p) { Ok(_) => true, Err(_) => false }
    },
    fn(r : String, rel : String) -> Result[Unit, String] { w17e4d_check_no_symlink(r, rel) },
    fn(a : String, b : String) -> Bool { station_sys::rename(a, b) },
    fn(p : String, d : Bytes, m : Int) -> Bool { station_sys::write_file_atomic(p, d, mode=m) },
    fn(d : String) -> Unit { w17e4d_remove_tree(d) },
  )
}

// ---------------------------------------------------------------------------
// State machines attached to `WholeRuntimeState`
// ---------------------------------------------------------------------------

pub struct UpdateRollbackDownloadJob {
  pub job_id : Int64
  pub release : station_cli::SignedRelease
  pub build : station_cli::ReleaseBuild
  pub channel : String
  pub base_url : String
  pub installer_src : String
  pub lang_code : String
  pub stage_dir : String
  pub part_path : String
  pub final_path : String
  pub hasher : crypto::Sha256
  pub held_auto_left : Option[String]
  pub mut stream_id : Option[Int]
  pub mut got_bytes : Int64
  pub mut stall_deadline_ms : Int64
}

pub struct IncludedFetchJob {
  pub job_id : Int64
  pub req_ch : String
  pub base_url : String
  pub release : station_cli::SignedRelease
  pub inc_file : String
  pub expected_sha256 : String
  pub expected_size : Int64
  pub mut stream_id : Option[Int]
  pub mut status : Int
  pub mut chunks : Array[Bytes]
  pub mut total_bytes : Int
  pub mut deadline_ms : Int64
}

pub struct WaitFeedFetchJob {
  pub job_id : Int64
  pub req_ch : String
  pub base_url : String
  pub mut stream_id : Option[Int]
  pub mut status : Int
  pub mut chunks : Array[Bytes]
  pub mut total_bytes : Int
  pub mut deadline_ms : Int64
}

pub struct RestoringView {
  pub origin : String
  pub mut name : String
  pub workspace : String
  pub gen : String
  pub from_label : String
  pub mut done : Int
  pub mut total : Int
  pub mut error : Option[String]
  pub mut reason : Option[String]
  pub mut restart : Bool
}

pub fn RestoringView::to_json(self : RestoringView) -> base_codec::Json {
  let fs : Array[(String, base_codec::Json)] = [
    ("origin", base_codec::json_str(self.origin)),
    ("name", base_codec::json_str(self.name)),
    ("workspace", base_codec::json_str(self.workspace)),
    ("gen", base_codec::json_str(self.gen)),
    ("from", base_codec::json_str(self.from_label)),
    ("done", base_codec::json_int(self.done)),
    ("total", base_codec::json_int(self.total)),
    ("error", match self.error { Some(e) => base_codec::json_str(e), None => base_codec::json_null() }),
    ("reason", match self.reason { Some(r) => base_codec::json_str(r), None => base_codec::json_null() }),
    ("restart", base_codec::json_bool(self.restart)),
  ]
  base_codec::json_obj(fs)
}

pub enum RestoreFetchItem {
  Head
  ManifestRoot(String)
  ManifestLeaf(String, String)
  Batch(String)
  ChatFile(String)
  TranscriptFile(String)
}

pub enum RestoreSourceKind {
  S3(station_replica::NormalizedS3Target, Bytes, String, String)
  LocalKept(String)
}

pub struct CopiesRestoreJob {
  pub job_id : Int64
  pub ws : String
  pub origin : String
  pub gen : String
  pub from_label : String
  pub target_kind : String
  pub target_id : String
  pub target_name : String
  pub source : RestoreSourceKind
  pub stage_dir : String
  pub manifest_budget : station_replica::ManifestBudget
  pub mut name : String
  pub mut head_raw : Option[Bytes]
  pub mut manifest_queue : Array[RestoreFetchItem]
  pub mut manifest_idx : Int
  pub mut queue : Array[RestoreFetchItem]
  pub mut queue_idx : Int
  pub mut current_item : Option[RestoreFetchItem]
  pub mut stream_id : Option[Int]
  pub mut status : Int
  pub mut chunks : Array[Bytes]
  pub mut total_bytes : Int
  pub mut stall_deadline_ms : Int64
  pub mut last_progress_push_ms : Int64
  // Streaming S3 decryption state (zero whole-object RAM buffering / no 64 MiB cap)
  pub mut s3_streaming : Bool
  pub mut s3_opener : Option[station_replica::Sfb1StreamOpener]
  pub mut s3_part_path : Option[String]
  pub mut s3_final_path : Option[String]
  pub mut s3_write_offset : Int64
  pub mut s3_hasher : Option[crypto::Sha256]
  // Chunked LocalKept copy & metadata-read cursor (bounded per-tick I/O)
  pub mut kept_src_path : Option[String]
  pub mut kept_part_path : Option[String]
  pub mut kept_final_path : Option[String]
  pub mut kept_offset : Int64
  pub mut kept_hasher : Option[crypto::Sha256]
  pub mut kept_meta_chunks : Array[Bytes]
  pub mut kept_meta_bytes : Int
}

pub struct W17e4dRuntime {
  pub mut next_ev_id : Int64
  pub mut next_job_id : Int64
  pub mut rollback_job : Option[UpdateRollbackDownloadJob]
  pub mut launcher_wrapper_ev_id : Int64
  pub mut launcher_wrapper_proc : Option[station_sys::ChildProcess]
  pub mut following_update_at : Option[Int64]
  pub mut last_follow_poll_ms : Int64
  pub mut next_update_poll_ms : Int64
  /// Snapshot bound to `(channel, base_url, release)` to prevent cross-channel/feed offer mixing.
  pub mut last_release : Option[(String, String, station_cli::SignedRelease)]
  /// Snapshot bound to `(channel, base_url, version, inc_file, inc_sha256, included)` to prevent stale manifest reuse.
  pub mut last_included : Option[(String, String, String, String, String, ReleaseIncluded)]
  pub mut last_tried_version : Option[String]
  pub mut included_job : Option[IncludedFetchJob]
  pub mut wait_feed_job : Option[WaitFeedFetchJob]
  pub mut restore_job : Option[CopiesRestoreJob]
  pub mut restoring_view : Option[RestoringView]
  pub xshare_listed : Map[String, Bool]
  pub xshare_heard : Map[String, Int64]
  pub xshare_inflight : Map[String, Bool]
  pub xshare_dirty : Map[String, (String, String, String)]
  pub mut xshare_reconcile_count : Int64
  pub xshare_retry_queue : Array[(String, String, String)]
  pub mut xshare_retry_at_ms : Int64
  pub mut xshare_retry_backoff_ms : Int64
}

pub fn W17e4dRuntime::new() -> W17e4dRuntime {
  W17e4dRuntime::{
    next_ev_id: UPDATES_RESTORE_EVENT_BASE,
    next_job_id: 1L,
    rollback_job: None,
    launcher_wrapper_ev_id: 0L,
    launcher_wrapper_proc: None,
    following_update_at: None,
    last_follow_poll_ms: 0L,
    next_update_poll_ms: 0L,
    last_release: None,
    last_included: None,
    last_tried_version: None,
    included_job: None,
    wait_feed_job: None,
    restore_job: None,
    restoring_view: None,
    xshare_listed: Map::new(),
    xshare_heard: Map::new(),
    xshare_inflight: Map::new(),
    xshare_dirty: Map::new(),
    xshare_reconcile_count: 0L,
    xshare_retry_queue: [],
    xshare_retry_at_ms: 0L,
    xshare_retry_backoff_ms: W17E4D_XSHARE_RETRY_BASE_MS,
  }
}

fn w17e4d_alloc_ev_id(rt : W17e4dRuntime) -> Int64 {
  let id = rt.next_ev_id
  rt.next_ev_id = if id + 1L >= UPDATES_RESTORE_EVENT_END {
    UPDATES_RESTORE_EVENT_BASE
  } else {
    id + 1L
  }
  id
}

fn w17e4d_alloc_job_id(rt : W17e4dRuntime) -> Int64 {
  let id = rt.next_job_id
  rt.next_job_id = id + 1L
  id
}

/// Fail-closed empty-station check: returns `Ok(true)` ONLY when SQL queries succeed and find 0 threads & 0 sessions.
fn w17e4d_station_is_empty(st : WholeRuntimeState) -> Result[Bool, String] {
  match st.core.store.require_open() {
    Err(e) => Err("store not open: " + e)
    Ok(st_db) => {
      match st_db.db.first("SELECT 1 AS x FROM threads LIMIT 1", []) {
        Ok(Some(_)) => return Ok(false)
        Ok(None) => ()
        Err(e) => return Err("threads empty check failed: " + e.message)
      }
      match st_db.db.first("SELECT 1 AS x FROM sessions LIMIT 1", []) {
        Ok(Some(_)) => Ok(false)
        Ok(None) => Ok(true)
        Err(e) => Err("sessions empty check failed: " + e.message)
      }
    }
  }
}

// ---------------------------------------------------------------------------
// 1. Detached Installer Launch + `update.{started,step,exit,log}` Following + Rollback
// ---------------------------------------------------------------------------

/// Pure rollback-hold restoration guard: ONLY restores `autoUpdate: true` & clears `autoUpdateAfter`
/// if disk `autoUpdateAfter` STILL equals the exact `held_left` marker written by this rollback.
/// If the user manually ran `updates.auto { enabled: false }` (clearing `autoUpdateAfter`), returns `None`.
pub fn w17e4d_restore_held_auto_json(raw : base_codec::Json, held_left : String) -> Option[base_codec::Json] {
  if live_json_str_f(raw, "autoUpdateAfter") != Some(held_left) {
    return None
  }
  let out_fs : Array[(String, base_codec::Json)] = []
  match raw {
    base_codec::Json::Obj(fs) => {
      for i in 0..<fs.length() {
        if fs[i].0 != "autoUpdate" && fs[i].0 != "autoUpdateAfter" {
          out_fs.push(fs[i])
        }
      }
    }
    _ => ()
  }
  out_fs.push(("autoUpdate", base_codec::json_bool(true)))
  Some(base_codec::json_obj(out_fs))
}

fn w17e4d_restore_held_auto(ctx : DaemonCtx, held_left : Option[String]) -> Unit {
  let marker = match held_left {
    Some(lv) if lv.length() > 0 => lv
    _ => return
  }
  let _ = ctx.config_file.try_update(fn(raw : base_codec::Json) -> Result[base_codec::Json, String] {
    match w17e4d_restore_held_auto_json(raw, marker) {
      Some(next) => Ok(next)
      None => Ok(raw)
    }
  })
}

/// Persist `holdAuto` on rollback (`autoUpdate=false`, `autoUpdateAfter=<left>`, 1:1 with `updates.ts:1675`).
pub fn w17e4d_hold_auto_for_rollback(ctx : DaemonCtx, left_ver : Option[String]) -> Option[String] {
  let raw = ctx.config_file.raw()
  let was_auto = live_json_bool_f(raw, "autoUpdate") == Some(true)
  match (was_auto, left_ver) {
    (true, Some(lv)) if lv.length() > 0 => {
      match ctx.config_file.try_update(fn(r : base_codec::Json) -> Result[base_codec::Json, String] {
        let out_fs : Array[(String, base_codec::Json)] = []
        match r {
          base_codec::Json::Obj(fs) => {
            for i in 0..<fs.length() {
              if fs[i].0 != "autoUpdate" && fs[i].0 != "autoUpdateAfter" {
                out_fs.push(fs[i])
              }
            }
          }
          _ => ()
        }
        out_fs.push(("autoUpdate", base_codec::json_bool(false)))
        out_fs.push(("autoUpdateAfter", base_codec::json_str(lv)))
        Ok(base_codec::json_obj(out_fs))
      }) {
        Ok(_) => Some(lv)
        Err(_) => None
      }
    }
    _ => None
  }
}

/// Launch the station installer completely detached from this process (`platform/unix.ts:687-701`):
/// 1. Copy `<app>/bin/install.<lang>.sh` -> `<data>/run/install.sh` (never execute in place in `<app>`).
/// 2. Remove stale `update.exit` / `update.step`, write `update.started`.
/// 3. Spawn `/bin/sh -c '( sh "$1"; echo $? > "$2/update.exit" ) > "$2/update.log" 2>&1 < /dev/null &' sh <copy> <runDir>`
///    with full inherited `env_all()` minus `STILLFAIL_ARCHIVE`/`STILLFAIL_INSTALLER_HANDED`.
pub fn w17e4d_launch_detached_installer(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  installer_src : String,
  release : station_cli::SignedRelease,
  build : station_cli::ReleaseBuild,
  channel : String,
  base_url : String,
  lang_code : String,
  handed_archive : Option[String],
) -> Result[Unit, String] {
  let run_dir = nodepath::join(ctx.sep, [ctx.data, "run"])
  if !station_sys::mkdir_p(run_dir) {
    return Err("failed to create run directory")
  }
  let script_bytes = match station_whole::rep_read_binary_file(installer_src) {
    Ok(b) => b
    Err(e) => return Err("failed to read bundled installer: " + e)
  }
  let ext = if ctx.sep == "\\" { "ps1" } else { "sh" }
  let copy_path = nodepath::join(ctx.sep, [run_dir, "install." + ext])
  if !station_sys::write_file_atomic(copy_path, script_bytes, mode=448) {
    return Err("failed to copy installer into run directory")
  }
  let _ = station_sys::unlink(nodepath::join(ctx.sep, [run_dir, "update.exit"]))
  let _ = station_sys::unlink(nodepath::join(ctx.sep, [run_dir, "update.step"]))
  let now_w = host_shim::wall_ms()
  let from_j = match st.core.updates.station.version {
    Some(v) => base_codec::json_str(v)
    None => base_codec::json_null()
  }
  let started_j = base_codec::json_obj([
    ("at", base_codec::json_int64(now_w)),
    ("from", from_j),
  ])
  let started_path = nodepath::join(ctx.sep, [run_dir, "update.started"])
  let _ = station_sys::write_file_atomic(started_path, (base_codec::json_stringify(started_j) + "\n").to_bytes(), mode=384)

  let env_list = w17e4d_build_installer_env(
    station_sys::env_all(),
    ctx.data,
    base_url,
    channel,
    build.sha256,
    build.node_sha256,
    lang_code,
    handed_archive,
  )
  let ev_id = w17e4d_alloc_ev_id(st.w17e4d)
  let shell_cmd = "( sh \"$1\"; echo $? > \"$2/update.exit\" ) > \"$2/update.log\" 2>&1 < /dev/null &"
  let win_ps_cmd = if ctx.sep == "\\" {
    let q = fn(s : String) -> String {
      let sb = StringBuilder::new()
      sb.write_string("'")
      for i in 0..<s.length() {
        let ch = s.slice(i, i + 1)
        if ch == "'" { sb.write_string("''") } else { sb.write_string(ch) }
      }
      sb.write_string("'")
      sb.to_string()
    }
    let log_p = nodepath::join(ctx.sep, [run_dir, "update.log"])
    let exit_p = nodepath::join(ctx.sep, [run_dir, "update.exit"])
    "$code = 0; try { & " + q(copy_path) + " *>> " + q(log_p) + "; if ($null -ne $LASTEXITCODE) { $code = [int]$LASTEXITCODE } } catch { $_ | Out-File -Append -FilePath " + q(log_p) + "; $code = 1 }; Set-Content -Path " + q(exit_p) + " -Value $code"
  } else {
    ""
  }
  let opts = station_sys::SpawnOptions::{
    program: if ctx.sep == "\\" { "powershell.exe" } else { "/bin/sh" },
    args: if ctx.sep == "\\" {
      ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", win_ps_cmd]
    } else {
      ["-c", shell_cmd, "sh", copy_path, run_dir]
    },
    env: Some(env_list),
    cwd: ctx.data,
    new_pgid: true,
    strip_malloc_space_efficient: false,
    pipe_stdin: false,
    pipe_stdout: false,
    pipe_stderr: false,
  }
  match station_sys::proc_spawn(ev_id, opts) {
    Ok(child) => {
      st.w17e4d.launcher_wrapper_ev_id = ev_id
      st.w17e4d.launcher_wrapper_proc = Some(child)
      st.w17e4d.following_update_at = Some(now_w)
      st.w17e4d.last_tried_version = Some(release.version)
      st.core.updates.station.updating = Some(now_w)
      st.core.updates.station.failed_text = None
      st.core.api.events.overview_changed("updates")
      Ok(())
    }
    Err(e) => {
      let _ = station_sys::unlink(started_path)
      Err("failed to launch detached installer: " + e)
    }
  }
}

/// Start following any update started before this process (`on_start`, 1:1 with `updates.ts:1671` `followStarted`),
/// and arm the periodic `updates.wait` / auto-update coordinator.
pub fn w17e4d_follow_started_on_boot(ctx : DaemonCtx, st : WholeRuntimeState) -> Unit {
  let started_path = nodepath::join(ctx.sep, [ctx.data, "run", "update.started"])
  match ctx.ops_fs.read_text(started_path) {
    Ok(raw) => match base_codec::json_parse(raw) {
      base_codec::JsonParseResult::Ok(j) => match w17e4d_json_i64(base_codec::json_get(j, "at")) {
        Some(at_ms) => {
          let now_w = host_shim::wall_ms()
          if now_w - at_ms > W17E4D_STATION_FOLLOW_LIMIT_MS {
            let _ = station_sys::unlink(started_path)
            let _ = station_sys::unlink(nodepath::join(ctx.sep, [ctx.data, "run", "update.step"]))
          } else {
            st.w17e4d.following_update_at = Some(at_ms)
            st.core.updates.station.updating = Some(at_ms)
          }
        }
        None => ()
      }
      _ => ()
    }
    Err(_) => ()
  }
  // Reconcile any settled override wait immediately and arm periodic feed evaluation on boot.
  // NOTE: `restore/.staging-*` is NOT swept here (`on_init`) because a live predecessor may still
  // be running a restore; it is swept exclusively in `w17e4d_on_predecessor_gone`!
  w17e4d_reconcile_wait_and_auto(ctx, st, None)
  st.w17e4d.next_update_poll_ms = host_shim::now_ms() + 5000L
}

/// Called once exclusive station ownership is acquired (`on_predecessor_gone`).
/// Sweeps any stale `restore/.staging-*` left by a crashed predecessor after checking `restore` symlink safety.
pub fn w17e4d_on_predecessor_gone(ctx : DaemonCtx, _st : WholeRuntimeState) -> Unit {
  match w17e4d_check_no_symlink(ctx.data, "restore") {
    Ok(_) => w17e4d_sweep_stale_restore_staging(nodepath::join(ctx.sep, [ctx.data, "restore"]), ctx.sep)
    Err(_) => ()
  }
}

/// Poll `run/update.exit` & `run/update.log` while following a detached installer (`on_tick`, throttled to 500ms).
fn w17e4d_poll_update_follow(ctx : DaemonCtx, st : WholeRuntimeState, now_ms : Int64) -> Unit {
  let started_at = match st.w17e4d.following_update_at {
    Some(at) => at
    None => return
  }
  if st.w17e4d.last_follow_poll_ms > 0L && now_ms - st.w17e4d.last_follow_poll_ms < W17E4D_FOLLOW_POLL_MS {
    return
  }
  st.w17e4d.last_follow_poll_ms = now_ms
  let run_dir = nodepath::join(ctx.sep, [ctx.data, "run"])
  let exit_path = nodepath::join(ctx.sep, [run_dir, "update.exit"])
  let started_path = nodepath::join(ctx.sep, [run_dir, "update.started"])
  let step_path = nodepath::join(ctx.sep, [run_dir, "update.step"])
  let log_path = nodepath::join(ctx.sep, [run_dir, "update.log"])
  match ctx.ops_fs.read_text(exit_path) {
    Ok(code_raw) => {
      let code_s = code_raw.trim()
      if code_s.length() == 0 {
        return
      }
      st.w17e4d.following_update_at = None
      st.core.updates.station.updating = None
      let _ = station_sys::unlink(started_path)
      let _ = station_sys::unlink(step_path)
      if code_s == "0" {
        st.core.updates.station.failed_text = None
        // Refresh installed version from `<app>/BUILD` without misusing `latest`.
        match ctx.args.app {
          Some(app_dir) => {
            st.core.updates.station.version = station_ops::station_version(ctx.ops_fs, app_dir, sep=ctx.sep)
          }
          None => ()
        }
      } else {
        let log_tail = match ctx.ops_fs.read_text(log_path) {
          Ok(t) => {
            let trimmed = t.trim()
            if trimmed.length() > 400 { trimmed.slice(trimmed.length() - 400, trimmed.length()) } else { trimmed }
          }
          Err(_) => "installer exited with code " + code_s
        }
        st.core.updates.station.failed_text = Some(if log_tail.length() > 0 { log_tail } else { "installer exited with code " + code_s })
      }
      st.core.api.events.overview_changed("updates")
    }
    Err(_) => {
      if host_shim::wall_ms() - started_at > W17E4D_STATION_FOLLOW_LIMIT_MS {
        st.w17e4d.following_update_at = None
        st.core.updates.station.updating = None
        st.core.updates.station.failed_text = Some("station update timed out waiting for installer exit")
        let _ = station_sys::unlink(started_path)
        let _ = station_sys::unlink(step_path)
        st.core.api.events.overview_changed("updates")
      }
    }
  }
}

/// Start a rollback archive download into `<tmpdir>/stillfail-handed.<hex>/stillfail.tar.gz`.
pub fn start_rollback_archive_job(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  release : station_cli::SignedRelease,
  build : station_cli::ReleaseBuild,
  channel : String,
  base_url : String,
  archive_url : String,
  installer_src : String,
  lang_code : String,
  held_auto_left : Option[String],
) -> Result[Unit, String] {
  let suffix = match station_sys::random_hex(16) {
    Ok(h) => h
    Err(e) => return Err("CSPRNG failed: " + e)
  }
  let tmp_root = station_sys::tmpdir()
  let (stage_dir, final_path) = w17e4d_handed_archive_paths(tmp_root, suffix, ctx.sep)
  match station_sys::mkdir_mode(stage_dir, mode=448) {
    station_sys::MkdirModeResult::Ok => ()
    _ => return Err("failed to create handed archive directory")
  }
  let part_path = final_path + ".part"
  let jid = w17e4d_alloc_job_id(st.w17e4d)
  let job = UpdateRollbackDownloadJob::{
    job_id: jid,
    release: release,
    build: build,
    channel: channel,
    base_url: base_url,
    installer_src: installer_src,
    lang_code: lang_code,
    stage_dir: stage_dir,
    part_path: part_path,
    final_path: final_path,
    hasher: crypto::Sha256::new(),
    held_auto_left: held_auto_left,
    stream_id: None,
    got_bytes: 0L,
    stall_deadline_ms: host_shim::now_ms() + W17E4D_ARCHIVE_STALL_MS,
  }
  st.w17e4d.rollback_job = Some(job)
  let _ = ctx.mux_role.call_async_raw(
    builders_core::MuxToken::Tagged(0, W17E4D_TOK_UPDATE_ARCHIVE_OPEN, jid),
    "stream.open",
    live_build_stream_open_args("GET", archive_url, [("user-agent", "stillfail-station")], W17E4D_ARCHIVE_STALL_MS),
    None,
  )
  Ok(())
}

fn fail_rollback_download_job(ctx : DaemonCtx, st : WholeRuntimeState, msg : String) -> Unit {
  match st.w17e4d.rollback_job {
    Some(job) => {
      match job.stream_id {
        Some(id) => {
          let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + id.to_string() + "}", None)
          job.stream_id = None
        }
        None => ()
      }
      w17e4d_remove_tree(job.stage_dir)
      w17e4d_restore_held_auto(ctx, job.held_auto_left)
      st.w17e4d.rollback_job = None
    }
    None => ()
  }
  st.core.updates.station.updating = None
  st.core.updates.station.failed_text = Some(msg)
  st.core.api.events.overview_changed("updates")
}

fn finish_rollback_archive_download(ctx : DaemonCtx, st : WholeRuntimeState, job : UpdateRollbackDownloadJob) -> Unit {
  let digest = job.hasher.finalize_hex()
  match w17e4d_finalize_staged_archive_with(
    job.stage_dir,
    job.part_path,
    job.final_path,
    job.got_bytes,
    job.build.size,
    digest,
    job.build.sha256,
    fn(p : String) -> Result[Unit, Int] { station_sys::sync_file(p) },
    fn(a : String, b : String) -> Bool { station_sys::rename(a, b) },
    fn(d : String) -> Unit { w17e4d_remove_tree(d) },
  ) {
    Err(e) => {
      w17e4d_restore_held_auto(ctx, job.held_auto_left)
      st.w17e4d.rollback_job = None
      st.core.updates.station.updating = None
      st.core.updates.station.failed_text = Some(e)
      st.core.api.events.overview_changed("updates")
      return
    }
    Ok(handed_path) => {
      st.w17e4d.rollback_job = None
      match w17e4d_launch_detached_installer(
        ctx,
        st,
        job.installer_src,
        job.release,
        job.build,
        job.channel,
        job.base_url,
        job.lang_code,
        Some(handed_path),
      ) {
        Ok(_) => ()
        Err(e) => {
          w17e4d_remove_tree(job.stage_dir)
          w17e4d_restore_held_auto(ctx, job.held_auto_left)
          st.core.updates.station.updating = None
          st.core.updates.station.failed_text = Some(e)
          st.core.api.events.overview_changed("updates")
        }
      }
    }
  }
}

// ---------------------------------------------------------------------------
// 2. `updates.wait` Runtime Coordinator (Included Manifest + Reconcile + Auto-Trigger)
// ---------------------------------------------------------------------------

/// Trigger a non-blocking background feed check after `updates.wait` or `updates.auto` changes.
pub fn w17e4d_trigger_wait_feed_check(ctx : DaemonCtx, st : WholeRuntimeState, check_after : Bool) -> Unit {
  // Always reconcile override wait immediately (e.g., if OVERRIDE was already removed).
  w17e4d_reconcile_wait_and_auto(ctx, st, None)
  if !check_after || st.w17e4d.wait_feed_job.is_some() {
    return
  }
  let ch = resolve_station_update_channel(ctx.config_file.raw(), ctx.ops_fs, ctx.args.app, ctx.sep)
  let base_url = match w17e4d_release_base_url(station_sys::env_get("STILLFAIL_RELEASE_URL"), ctx.cloud.state) {
    Some(b) => b
    None => return
  }
  let feed_url = station_cli::feed_url(ch, base_url)
  let jid = w17e4d_alloc_job_id(st.w17e4d)
  st.w17e4d.wait_feed_job = Some(WaitFeedFetchJob::{
    job_id: jid,
    req_ch: ch,
    base_url: base_url,
    stream_id: None,
    status: 0,
    chunks: [],
    total_bytes: 0,
    deadline_ms: host_shim::now_ms() + 15000L,
  })
  let _ = ctx.mux_role.call_async_raw(
    builders_core::MuxToken::Tagged(0, W17E4D_TOK_WAIT_FEED_OPEN, jid),
    "stream.open",
    live_build_stream_open_args("GET", feed_url, [("user-agent", "stillfail-station")], 15000L),
    None,
  )
}

/// Pure freshness guard for late background feed replies: requires BOTH `(channel, base_url)`
/// to still match current configuration before updating `latest`/`updatable` or emitting SSE.
pub fn w17e4d_feed_reply_matches_current(
  req_ch : String,
  req_base : String,
  cur_ch : String,
  cur_base : Option[String],
) -> Bool {
  match cur_base {
    Some(cb) => req_ch == cur_ch && req_base.length() > 0 && cb == req_base
    None => false
  }
}
/// (`None` never hits a cached release bound to an older `base_url`).
pub fn w17e4d_match_bound_release(
  cached : Option[(String, String, station_cli::SignedRelease)],
  cur_ch : String,
  cur_base_url : Option[String],
) -> Option[(String, station_cli::SignedRelease)] {
  match (cached, cur_base_url) {
    (Some((rch, rbase, r)), Some(cb)) if rch == cur_ch && cb.length() > 0 && rbase == cb => Some((rbase, r))
    _ => None
  }
}

/// Strict snapshot matcher for `last_included`: requires exact `(channel, base_url, version, file, sha256)` match.
pub fn w17e4d_match_bound_included(
  cached : Option[(String, String, String, String, String, ReleaseIncluded)],
  cur_ch : String,
  rel_base : String,
  rel : station_cli::SignedRelease,
) -> Option[ReleaseIncluded] {
  match (rel.included, cached) {
    (Some(inc_ref), Some((ich, ibase, iver, ifile, isha, inc))) if ich == cur_ch
    && ibase == rel_base
    && iver == rel.version
    && ifile == inc_ref.file
    && isha == inc_ref.sha256 => Some(inc)
    _ => None
  }
}

/// Reconcile `autoUpdateWhen` & `autoUpdateAfter`, fetch signed `included` manifest if needed,
/// and start a detached station update when conditions are met (`updates.ts:979-1063`).
/// Snapshots are strictly bound to `(channel, base_url, version, included_file, included_sha256)`.
pub fn w17e4d_reconcile_wait_and_auto(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  fresh_rel : Option[(String, String, station_cli::SignedRelease)],
) -> Unit {
  match fresh_rel {
    Some((rel_ch, rel_base, rel)) => {
      st.w17e4d.last_release = Some((rel_ch, rel_base, rel))
      match w17e4d_match_bound_included(st.w17e4d.last_included, rel_ch, rel_base, rel) {
        Some(_) => ()
        None => st.w17e4d.last_included = None
      }
    }
    None => ()
  }
  let ov_meta = match ctx.args.app {
    Some(app_dir) => station_cli::read_override(ctx.ops_fs, app_dir, sep=ctx.sep)
    None => None
  }
  let raw_cfg = ctx.config_file.raw()
  let cur_ch = resolve_station_update_channel(raw_cfg, ctx.ops_fs, ctx.args.app, ctx.sep)
  let cur_base_opt = w17e4d_release_base_url(station_sys::env_get("STILLFAIL_RELEASE_URL"), ctx.cloud.state)
  let bound_rel = w17e4d_match_bound_release(st.w17e4d.last_release, cur_ch, cur_base_opt)
  let bound_rel_only : Option[station_cli::SignedRelease] = match bound_rel {
    Some((_, r)) => Some(r)
    None => None
  }
  let bound_inc : Option[ReleaseIncluded] = match bound_rel {
    Some((rbase, r)) => w17e4d_match_bound_included(st.w17e4d.last_included, cur_ch, rbase, r)
    None => None
  }
  // 1. `reconcileOverrideWait`: clear `autoUpdateWhen` & restore `autoUpdate` once official release settles it.
  match station_cli::parse_auto_update_when(raw_cfg) {
    Some(when) => {
      if w17e4d_should_settle_wait(when, st.core.updates.station.version, ov_meta.is_some(), bound_rel_only, bound_inc) {
        let _ = ctx.config_file.try_update(fn(r : base_codec::Json) -> Result[base_codec::Json, String] {
          let out_fs : Array[(String, base_codec::Json)] = []
          match r {
            base_codec::Json::Obj(fs) => {
              for i in 0..<fs.length() {
                if fs[i].0 != "autoUpdateWhen" && (!when.restore_auto || fs[i].0 != "autoUpdate") {
                  out_fs.push(fs[i])
                }
              }
            }
            _ => ()
          }
          if when.restore_auto {
            out_fs.push(("autoUpdate", base_codec::json_bool(true)))
          }
          Ok(base_codec::json_obj(out_fs))
        })
        st.core.api.events.overview_changed("updates")
      }
    }
    None => ()
  }
  // 2. `resumeAuto`: re-enable `autoUpdate` once channel's latest is newer than `autoUpdateAfter`.
  let raw_cfg2 = ctx.config_file.raw()
  match (live_json_str_f(raw_cfg2, "autoUpdateAfter"), bound_rel_only) {
    (Some(after_v), Some(rel)) => {
      match station_cli::version_build(Some(after_v)) {
        Some(left_b) if rel.build > left_b => {
          let _ = ctx.config_file.try_update(fn(r : base_codec::Json) -> Result[base_codec::Json, String] {
            let out_fs : Array[(String, base_codec::Json)] = []
            match r {
              base_codec::Json::Obj(fs) => {
                for i in 0..<fs.length() {
                  if fs[i].0 != "autoUpdateAfter" && fs[i].0 != "autoUpdate" {
                    out_fs.push(fs[i])
                  }
                }
              }
              _ => ()
            }
            out_fs.push(("autoUpdate", base_codec::json_bool(true)))
            Ok(base_codec::json_obj(out_fs))
          })
          st.core.api.events.overview_changed("updates")
        }
        _ => ()
      }
    }
    _ => ()
  }
  // 3. Check if we need to fetch signed `included` manifest for `autoUpdateWhen` (`pr:`/`fix:`/`commit:`).
  let raw_cfg3 = ctx.config_file.raw()
  let (snap_base, rel) = match bound_rel { Some(pair) => pair, None => return }
  let ch = resolve_station_update_channel(raw_cfg3, ctx.ops_fs, ctx.args.app, ctx.sep)
  if ch != cur_ch {
    return
  }
  let base_url = if snap_base.length() > 0 {
    snap_base
  } else {
    match w17e4d_release_base_url(station_sys::env_get("STILLFAIL_RELEASE_URL"), ctx.cloud.state) {
      Some(b) => b
      None => return
    }
  }
  match station_cli::parse_auto_update_when(raw_cfg3) {
    Some(when) if w17e4d_needs_included(when.wait) && bound_inc.is_none() => {
      match rel.included {
        Some(inc_ref) if st.w17e4d.included_job.is_none() => {
          let inc_url = base_url + "/releases/" + inc_ref.file
          let jid = w17e4d_alloc_job_id(st.w17e4d)
          st.w17e4d.included_job = Some(IncludedFetchJob::{
            job_id: jid,
            req_ch: ch,
            base_url: base_url,
            release: rel,
            inc_file: inc_ref.file,
            expected_sha256: inc_ref.sha256,
            expected_size: inc_ref.size,
            stream_id: None,
            status: 0,
            chunks: [],
            total_bytes: 0,
            deadline_ms: host_shim::now_ms() + 15000L,
          })
          let _ = ctx.mux_role.call_async_raw(
            builders_core::MuxToken::Tagged(0, W17E4D_TOK_INCLUDED_OPEN, jid),
            "stream.open",
            live_build_stream_open_args("GET", inc_url, [("user-agent", "stillfail-station")], 15000L),
            None,
          )
          return
        }
        _ => ()
      }
    }
    _ => ()
  }
  // 4. `toUpdateTo`: evaluate whether auto-update / wait condition triggers an update now!
  if st.core.updates.station.updating.is_some() || st.w17e4d.rollback_job.is_some() || st.w17e4d.following_update_at.is_some() {
    return
  }
  for i in 0..<st.core.updates.runtimes.length() {
    if st.core.updates.runtimes[i].updating.is_some() {
      return
    }
  }
  match st.w17e4d.last_tried_version {
    Some(tv) if tv == rel.version => return
    _ => ()
  }
  let cur_v = match st.core.updates.station.version { Some(v) => v, None => "" }
  let is_newer = live_version_newer(cur_v, rel.version)
  let installed_ch = match ctx.args.app {
    Some(app_dir) => station_ops::station_channel(ctx.ops_fs, app_dir, sep=ctx.sep)
    None => None
  }
  let should_go = match station_cli::parse_auto_update_when(raw_cfg3) {
    Some(when) => {
      if when.wait.length() == 0 {
        false
      } else if ov_meta.is_some() {
        let cur_b = station_cli::version_build(st.core.updates.station.version)
        let ov_b = match ov_meta { Some(ov) => ov.base_build, None => None }
        station_cli::release_allowed(rel, cur_b, ch, installed_ch, override_base_build=ov_b)
        && w17e4d_conditions_met(when.wait, rel, bound_inc)
      } else {
        is_newer && w17e4d_conditions_met(when.wait, rel, bound_inc)
      }
    }
    None => ov_meta.is_none() && live_json_bool_f(raw_cfg3, "autoUpdate") == Some(true) && is_newer
  }
  if !should_go {
    return
  }
  let plat = live_current_platform(station_sys::os_name(), station_sys::arch_name())
  let build = match station_cli::expected_build(rel, Some(plat)) {
    Ok(b) => b
    Err(_) => return
  }
  let installer_src = match w17e4d_bundled_installer_path(ctx.ops_fs, ctx.args.app, "en", ctx.sep) {
    Some(p) => p
    None => return
  }
  let _ = w17e4d_launch_detached_installer(ctx, st, installer_src, rel, build, ch, base_url, "en", None)
}

// ---------------------------------------------------------------------------
// 3. Copies Restore Overview Projection + Non-Blocking S3 / Local-Kept / PeerPlace
// ---------------------------------------------------------------------------

/// Build `{ restoring?, restored? }` for `GET /overview`'s `copies` section.
pub fn w17e4d_copies_overview_json(ctx : DaemonCtx, st : WholeRuntimeState, ws : String) -> Option[base_codec::Json] {
  let fs : Array[(String, base_codec::Json)] = []
  match st.w17e4d.restoring_view {
    Some(rv) if rv.workspace == ws => {
      fs.push(("restoring", rv.to_json()))
    }
    _ => ()
  }
  let outcome_path = nodepath::join(ctx.sep, [ctx.data, "replica", "restored.json"])
  match ctx.ops_fs.read_text(outcome_path) {
    Ok(txt) => match base_codec::json_parse(txt) {
      base_codec::JsonParseResult::Ok(j) => fs.push(("restored", j))
      _ => ()
    }
    Err(_) => ()
  }
  if fs.length() == 0 {
    None
  } else {
    Some(base_codec::json_obj(fs))
  }
}

fn w17e4d_s3_object_key(target : station_replica::NormalizedS3Target, rel : String) -> String {
  if target.prefix.length() > 0 {
    target.prefix + "/" + rel
  } else {
    rel
  }
}

fn w17e4d_next_restore_item(job : CopiesRestoreJob) -> Option[RestoreFetchItem] {
  if job.manifest_idx < job.manifest_queue.length() {
    let it = job.manifest_queue[job.manifest_idx]
    job.manifest_idx = job.manifest_idx + 1
    return Some(it)
  }
  if job.queue_idx < job.queue.length() {
    let it = job.queue[job.queue_idx]
    job.queue_idx = job.queue_idx + 1
    return Some(it)
  }
  None
}

/// Pure 1:1 Node `history.json` merger (`station/src/replica/copies.ts:70, 1536`):
/// Reads `{ v: 1, workspaces: { [ws]: [...] } }` (and tolerates legacy flat `{ [ws]: [...] }`),
/// preserves all existing workspaces & records, prepends `entry` (capped at 50 per workspace),
/// and emits `{ v: 1, workspaces: { ... } }`.
pub fn w17e4d_merge_restore_history_json(
  existing_raw : Option[String],
  ws : String,
  entry : base_codec::Json,
) -> base_codec::Json {
  let existing : Map[String, Array[base_codec::Json]] = Map::new()
  match existing_raw {
    Some(txt) => match base_codec::json_parse(txt) {
      base_codec::JsonParseResult::Ok(j) => {
        let ws_obj = match base_codec::json_get(j, "workspaces") {
          Some(base_codec::Json::Obj(wfs)) => wfs
          _ => match j {
            base_codec::Json::Obj(fs) => fs
            _ => []
          }
        }
        for i in 0..<ws_obj.length() {
          match ws_obj[i].1 {
            base_codec::Json::Arr(xs) => existing.set(ws_obj[i].0, xs)
            _ => ()
          }
        }
      }
      _ => ()
    }
    None => ()
  }
  let list = match existing.get(ws) {
    Some(xs) => xs
    None => []
  }
  let next_list : Array[base_codec::Json] = [entry]
  let cap = if list.length() > 49 { 49 } else { list.length() }
  for i in 0..<cap {
    next_list.push(list[i])
  }
  existing.set(ws, next_list)
  let out_fs : Array[(String, base_codec::Json)] = []
  let ks = existing.keys()
  for i in 0..<ks.length() {
    match existing.get(ks[i]) {
      Some(xs) => out_fs.push((ks[i], base_codec::json_arr(xs)))
      None => ()
    }
  }
  base_codec::json_obj([
    ("v", base_codec::json_int(1)),
    ("workspaces", base_codec::json_obj(out_fs)),
  ])
}

/// Append a restore error entry to `<data>/replica/history.json` (1:1 with Node `copies.ts:1536, 1755-1768`).
fn w17e4d_record_restore_history(
  ctx : DaemonCtx,
  ws : String,
  target_kind : String,
  target : String,
  target_name : String,
  reason : String,
  error : String,
) -> Unit {
  let rep_dir = nodepath::join(ctx.sep, [ctx.data, "replica"])
  let _ = station_sys::mkdir_p(rep_dir)
  let hist_path = nodepath::join(ctx.sep, [rep_dir, "history.json"])
  // Fail-closed: ONLY create fresh history on confirmed ENOENT (`-2`); on symlink/non-regular/read/parse error,
  // refuse to clobber existing history.json.
  let existing_raw : Option[String] = match station_sys::lstat_raw_err(hist_path) {
    Err(-2) => None
    Err(_) => return
    Ok(raw_meta) => {
      if raw_meta.starts_with("symlink|") || !raw_meta.starts_with("file|") {
        return
      }
      match ctx.ops_fs.read_text(hist_path) {
        Ok(txt) => match base_codec::json_parse(txt) {
          base_codec::JsonParseResult::Ok(_) => Some(txt)
          _ => return
        }
        Err(_) => return
      }
    }
  }
  let at_ms = host_shim::wall_ms()
  let rand_id = match station_sys::random_hex(4) {
    Ok(h) => h
    Err(_) => "0000"
  }
  let entry = base_codec::json_obj([
    ("id", base_codec::json_str("restore-" + at_ms.to_string() + "-" + rand_id)),
    ("at", base_codec::json_int64(at_ms)),
    ("kind", base_codec::json_str("restore")),
    ("targetKind", base_codec::json_str(target_kind)),
    ("target", base_codec::json_str(target)),
    ("targetName", base_codec::json_str(target_name)),
    ("status", base_codec::json_str("error")),
    ("chats", base_codec::json_int(0)),
    ("messages", base_codec::json_int(0)),
    ("batches", base_codec::json_int(0)),
    ("bytes", base_codec::json_int(0)),
    ("reason", base_codec::json_str(reason)),
    ("error", base_codec::json_str(error)),
  ])
  let merged = w17e4d_merge_restore_history_json(existing_raw, ws, entry)
  let _ = station_sys::write_file_atomic(hist_path, (base_codec::json_stringify(merged) + "\n").to_bytes(), mode=384)
}

fn w17e4d_bump_restore_done(st : WholeRuntimeState, job : CopiesRestoreJob) -> Unit {
  match st.w17e4d.restoring_view {
    Some(rv) => {
      rv.done = rv.done + 1
      let now_m = host_shim::now_ms()
      if now_m - job.last_progress_push_ms >= W17E4D_TELL_RESTORE_MS {
        job.last_progress_push_ms = now_m
        st.core.api.events.overview_changed("copies")
      }
    }
    None => ()
  }
}

fn fail_copies_restore_job(ctx : DaemonCtx, st : WholeRuntimeState, msg : String, reason : String) -> Unit {
  match st.w17e4d.restore_job {
    Some(job) => {
      match job.stream_id {
        Some(id) => {
          let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + id.to_string() + "}", None)
          job.stream_id = None
        }
        None => ()
      }
      match job.s3_part_path {
        Some(p) => { let _ = station_sys::unlink(p); job.s3_part_path = None }
        None => ()
      }
      match job.kept_part_path {
        Some(p) => { let _ = station_sys::unlink(p); job.kept_part_path = None }
        None => ()
      }
      w17e4d_record_restore_history(ctx, job.ws, job.target_kind, job.target_id, job.target_name, reason, msg)
      w17e4d_remove_tree(job.stage_dir)
      st.w17e4d.restore_job = None
    }
    None => ()
  }
  match st.w17e4d.restoring_view {
    Some(rv) => {
      rv.error = Some(msg)
      rv.reason = Some(reason)
    }
    None => ()
  }
  st.core.api.events.overview_changed("copies")
}

fn w17e4d_sfb1_open_bytes(enc_key : Bytes, ws : String, origin : String, logical_path : String, enc : Bytes) -> Result[Bytes, String] {
  let opener = match station_replica::Sfb1StreamOpener::new(
    enc_key,
    station_replica::Sfb1Context::{ ws: ws, origin: origin, logical_path: logical_path },
  ) {
    Ok(o) => o
    Err(e) => return Err("sfb1 init failed: " + e)
  }
  let parts = match opener.push(enc) {
    Ok(ps) => ps
    Err(e) => return Err("sfb1 decrypt failed: " + e)
  }
  match opener.finish() {
    Ok(_) => ()
    Err(e) => return Err("sfb1 auth tag failed: " + e)
  }
  let mut total = 0
  for i in 0..<parts.length() {
    total = total + parts[i].length()
  }
  Ok(live_concat_chunks(parts, total))
}

fn w17e4d_commit_restore_and_restart(ctx : DaemonCtx, st : WholeRuntimeState, job : CopiesRestoreJob) -> Unit {
  match job.head_raw {
    None => {
      fail_copies_restore_job(ctx, st, "missing head.json during restore commit", "error")
      return
    }
    Some(head_bytes) => {
      let head_dst = nodepath::join(ctx.sep, [job.stage_dir, job.gen, "head.json"])
      match station_whole::rep_write_binary_atomic(head_dst, head_bytes) {
        Err(e) => {
          fail_copies_restore_job(ctx, st, "failed to write staged head.json: " + e, "error")
          return
        }
        Ok(_) => ()
      }
    }
  }
  match w17e4d_station_is_empty(st) {
    Ok(true) => ()
    Ok(false) => {
      fail_copies_restore_job(ctx, st, "this station has chats of its own: a copy is taken back only into a new one", "notEmpty")
      return
    }
    Err(e) => {
      fail_copies_restore_job(ctx, st, e, "error")
      return
    }
  }
  match w17e4d_commit_restore_staging(
    ctx.data,
    ctx.sep,
    job.stage_dir,
    job.origin,
    job.ws,
    job.gen,
    job.name,
    job.from_label,
  ) {
    Err(e) => {
      w17e4d_record_restore_history(ctx, job.ws, job.target_kind, job.target_id, job.target_name, "error", e)
      st.w17e4d.restore_job = None
      match st.w17e4d.restoring_view {
        Some(rv) => {
          rv.error = Some(e)
          rv.reason = Some("error")
        }
        None => ()
      }
      st.core.api.events.overview_changed("copies")
    }
    Ok(_) => {
      st.w17e4d.restore_job = None
      // Trigger controlled restart (1:1 with Node `copies.ts:1888-1891`) so `before_store` runs `take_back`.
      let need_manual_restart = match st.core.api.hooks.on_restart {
        Some(restart_fn) => match restart_fn() {
          Ok(_) => false
          Err(_) => true
        }
        None => true
      }
      match st.w17e4d.restoring_view {
        Some(rv) => {
          rv.error = None
          rv.reason = None
          rv.restart = need_manual_restart
        }
        None => ()
      }
      st.core.api.events.overview_changed("copies")
    }
  }
}

fn w17e4d_parse_and_enqueue_head(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  job : CopiesRestoreJob,
  plain : Bytes,
) -> Bool {
  let head_j = match base_codec::json_parse(plain.to_string()) {
    base_codec::JsonParseResult::Ok(j) => j
    base_codec::JsonParseResult::Err(e) => {
      fail_copies_restore_job(ctx, st, "corrupt head.json: " + e, "error")
      return false
    }
  }
  let head = match station_replica::as_head(head_j) {
    Some(h) => h
    None => {
      fail_copies_restore_job(ctx, st, "head.json failed schema validation", "error")
      return false
    }
  }
  if head.origin != job.origin || head.workspace != job.ws || head.gen != job.gen {
    fail_copies_restore_job(ctx, st, "head.json origin/workspace/gen mismatch", "error")
    return false
  }
  job.name = if head.name.length() > 0 { head.name } else { job.origin }
  job.head_raw = Some(plain)
  for i in 0..<head.batches.length() {
    let b = head.batches[i]
    if !station_whole::is_safe_replica_id(b) {
      fail_copies_restore_job(ctx, st, "unsafe batch name in head.json", "error")
      return false
    }
  }
  let chat_seen : Map[String, Bool] = Map::new()
  let chat_files = head.files.keys()
  for i in 0..<chat_files.length() {
    let h = chat_files[i]
    if !w17e4d_is_hex64_lower(h) {
      fail_copies_restore_job(ctx, st, "unsafe file hash in head.json", "error")
      return false
    }
    chat_seen.set(h, true)
  }
  match head.transcript_manifest {
    Some(root_h) if root_h.length() > 0 => {
      if !w17e4d_is_hex64_lower(root_h) {
        fail_copies_restore_job(ctx, st, "unsafe transcriptManifest hash", "error")
        return false
      }
      job.manifest_queue.push(RestoreFetchItem::ManifestRoot(root_h))
    }
    _ => match head.transcript_files {
      Some(tmap) => {
        let tkeys = tmap.keys()
        for i in 0..<tkeys.length() {
          let h = tkeys[i]
          if !w17e4d_is_hex64_lower(h) {
            fail_copies_restore_job(ctx, st, "unsafe transcript file hash in head.json", "error")
            return false
          }
          if !chat_seen.contains(h) {
            job.queue.push(RestoreFetchItem::TranscriptFile(h))
          }
        }
      }
      None => ()
    }
  }
  for i in 0..<head.batches.length() {
    job.queue.push(RestoreFetchItem::Batch(head.batches[i]))
  }
  for i in 0..<chat_files.length() {
    job.queue.push(RestoreFetchItem::ChatFile(chat_files[i]))
  }
  match st.w17e4d.restoring_view {
    Some(rv) => {
      rv.name = job.name
      rv.total = job.manifest_queue.length() + job.queue.length()
    }
    None => ()
  }
  st.core.api.events.overview_changed("copies")
  true
}

fn w17e4d_handle_restore_item_bytes(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  job : CopiesRestoreJob,
  item : RestoreFetchItem,
  status : Int,
  raw_bytes : Bytes,
  is_s3 : Bool,
) -> Unit {
  let decrypt_if_s3 = fn(origin_aad : String, logical_path : String) -> Result[Bytes, String] {
    if !is_s3 {
      return Ok(raw_bytes)
    }
    match job.source {
      RestoreSourceKind::S3(_, enc_key, _, _) => w17e4d_sfb1_open_bytes(enc_key, job.ws, origin_aad, logical_path, raw_bytes)
      _ => Ok(raw_bytes)
    }
  }
  let bump_done = fn() -> Unit {
    w17e4d_bump_restore_done(st, job)
  }
  match item {
    RestoreFetchItem::Head => {
      if status == 404 {
        fail_copies_restore_job(ctx, st, "that copy is not kept there", "gone")
        return
      }
      if status < 200 || status >= 300 {
        fail_copies_restore_job(ctx, st, "head fetch failed (HTTP " + status.to_string() + ")", "error")
        return
      }
      let head_aad_origin = match job.source {
        RestoreSourceKind::S3(_, _, _, ot) => ot
        _ => job.origin
      }
      let plain = match decrypt_if_s3(head_aad_origin, "head/" + job.gen) {
        Ok(b) => b
        Err(e) => { fail_copies_restore_job(ctx, st, e, "error"); return }
      }
      if !w17e4d_parse_and_enqueue_head(ctx, st, job, plain) {
        return
      }
      w17e4d_pump_restore_job(ctx, st, job)
    }

    RestoreFetchItem::ManifestRoot(root_h) => {
      if status < 200 || status >= 300 {
        fail_copies_restore_job(ctx, st, "transcriptManifest root missing (HTTP " + status.to_string() + ")", "error")
        return
      }
      let plain = match decrypt_if_s3(job.origin, "files/" + root_h) {
        Ok(b) => b
        Err(e) => { fail_copies_restore_job(ctx, st, e, "error"); return }
      }
      // Single shared `job.manifest_budget` enforces global anti-bomb cap across root + all leaves!
      let root_parsed = match station_replica::parse_root_manifest(plain, root_h, job.manifest_budget) {
        Ok(r) => r
        Err(e) => { fail_copies_restore_job(ctx, st, "invalid transcriptManifest root: " + e, "error"); return }
      }
      let dst = nodepath::join(ctx.sep, [job.stage_dir, "files", root_h])
      match station_whole::rep_write_binary_atomic(dst, plain) {
        Err(e) => { fail_copies_restore_job(ctx, st, e, "error"); return }
        Ok(_) => ()
      }
      let bkeys = root_parsed.buckets.keys()
      for i in 0..<bkeys.length() {
        match root_parsed.buckets.get(bkeys[i]) {
          Some(lh) => job.manifest_queue.push(RestoreFetchItem::ManifestLeaf(bkeys[i], lh))
          None => ()
        }
      }
      match st.w17e4d.restoring_view {
        Some(rv) => rv.total = job.manifest_queue.length() + job.queue.length()
        None => ()
      }
      bump_done()
      w17e4d_pump_restore_job(ctx, st, job)
    }

    RestoreFetchItem::ManifestLeaf(bucket, leaf_h) => {
      if status < 200 || status >= 300 {
        fail_copies_restore_job(ctx, st, "transcriptManifest leaf missing (HTTP " + status.to_string() + ")", "error")
        return
      }
      let plain = match decrypt_if_s3(job.origin, "files/" + leaf_h) {
        Ok(b) => b
        Err(e) => { fail_copies_restore_job(ctx, st, e, "error"); return }
      }
      let leaf_parsed = match station_replica::parse_leaf_manifest(plain, bucket, leaf_h, job.manifest_budget) {
        Ok(l) => l
        Err(e) => { fail_copies_restore_job(ctx, st, "invalid transcriptManifest leaf: " + e, "error"); return }
      }
      let dst = nodepath::join(ctx.sep, [job.stage_dir, "files", leaf_h])
      match station_whole::rep_write_binary_atomic(dst, plain) {
        Err(e) => { fail_copies_restore_job(ctx, st, e, "error"); return }
        Ok(_) => ()
      }
      let fkeys = leaf_parsed.files.keys()
      for i in 0..<fkeys.length() {
        job.queue.push(RestoreFetchItem::TranscriptFile(fkeys[i]))
      }
      match st.w17e4d.restoring_view {
        Some(rv) => rv.total = job.manifest_queue.length() + job.queue.length()
        None => ()
      }
      bump_done()
      w17e4d_pump_restore_job(ctx, st, job)
    }

    RestoreFetchItem::Batch(b) => {
      if status < 200 || status >= 300 {
        fail_copies_restore_job(ctx, st, "batch fetch failed (HTTP " + status.to_string() + ")", "error")
        return
      }
      let plain = match decrypt_if_s3(job.origin, "log/" + job.gen + "/" + b) {
        Ok(p) => p
        Err(e) => { fail_copies_restore_job(ctx, st, e, "error"); return }
      }
      let dst = nodepath::join(ctx.sep, [job.stage_dir, job.gen, "log", b])
      match station_whole::rep_write_binary_atomic(dst, plain) {
        Err(e) => { fail_copies_restore_job(ctx, st, e, "error"); return }
        Ok(_) => ()
      }
      bump_done()
      w17e4d_pump_restore_job(ctx, st, job)
    }

    RestoreFetchItem::ChatFile(h) => {
      if status < 200 || status >= 300 {
        fail_copies_restore_job(ctx, st, "chat file fetch failed (HTTP " + status.to_string() + ")", "error")
        return
      }
      let plain = match decrypt_if_s3(job.origin, "files/" + h) {
        Ok(p) => p
        Err(e) => { fail_copies_restore_job(ctx, st, e, "error"); return }
      }
      if crypto::sha256_hex(plain) != h {
        fail_copies_restore_job(ctx, st, "restored file sha256 mismatch for " + h, "error")
        return
      }
      let dst = nodepath::join(ctx.sep, [job.stage_dir, "files", h])
      match station_whole::rep_write_binary_atomic(dst, plain) {
        Err(e) => { fail_copies_restore_job(ctx, st, e, "error"); return }
        Ok(_) => ()
      }
      bump_done()
      w17e4d_pump_restore_job(ctx, st, job)
    }

    RestoreFetchItem::TranscriptFile(h) => {
      if status == 404 {
        bump_done()
        w17e4d_pump_restore_job(ctx, st, job)
        return
      }
      if status < 200 || status >= 300 {
        fail_copies_restore_job(ctx, st, "transcript fetch failed (HTTP " + status.to_string() + ")", "error")
        return
      }
      let plain = match decrypt_if_s3(job.origin, "files/" + h) {
        Ok(p) => p
        Err(e) => { fail_copies_restore_job(ctx, st, e, "error"); return }
      }
      let dst = nodepath::join(ctx.sep, [job.stage_dir, "files", h])
      match station_whole::rep_write_binary_atomic(dst, plain) {
        Err(e) => { fail_copies_restore_job(ctx, st, e, "error"); return }
        Ok(_) => ()
      }
      bump_done()
      w17e4d_pump_restore_job(ctx, st, job)
    }
  }
}

/// Determine whether an S3 restore item is streamed directly to disk via `Sfb1StreamOpener` + `write_at`
/// (true for batches, chat attachments, and transcripts — zero 64 MiB cap / zero whole-object RAM buffer)
/// vs. small JSON metadata (`Head`, `ManifestRoot`, `ManifestLeaf`).
fn w17e4d_s3_item_stream_spec(
  sep : String,
  stage_dir : String,
  gen : String,
  item : RestoreFetchItem,
) -> Option[(String, String, Option[String])] {
  match item {
    RestoreFetchItem::Batch(b) =>
    Some(("log/" + gen + "/" + b, nodepath::join(sep, [stage_dir, gen, "log", b]), None))
    RestoreFetchItem::ChatFile(h) =>
    Some(("files/" + h, nodepath::join(sep, [stage_dir, "files", h]), Some(h)))
    RestoreFetchItem::TranscriptFile(h) =>
    Some(("files/" + h, nodepath::join(sep, [stage_dir, "files", h]), None))
    _ => None
  }
}

/// Reset per-item streaming/chunked cursors on `CopiesRestoreJob`.
fn w17e4d_clear_restore_item_cursors(job : CopiesRestoreJob) -> Unit {
  job.chunks = []
  job.total_bytes = 0
  job.status = 0
  job.s3_streaming = false
  job.s3_opener = None
  job.s3_part_path = None
  job.s3_final_path = None
  job.s3_write_offset = 0L
  job.s3_hasher = None
  job.kept_src_path = None
  job.kept_part_path = None
  job.kept_final_path = None
  job.kept_offset = 0L
  job.kept_hasher = None
  job.kept_meta_chunks = []
  job.kept_meta_bytes = 0
}

/// Pure per-tick budget guard for `LocalKept` metadata JSON (`head.json` / manifests):
/// if this tick has already done work (`items_done > 0`) and reading `next_file_size` would exceed
/// `W17E4D_KEPT_TICK_BYTE_BUDGET` (2 MiB), yield to the next tick instead of reading up to 16 MiB on 1 byte left!
pub fn w17e4d_kept_should_yield_before_read(bytes_done : Int64, items_done : Int, next_file_size : Int64) -> Bool {
  items_done > 0 && bytes_done + next_file_size > W17E4D_KEPT_TICK_BYTE_BUDGET
}

fn w17e4d_unget_restore_item(job : CopiesRestoreJob, item : RestoreFetchItem) -> Unit {
  match item {
    RestoreFetchItem::ManifestRoot(_) | RestoreFetchItem::ManifestLeaf(_, _) => {
      if job.manifest_idx > 0 { job.manifest_idx = job.manifest_idx - 1 }
    }
    _ => {
      if job.queue_idx > 0 { job.queue_idx = job.queue_idx - 1 }
    }
  }
}

fn w17e4d_parse_lstat_file_size(raw : String) -> Option[Int64] {
  if !raw.starts_with("file|") { return None }
  let parts = raw.split("|")
  if parts.length() < 2 || parts[1].length() == 0 { return None }
  match base_codec::json_parse(parts[1]) {
    base_codec::JsonParseResult::Ok(base_codec::Json::Num(n, _)) => Some(n.to_int64())
    _ => None
  }
}

/// Drive the next item of `CopiesRestoreJob`:
/// - S3: non-blocking `stream.open` (`5334`) with per-object 60s stall timeout and streaming decryption to `.part`.
/// - LocalKept: yields to `on_tick` (bounded 256 KiB chunked copy, <= 2 MiB / 8 items per tick).
fn w17e4d_pump_restore_job(ctx : DaemonCtx, st : WholeRuntimeState, job : CopiesRestoreJob) -> Unit {
  match job.source {
    RestoreSourceKind::LocalKept(_) => return
    _ => ()
  }
  w17e4d_step_restore_once(ctx, st, job)
}

/// Advance `LocalKept` restore within a bounded per-tick I/O budget (256 KiB chunks, <= 2 MiB & 8 items/tick),
/// so small transcript files finish quickly while large files never stall the event loop.
fn w17e4d_step_local_kept_tick(ctx : DaemonCtx, st : WholeRuntimeState, job : CopiesRestoreJob) -> Unit {
  let kept_base = match job.source {
    RestoreSourceKind::LocalKept(b) => b
    _ => return
  }
  let mut bytes_done : Int64 = 0L
  let mut items_done = 0
  while bytes_done < W17E4D_KEPT_TICK_BYTE_BUDGET && items_done < W17E4D_KEPT_TICK_ITEM_CAP {
    // 1. Continue an in-progress chunked file copy if one is active.
    match (job.current_item, job.kept_src_path, job.kept_part_path, job.kept_final_path) {
      (Some(it), Some(src_p), Some(part_p), Some(final_p)) => {
        match station_sys::read_range_meta(src_p, job.kept_offset, W17E4D_KEPT_CHUNK_BYTES) {
          Err(-2) => {
            let _ = station_sys::unlink(part_p)
            w17e4d_clear_restore_item_cursors(job)
            job.current_item = None
            match it {
              RestoreFetchItem::TranscriptFile(_) => {
                w17e4d_bump_restore_done(st, job)
                items_done = items_done + 1
                continue
              }
              _ => { fail_copies_restore_job(ctx, st, "kept restore file vanished: " + src_p, "gone"); return }
            }
          }
          Err(code) => {
            let _ = station_sys::unlink(part_p)
            fail_copies_restore_job(ctx, st, "kept restore read failed (errno " + code.to_string() + ")", "error")
            return
          }
          Ok((chunk, total_sz, _)) => {
            if chunk.length() > 0 {
              match station_sys::write_at(part_p, job.kept_offset, chunk, job.kept_offset == 0L, None, None, false) {
                Err(code) => {
                  let _ = station_sys::unlink(part_p)
                  fail_copies_restore_job(ctx, st, "kept restore write failed (errno " + code.to_string() + ")", "error")
                  return
                }
                Ok(_) => ()
              }
              match job.kept_hasher {
                Some(h) => h.update(chunk)
                None => ()
              }
              job.kept_offset = job.kept_offset + chunk.length().to_int64()
              bytes_done = bytes_done + chunk.length().to_int64()
            } else if job.kept_offset == 0L {
              // Empty 0-byte file: create empty `.part`.
              match station_sys::write_at(part_p, 0L, Bytes::new(0), true, None, Some(0L), false) {
                Err(code) => {
                  let _ = station_sys::unlink(part_p)
                  fail_copies_restore_job(ctx, st, "kept restore empty write failed (errno " + code.to_string() + ")", "error")
                  return
                }
                Ok(_) => ()
              }
            }
            if job.kept_offset >= total_sz || chunk.length() == 0 {
              match (it, job.kept_hasher) {
                (RestoreFetchItem::ChatFile(expected_h), Some(h)) => {
                  if h.finalize_hex() != expected_h {
                    let _ = station_sys::unlink(part_p)
                    fail_copies_restore_job(ctx, st, "kept restore sha256 mismatch for " + expected_h, "error")
                    return
                  }
                }
                _ => ()
              }
              match station_sys::sync_file(part_p) {
                Err(_) => {
                  let _ = station_sys::unlink(part_p)
                  fail_copies_restore_job(ctx, st, "kept restore fsync failed", "error")
                  return
                }
                Ok(_) => ()
              }
              if !station_sys::rename(part_p, final_p) {
                let _ = station_sys::unlink(part_p)
                fail_copies_restore_job(ctx, st, "kept restore rename failed", "error")
                return
              }
              w17e4d_clear_restore_item_cursors(job)
              job.current_item = None
              w17e4d_bump_restore_done(st, job)
              items_done = items_done + 1
            }
            continue
          }
        }
      }
      // 1b. Continue an in-progress chunked metadata JSON read (`Head` / `ManifestRoot` / `ManifestLeaf` > 2 MiB).
      (Some(it), Some(src_p), None, None) => {
        match station_sys::read_range_meta(src_p, job.kept_offset, W17E4D_KEPT_CHUNK_BYTES) {
          Err(-2) => {
            w17e4d_clear_restore_item_cursors(job)
            job.current_item = None
            w17e4d_handle_restore_item_bytes(ctx, st, job, it, 404, Bytes::new(0), false)
            return
          }
          Err(code) => {
            fail_copies_restore_job(ctx, st, "kept restore metadata read failed (errno " + code.to_string() + ")", "error")
            return
          }
          Ok((chunk, total_sz, _)) => {
            if total_sz > W17E4D_RESTORE_SMALL_JSON_CAP.to_int64()
            || job.kept_meta_bytes + chunk.length() > W17E4D_RESTORE_SMALL_JSON_CAP {
              fail_copies_restore_job(ctx, st, "kept restore metadata JSON exceeded 16 MiB cap", "error")
              return
            }
            if chunk.length() > 0 {
              job.kept_meta_chunks.push(chunk)
              job.kept_meta_bytes = job.kept_meta_bytes + chunk.length()
              job.kept_offset = job.kept_offset + chunk.length().to_int64()
              bytes_done = bytes_done + chunk.length().to_int64()
            }
            if job.kept_offset >= total_sz || chunk.length() == 0 {
              let full = live_concat_chunks(job.kept_meta_chunks, job.kept_meta_bytes)
              w17e4d_clear_restore_item_cursors(job)
              job.current_item = None
              w17e4d_handle_restore_item_bytes(ctx, st, job, it, 200, full, false)
              if st.w17e4d.restore_job.is_none() { return }
              items_done = items_done + 1
            }
            continue
          }
        }
      }
      _ => ()
    }
    // 2. Otherwise dequeue next item.
    let item = match w17e4d_next_restore_item(job) {
      Some(it) => it
      None => {
        w17e4d_commit_restore_and_restart(ctx, st, job)
        return
      }
    }
    let rel_sub = match item {
      RestoreFetchItem::Head => job.gen + "/head.json"
      RestoreFetchItem::ManifestRoot(h) => "files/" + h
      RestoreFetchItem::ManifestLeaf(_, h) => "files/" + h
      RestoreFetchItem::Batch(b) => job.gen + "/log/" + b
      RestoreFetchItem::ChatFile(h) => "files/" + h
      RestoreFetchItem::TranscriptFile(h) => "files/" + h
    }
    match w17e4d_check_no_symlink(kept_base, rel_sub) {
      Err(e) => { fail_copies_restore_job(ctx, st, e, "error"); return }
      Ok(_) => ()
    }
    let full_p = nodepath::join(ctx.sep, [kept_base, rel_sub])
    match w17e4d_s3_item_stream_spec(ctx.sep, job.stage_dir, job.gen, item) {
      Some((_, dst_p, expected_hash_opt)) => {
        // Chunked file copy (batches / attachments / transcripts)
        job.current_item = Some(item)
        job.kept_src_path = Some(full_p)
        job.kept_part_path = Some(dst_p + ".part")
        job.kept_final_path = Some(dst_p)
        job.kept_offset = 0L
        job.kept_hasher = match expected_hash_opt { Some(_) => Some(crypto::Sha256::new()), None => None }
      }
      None => {
        // Small JSON metadata (`Head`, `ManifestRoot`, `ManifestLeaf`):
        // Stat first to enforce 16 MiB cap + remaining per-tick budget BEFORE reading;
        // if > 2 MiB (or if remaining budget is too small on a non-first item), yield or chunk at 256 KiB!
        match station_sys::lstat_raw_err(full_p) {
          Err(-2) => {
            w17e4d_handle_restore_item_bytes(ctx, st, job, item, 404, Bytes::new(0), false)
            return
          }
          Err(code) => {
            fail_copies_restore_job(ctx, st, "kept restore metadata stat failed (errno " + code.to_string() + ")", "error")
            return
          }
          Ok(raw_meta) => match w17e4d_parse_lstat_file_size(raw_meta) {
            None => {
              fail_copies_restore_job(ctx, st, "kept restore metadata is not a regular file", "error")
              return
            }
            Some(file_sz) => {
              if file_sz > W17E4D_RESTORE_SMALL_JSON_CAP.to_int64() {
                fail_copies_restore_job(ctx, st, "kept restore metadata JSON exceeded 16 MiB cap", "error")
                return
              }
              if w17e4d_kept_should_yield_before_read(bytes_done, items_done, file_sz) {
                w17e4d_unget_restore_item(job, item)
                return
              }
              // Read in bounded 256 KiB chunks (respects 2 MiB per-tick budget even for >2 MiB manifests).
              job.current_item = Some(item)
              job.kept_src_path = Some(full_p)
              job.kept_part_path = None
              job.kept_final_path = None
              job.kept_offset = 0L
              job.kept_meta_chunks = []
              job.kept_meta_bytes = 0
            }
          }
        }
      }
    }
  }
}

fn w17e4d_step_restore_once(ctx : DaemonCtx, st : WholeRuntimeState, job : CopiesRestoreJob) -> Unit {
  let item = match w17e4d_next_restore_item(job) {
    Some(it) => it
    None => {
      w17e4d_commit_restore_and_restart(ctx, st, job)
      return
    }
  }
  w17e4d_clear_restore_item_cursors(job)
  job.current_item = Some(item)
  job.stall_deadline_ms = host_shim::now_ms() + W17E4D_RESTORE_OBJ_STALL_MS

  match job.source {
    RestoreSourceKind::S3(target, enc_key, ws_tag, origin_tag) => {
      let obj_rel = match item {
        RestoreFetchItem::Head => ws_tag + "/" + origin_tag + "/head/" + job.gen + ".enc"
        RestoreFetchItem::ManifestRoot(h) => ws_tag + "/" + origin_tag + "/files/" + station_replica::s3_file_tag(enc_key, h) + ".enc"
        RestoreFetchItem::ManifestLeaf(_, h) => ws_tag + "/" + origin_tag + "/files/" + station_replica::s3_file_tag(enc_key, h) + ".enc"
        RestoreFetchItem::Batch(b) => ws_tag + "/" + origin_tag + "/log/" + job.gen + "/" + b + ".enc"
        RestoreFetchItem::ChatFile(h) => ws_tag + "/" + origin_tag + "/files/" + station_replica::s3_file_tag(enc_key, h) + ".enc"
        RestoreFetchItem::TranscriptFile(h) => ws_tag + "/" + origin_tag + "/files/" + station_replica::s3_file_tag(enc_key, h) + ".enc"
      }
      let full_key = w17e4d_s3_object_key(target, obj_rel)
      let signed = station_replica::sign_s3_request(target, "GET", full_key, Map::new(), Bytes::new(0), Map::new(), host_shim::wall_ms())
      let hdr_pairs : Array[(String, String)] = []
      let hks = signed.headers.keys()
      for i in 0..<hks.length() {
        match signed.headers.get(hks[i]) {
          Some(v) => hdr_pairs.push((hks[i], v))
          None => ()
        }
      }
      let _ = ctx.mux_role.call_async_raw(
        builders_core::MuxToken::Tagged(0, W17E4D_TOK_RESTORE_S3_OPEN, job.job_id),
        "stream.open",
        live_build_stream_open_args("GET", signed.url, hdr_pairs, W17E4D_RESTORE_OBJ_STALL_MS),
        None,
      )
    }
    RestoreSourceKind::LocalKept(_) => ()
  }
}

/// Sweep stale `<data>/restore/.staging-*` directories left by a previous crash.
fn w17e4d_sweep_stale_restore_staging(restore_root : String, sep : String) -> Unit {
  match station_sys::read_dir(restore_root) {
    Some(entries) => {
      for i in 0..<entries.length() {
        if entries[i].starts_with(".staging-") {
          w17e4d_remove_tree(nodepath::join(sep, [restore_root, entries[i]]))
        }
      }
    }
    None => ()
  }
}

/// Start a non-blocking `copies.restore` job (returns `Ok({"restoring": true})` immediately for HTTP 202).
/// Non-self `from.station` (remote peer keeper) returns an explicit synchronous `501` because outbound
/// `PEER_BYTES_ALPN` streaming is not yet implemented in `daemon_core` (never returns 202 + fake `offline`/`gone`).
pub fn start_copies_restore_job(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  ws : String,
  origin : String,
  gen : String,
  from_kind : String,
  from_id : String,
) -> Result[base_codec::Json, station_api::ApiError] {
  match w17e4d_station_is_empty(st) {
    Ok(true) => ()
    Ok(false) => return Err(station_api::ApiError::new(409, "this station has chats of its own: a copy is taken back only into a new one"))
    Err(e) => return Err(station_api::ApiError::new(500, e))
  }
  match st.w17e4d.restoring_view {
    Some(rv) if rv.error.is_none() && st.w17e4d.restore_job.is_some() => {
      return Err(station_api::ApiError::new(409, "a restore is under way"))
    }
    _ => ()
  }
  // Honest synchronous 501 for remote peer keeper (before touching `restoring_view` or returning 202).
  let self_id = match ctx.cloud.state { Some(cs) => cs.station, None => ctx.station_key.id }
  if from_kind != "s3" && from_id != self_id {
    return Err(
      station_api::ApiError::new(
        501,
        "restoring from a remote keeper station requires PEER_BYTES_ALPN streaming (not yet implemented in Pion station)",
      ),
    )
  }
  let from_label = if from_kind == "s3" { "s3:" + from_id } else { from_id }
  let rv = RestoringView::{
    origin: origin,
    name: "",
    workspace: ws,
    gen: gen,
    from_label: from_label,
    done: 0,
    total: 0,
    error: None,
    reason: None,
    restart: false,
  }
  st.w17e4d.restoring_view = Some(rv)

  let mut target_name = from_id
  let source_res : Result[RestoreSourceKind, (String, String)] = if from_kind == "s3" {
    let saved = station_replica::read_backup_config(ctx.config_file.raw()).s3
    let mut target_opt : Option[station_replica::NormalizedS3Target] = None
    for i in 0..<saved.length() {
      if saved[i].id == from_id {
        target_opt = Some(saved[i])
        break
      }
    }
    match target_opt {
      None => Err(("S3 target " + from_id + " is not configured", "gone"))
      Some(t) => {
        if t.name.length() > 0 { target_name = t.name }
        match w17e4d_hex_to_bytes32(t.encryption_key) {
          Some(k) => Ok(RestoreSourceKind::S3(t, k, station_replica::s3_ws_tag(k, ws), station_replica::s3_origin_tag(k, origin)))
          None => Err(("S3 target encryptionKey is invalid", "error"))
        }
      }
    }
  } else {
    let kept_base = nodepath::join(ctx.sep, [ctx.data, "replica", "kept", ws, origin])
    Ok(RestoreSourceKind::LocalKept(kept_base))
  }
  let target_kind = if from_kind == "s3" { "s3" } else { "station" }
  let source = match source_res {
    Ok(s) => s
    Err((msg, reason)) => {
      // 1:1 with Node `copies.ts:1751-1770`: 202 accepted, then fails asynchronously into `restoring` + history + SSE!
      rv.error = Some(msg)
      rv.reason = Some(reason)
      w17e4d_record_restore_history(ctx, ws, target_kind, from_id, target_name, reason, msg)
      st.core.api.events.overview_changed("copies")
      return Ok(base_codec::json_obj([("restoring", base_codec::json_bool(true))]))
    }
  }
  match w17e4d_check_no_symlink(ctx.data, "restore") {
    Ok(_) => ()
    Err(e) => {
      rv.error = Some(e)
      rv.reason = Some("error")
      w17e4d_record_restore_history(ctx, ws, target_kind, from_id, target_name, "error", e)
      st.core.api.events.overview_changed("copies")
      return Ok(base_codec::json_obj([("restoring", base_codec::json_bool(true))]))
    }
  }
  let restore_root = nodepath::join(ctx.sep, [ctx.data, "restore"])
  if !station_sys::mkdir_p(restore_root) {
    rv.error = Some("failed to create restore directory")
    rv.reason = Some("error")
    w17e4d_record_restore_history(ctx, ws, target_kind, from_id, target_name, "error", "failed to create restore directory")
    st.core.api.events.overview_changed("copies")
    return Ok(base_codec::json_obj([("restoring", base_codec::json_bool(true))]))
  }
  w17e4d_sweep_stale_restore_staging(restore_root, ctx.sep)
  let suffix = match station_sys::random_hex(8) {
    Ok(h) => h
    Err(e) => {
      rv.error = Some("CSPRNG failed: " + e)
      rv.reason = Some("error")
      w17e4d_record_restore_history(ctx, ws, target_kind, from_id, target_name, "error", "CSPRNG failed: " + e)
      st.core.api.events.overview_changed("copies")
      return Ok(base_codec::json_obj([("restoring", base_codec::json_bool(true))]))
    }
  }
  let stage_dir = nodepath::join(ctx.sep, [restore_root, ".staging-" + suffix])
  if !station_sys::mkdir_p(nodepath::join(ctx.sep, [stage_dir, gen, "log"]))
  || !station_sys::mkdir_p(nodepath::join(ctx.sep, [stage_dir, "files"])) {
    w17e4d_remove_tree(stage_dir)
    rv.error = Some("failed to create restore staging directory")
    rv.reason = Some("error")
    w17e4d_record_restore_history(ctx, ws, target_kind, from_id, target_name, "error", "failed to create restore staging directory")
    st.core.api.events.overview_changed("copies")
    return Ok(base_codec::json_obj([("restoring", base_codec::json_bool(true))]))
  }
  let jid = w17e4d_alloc_job_id(st.w17e4d)
  let now_m = host_shim::now_ms()
  let job = CopiesRestoreJob::{
    job_id: jid,
    ws: ws,
    origin: origin,
    gen: gen,
    from_label: from_label,
    target_kind: target_kind,
    target_id: from_id,
    target_name: target_name,
    source: source,
    stage_dir: stage_dir,
    manifest_budget: station_replica::ManifestBudget::new(),
    name: origin,
    head_raw: None,
    manifest_queue: [],
    manifest_idx: 0,
    queue: [RestoreFetchItem::Head],
    queue_idx: 0,
    current_item: None,
    stream_id: None,
    status: 0,
    chunks: [],
    total_bytes: 0,
    stall_deadline_ms: now_m + W17E4D_RESTORE_OBJ_STALL_MS,
    last_progress_push_ms: now_m,
    s3_streaming: false,
    s3_opener: None,
    s3_part_path: None,
    s3_final_path: None,
    s3_write_offset: 0L,
    s3_hasher: None,
    kept_src_path: None,
    kept_part_path: None,
    kept_final_path: None,
    kept_offset: 0L,
    kept_hasher: None,
    kept_meta_chunks: [],
    kept_meta_bytes: 0,
  }
  st.w17e4d.restore_job = Some(job)
  st.core.api.events.overview_changed("copies")
  w17e4d_pump_restore_job(ctx, st, job)
  Ok(base_codec::json_obj([("restoring", base_codec::json_bool(true))]))
}

// ---------------------------------------------------------------------------
// 4. Real XShare Reconciler (`xshare.list` + `xshare.roster` + Backoff + Inbound RPC)
// ---------------------------------------------------------------------------

/// Unwrap the `{"result": ...}` peer RPC answer envelope returned by `parse_ask_reply`.
pub fn w17e4d_unwrap_peer_result(raw : base_codec::Json) -> base_codec::Json {
  match base_codec::json_get(raw, "result") {
    Some(inner) => inner
    None => raw
  }
}

fn w17e4d_is_xshare_refusal(err_msg : String) -> Bool {
  let low = w17e4d_ascii_lower(err_msg)
  low.contains("shares no chat")
  || low.contains("not open to other workspaces")
  || low.contains("refused")
  || low.contains("denied")
}

/// Pure, testable `xshare.list` reply merger (1:1 with Node `xshare/index.ts:448-524`):
/// - Unwraps `{"result": { fromName, chats }}`.
/// - Performs WHOLE replacement of all previous `borrowed` entries belonging to `(own_ws, host_station)`
///   (including clearing them when `chats` is empty OR when the host refuses).
/// - Returns `(next_state, has_borrowed_for_host, should_retry)`.
pub fn w17e4d_apply_xshare_list_reply(
  existing_state : base_codec::Json,
  own_ws : String,
  home_ws : String,
  host_station : String,
  target_ws : String,
  reply_res : Result[base_codec::Json, String],
) -> (base_codec::Json, Bool, Bool) {
  let is_entry_of_host = fn(b : base_codec::Json) -> Bool {
    let st = match live_json_str_f(b, "station") { Some(s) => s, None => "" }
    let b_as = match live_json_str_f(b, "as") { Some(s) if s.length() > 0 => s, _ => home_ws }
    st == host_station && b_as == own_ws
  }
  let existing_borrowed = match base_codec::json_get(existing_state, "borrowed") {
    Some(base_codec::Json::Obj(fs)) => fs
    _ => []
  }
  let kept_borrowed : Array[(String, base_codec::Json)] = []
  for i in 0..<existing_borrowed.length() {
    if !is_entry_of_host(existing_borrowed[i].1) {
      kept_borrowed.push(existing_borrowed[i])
    }
  }
  match reply_res {
    Err(msg) => {
      if w17e4d_is_xshare_refusal(msg) {
        // Host shares nothing with this workspace (any more): clear all old borrowed entries for it, no retry.
        let out_fs : Array[(String, base_codec::Json)] = []
        match existing_state {
          base_codec::Json::Obj(efs) => {
            for i in 0..<efs.length() {
              if efs[i].0 != "borrowed" { out_fs.push(efs[i]) }
            }
          }
          _ => ()
        }
        out_fs.push(("borrowed", base_codec::json_obj(kept_borrowed)))
        return (base_codec::json_obj(out_fs), false, false)
      }
      // Transient offline/network error: keep existing borrowed entries and schedule backoff retry.
      return (existing_state, false, true)
    }
    Ok(raw_env) => {
      let got = w17e4d_unwrap_peer_result(raw_env)
      let from_name = match live_json_str_f(got, "fromName") {
        Some(s) if s.trim().length() > 0 => station_whole::xshare_trim_max_codepoints(s, 80)
        _ => target_ws
      }
      let mut added = 0
      let seen_keys : Map[String, Bool] = Map::new()
      match base_codec::json_get(got, "chats") {
        Some(base_codec::Json::Arr(chats)) => {
          for i in 0..<chats.length() {
            let c = chats[i]
            let chat = match live_json_str_f(c, "chat") { Some(s) => station_whole::xshare_trim_max_codepoints(s, 200), None => "" }
            let link = match live_json_str_f(c, "link") { Some(s) => station_whole::xshare_trim_max_codepoints(s, 1000), None => "" }
            if chat.length() == 0 || !link.contains("/o/" + target_ws + "/" + host_station + "/") {
              continue
            }
            let title_raw = match live_json_str_f(c, "title") { Some(s) => station_whole::xshare_trim_max_codepoints(s, 200), None => "" }
            let title = if title_raw.length() > 0 { title_raw } else { chat }
            let wr = live_json_bool_f(c, "write") == Some(true)
            let ver = match w17e4d_json_i64(base_codec::json_get(c, "version")) { Some(n) => n, None => 0L }
            let bkey = own_ws + "/" + host_station + "/" + chat
            if seen_keys.contains(bkey) {
              continue
            }
            seen_keys.set(bkey, true)
            let bval = base_codec::json_obj([
              ("workspace", base_codec::json_str(target_ws)),
              ("workspaceName", base_codec::json_str(from_name)),
              ("station", base_codec::json_str(host_station)),
              ("chat", base_codec::json_str(chat)),
              ("title", base_codec::json_str(title)),
              ("link", base_codec::json_str(link)),
              ("write", base_codec::json_bool(wr)),
              ("version", base_codec::json_int64(ver)),
              ("as", base_codec::json_str(own_ws)),
            ])
            kept_borrowed.push((bkey, bval))
            added = added + 1
          }
        }
        _ => ()
      }
      let out_fs : Array[(String, base_codec::Json)] = []
      match existing_state {
        base_codec::Json::Obj(efs) => {
          for i in 0..<efs.length() {
            if efs[i].0 != "borrowed" { out_fs.push(efs[i]) }
          }
        }
        _ => ()
      }
      out_fs.push(("borrowed", base_codec::json_obj(kept_borrowed)))
      (base_codec::json_obj(out_fs), added > 0, false)
    }
  }
}

/// Anchored read of `<data>/xshare/state.json`: distinguishes ENOENT (`-2` -> empty object)
/// from symlink (`-5`), non-regular file, permission/IO errors, or corrupt JSON (all fail-closed!).
fn w17e4d_read_xshare_state_anchored(data_dir : String, sep : String) -> Result[base_codec::Json, String] {
  let xdir = nodepath::join(sep, [data_dir, "xshare"])
  match station_sys::lstat_raw_err(xdir) {
    Err(-2) => return Ok(base_codec::json_obj([]))
    Err(code) => return Err("failed to stat xshare directory (errno " + code.to_string() + ")")
    Ok(raw) => {
      if raw.starts_with("symlink|") { return Err("symlink xshare directory rejected") }
      if !raw.starts_with("dir|") { return Err("xshare path is not a directory") }
    }
  }
  let state_path = nodepath::join(sep, [xdir, "state.json"])
  match station_sys::lstat_raw_err(state_path) {
    Err(-2) => return Ok(base_codec::json_obj([]))
    Err(code) => return Err("failed to stat xshare/state.json (errno " + code.to_string() + ")")
    Ok(raw) => {
      if raw.starts_with("symlink|") { return Err("symlink xshare/state.json rejected") }
      if !raw.starts_with("file|") { return Err("xshare/state.json is not a regular file") }
    }
  }
  let raw_bytes = match station_whole::rep_read_binary_file(state_path) {
    Ok(b) => b
    Err(e) => return Err("failed to read xshare/state.json: " + e)
  }
  match base_codec::json_parse(raw_bytes.to_string()) {
    base_codec::JsonParseResult::Ok(base_codec::Json::Obj(fs)) => Ok(base_codec::Json::Obj(fs))
    _ => Err("xshare/state.json is corrupt")
  }
}

fn w17e4d_write_xshare_state_anchored(data_dir : String, sep : String, state_j : base_codec::Json) -> Result[Unit, String] {
  let xdir = nodepath::join(sep, [data_dir, "xshare"])
  match station_sys::lstat_raw_err(xdir) {
    Err(-2) => if !station_sys::mkdir_p(xdir) { return Err("failed to create xshare directory") }
    Err(code) => return Err("failed to stat xshare directory (errno " + code.to_string() + ")")
    Ok(raw) => {
      if raw.starts_with("symlink|") { return Err("symlink xshare directory rejected") }
      if !raw.starts_with("dir|") { return Err("xshare path is not a directory") }
    }
  }
  let state_path = nodepath::join(sep, [xdir, "state.json"])
  match station_sys::lstat_raw_err(state_path) {
    Err(-2) => ()
    Err(code) => return Err("failed to stat xshare/state.json (errno " + code.to_string() + ")")
    Ok(raw) => {
      if raw.starts_with("symlink|") { return Err("symlink xshare/state.json rejected") }
      if !raw.starts_with("file|") { return Err("xshare/state.json is not a regular file") }
    }
  }
  if !station_sys::write_file_atomic(state_path, (base_codec::json_stringify(state_j) + "\n").to_bytes(), mode=384) {
    return Err("failed to atomically write xshare/state.json")
  }
  Ok(())
}

fn w17e4d_schedule_xshare_retry(st : WholeRuntimeState, own_ws : String, host_station : String, target_ws : String) -> Unit {
  let mut dup = false
  for i in 0..<st.w17e4d.xshare_retry_queue.length() {
    let q = st.w17e4d.xshare_retry_queue[i]
    if q.0 == own_ws && q.1 == host_station && q.2 == target_ws {
      dup = true
      break
    }
  }
  if !dup {
    st.w17e4d.xshare_retry_queue.push((own_ws, host_station, target_ws))
  }
  if st.w17e4d.xshare_retry_at_ms == 0L {
    st.w17e4d.xshare_retry_at_ms = host_shim::now_ms() + st.w17e4d.xshare_retry_backoff_ms
    let next_b = st.w17e4d.xshare_retry_backoff_ms * 2L
    st.w17e4d.xshare_retry_backoff_ms = if next_b > W17E4D_XSHARE_RETRY_MAX_MS { W17E4D_XSHARE_RETRY_MAX_MS } else { next_b }
  }
}

fn w17e4d_workspace_roster_for_xshare(ctx : DaemonCtx, own_ws : String) -> Option[(Array[base_codec::Json], String)] {
  if !ctx.cloud.peers_current {
    return None
  }
  let cs = match ctx.cloud.state { Some(c) => c, None => return None }
  let peers : Array[base_codec::Json] = if cs.workspace == own_ws {
    cs.peers
  } else {
    let mut found : Option[Array[base_codec::Json]] = None
    for i in 0..<cs.joined.length() {
      if cs.joined[i].workspace == own_ws {
        found = Some(cs.joined[i].peers)
        break
      }
    }
    match found { Some(ps) => ps, None => return None }
  }
  if peers.length() == 0 {
    return None
  }
  let ids : Array[String] = []
  let stations : Array[base_codec::Json] = []
  for i in 0..<peers.length() {
    let p = peers[i]
    let pid = match live_json_str_f(p, "id") { Some(s) => s, None => "" }
    if station_whole::is_valid_xshare_id(pid) {
      ids.push(pid)
      let pname = match live_json_str_f(p, "name") { Some(s) => station_whole::xshare_trim_max_codepoints(s, 80), None => "" }
      let nm = if pname.length() > 0 { pname } else if pid.length() > 8 { pid.slice(0, 8) } else { pid }
      stations.push(base_codec::json_obj([("id", base_codec::json_str(pid)), ("name", base_codec::json_str(nm))]))
    }
  }
  if stations.length() == 0 {
    return None
  }
  let sorted = station_replica::sort_strings(ids)
  let sorted_j : Array[base_codec::Json] = []
  for i in 0..<sorted.length() {
    sorted_j.push(base_codec::json_str(sorted[i]))
  }
  let h = crypto::sha256_hex(base_codec::json_stringify(base_codec::json_arr(sorted_j)).to_bytes())
  Some((stations, h))
}

/// Pure `heard` sequence guard (1:1 with Node `xshare/index.ts:448-460`):
/// returns `true` when an `xshare.changed` arrived while `xshare.list` was in flight (`cur_heard > mark`).
pub fn w17e4d_xshare_list_reply_stale(mark : Int64, cur_heard : Int64) -> Bool {
  cur_heard > mark
}

/// Pure per-host coalesced reconcile gate: allows at most 1 in-flight `xshare.list` + 1 pending dirty flag
/// per `(own_ws, host_station)` key.
pub fn w17e4d_xshare_try_start_reconcile(
  inflight : Map[String, Bool],
  dirty : Map[String, (String, String, String)],
  list_key : String,
  own_ws : String,
  host_station : String,
  target_ws : String,
) -> Bool {
  if inflight.contains(list_key) {
    dirty.set(list_key, (own_ws, host_station, target_ws))
    return false
  }
  inflight.set(list_key, true)
  dirty.remove(list_key)
  true
}

/// Pure completion helper: clears in-flight state and returns `Some((own_ws, host_station, target_ws))`
/// when either the completed reply was stale (`cur_heard > mark`) OR a coalesced dirty flag was set
/// while in flight — ensuring ONE follow-up `xshare.list` re-query keeps all other chats on that host fresh.
pub fn w17e4d_xshare_finish_reconcile(
  inflight : Map[String, Bool],
  dirty : Map[String, (String, String, String)],
  list_key : String,
  own_ws : String,
  host_station : String,
  target_ws : String,
  stale : Bool,
) -> Option[(String, String, String)] {
  inflight.remove(list_key)
  match dirty.get(list_key) {
    Some(next) => {
      dirty.remove(list_key)
      Some(next)
    }
    None => if stale { Some((own_ws, host_station, target_ws)) } else { None }
  }
}

/// Trigger real xshare reconciliation for a trusted host (`station/src/xshare/index.ts:448-524`):
/// - Enforces at most 1 in-flight `xshare.list` + 1 coalesced dirty flag per `(own_ws, host_station)`.
/// - Snapshots `xshare_heard[list_key]` before dispatch; if `cur_heard > mark` on reply, discards the
///   stale snapshot AND schedules ONE coalesced follow-up `xshare.list` re-query so other chats on the
///   same host never stall on stale state.
/// - Unwraps `{"result": ...}`, performs whole replacement of `borrowed` (clearing stale entries on
///   empty list or refusal), pushes `xshare.roster` when roster hash changes, and retries with
///   exponential backoff on transient errors.
pub fn w17e4d_reconcile_xshare_host(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  own_ws : String,
  host_station : String,
  target_ws : String,
) -> Unit {
  let list_key = own_ws + "/" + host_station
  st.w17e4d.xshare_listed.remove(list_key)
  st.w17e4d.xshare_reconcile_count = st.w17e4d.xshare_reconcile_count + 1L
  st.core.api.events.overview_changed("xshare")
  if !w17e4d_xshare_try_start_reconcile(st.w17e4d.xshare_inflight, st.w17e4d.xshare_dirty, list_key, own_ws, host_station, target_ws) {
    return
  }
  let home_ws = st.core.config.home_workspace
  let heard_mark = match st.w17e4d.xshare_heard.get(list_key) { Some(n) => n, None => 0L }
  let req = base_codec::json_obj([
    ("method", base_codec::json_str("xshare.list")),
    ("workspace", base_codec::json_str(target_ws)),
    ("as", base_codec::json_str(own_ws)),
  ])
  ctx.ask_peer_rpc(host_station, target_ws, req, fn(res : Result[base_codec::Json, String]) -> Unit {
    let cur_heard = match st.w17e4d.xshare_heard.get(list_key) { Some(n) => n, None => 0L }
    let stale = w17e4d_xshare_list_reply_stale(heard_mark, cur_heard)
    let follow_up = w17e4d_xshare_finish_reconcile(
      st.w17e4d.xshare_inflight,
      st.w17e4d.xshare_dirty,
      list_key,
      own_ws,
      host_station,
      target_ws,
      stale,
    )
    if stale {
      match follow_up {
        Some((f_ws, f_st, f_target)) => w17e4d_reconcile_xshare_host(ctx, st, f_ws, f_st, f_target)
        None => ()
      }
      return
    }
    let existing = match w17e4d_read_xshare_state_anchored(ctx.data, ctx.sep) {
      Ok(j) => j
      Err(_) => {
        match follow_up {
          Some((f_ws, f_st, f_target)) => w17e4d_reconcile_xshare_host(ctx, st, f_ws, f_st, f_target)
          None => ()
        }
        return
      }
    }
    let (next_state, has_borrowed, should_retry) = w17e4d_apply_xshare_list_reply(
      existing,
      own_ws,
      home_ws,
      host_station,
      target_ws,
      res,
    )
    if should_retry {
      match follow_up {
        Some((f_ws, f_st, f_target)) => w17e4d_reconcile_xshare_host(ctx, st, f_ws, f_st, f_target)
        None => w17e4d_schedule_xshare_retry(st, own_ws, host_station, target_ws)
      }
      return
    }
    st.w17e4d.xshare_listed.set(list_key, true)
    st.w17e4d.xshare_retry_backoff_ms = W17E4D_XSHARE_RETRY_BASE_MS
    let _ = w17e4d_write_xshare_state_anchored(ctx.data, ctx.sep, next_state)
    st.core.api.events.overview_changed("xshare")
    match follow_up {
      Some((f_ws, f_st, f_target)) => w17e4d_reconcile_xshare_host(ctx, st, f_ws, f_st, f_target)
      None => ()
    }
    // Push `xshare.roster` so the host knows our workspace stations for `xshare.changed` pushes.
    if has_borrowed {
      match w17e4d_workspace_roster_for_xshare(ctx, own_ws) {
        Some((stations_j, r_hash)) => {
          let prev_hash = match base_codec::json_get(next_state, "roster") {
            Some(r_obj) => live_json_str_f(r_obj, list_key)
            None => None
          }
          if prev_hash != Some(r_hash) {
            let roster_req = base_codec::json_obj([
              ("method", base_codec::json_str("xshare.roster")),
              ("workspace", base_codec::json_str(target_ws)),
              ("stations", base_codec::json_arr(stations_j)),
              ("as", base_codec::json_str(own_ws)),
            ])
            ctx.ask_peer_rpc(host_station, target_ws, roster_req, fn(r_res : Result[base_codec::Json, String]) -> Unit {
              match r_res {
                Err(e) => if !w17e4d_is_xshare_refusal(e) {
                  w17e4d_schedule_xshare_retry(st, own_ws, host_station, target_ws)
                }
                Ok(_) => match w17e4d_read_xshare_state_anchored(ctx.data, ctx.sep) {
                  Ok(cur_st) => {
                    let cur_r = match base_codec::json_get(cur_st, "roster") {
                      Some(base_codec::Json::Obj(fs)) => fs
                      _ => []
                    }
                    let next_r : Array[(String, base_codec::Json)] = []
                    for i in 0..<cur_r.length() {
                      if cur_r[i].0 != list_key { next_r.push(cur_r[i]) }
                    }
                    next_r.push((list_key, base_codec::json_str(r_hash)))
                    let out_fs : Array[(String, base_codec::Json)] = []
                    match cur_st {
                      base_codec::Json::Obj(efs) => {
                        for i in 0..<efs.length() {
                          if efs[i].0 != "roster" { out_fs.push(efs[i]) }
                        }
                      }
                      _ => ()
                    }
                    out_fs.push(("roster", base_codec::json_obj(next_r)))
                    let _ = w17e4d_write_xshare_state_anchored(ctx.data, ctx.sep, base_codec::json_obj(out_fs))
                  }
                  Err(_) => ()
                }
              }
            })
          }
        }
        None => ()
      }
    }
  })
}

/// Summary of a hosted shared chat read from `chat_shares` JOIN `sessions` for `xshare.list`.
pub struct XshareHostedChatInfo {
  pub chat : String
  pub title : String
  pub link : String
  pub write : Bool
  pub workspace : String
  pub shared_workspaces : Array[String]
}

fn w17e4d_str_arr_contains(xs : Array[String], target : String) -> Bool {
  for i in 0..<xs.length() {
    if xs[i] == target { return true }
  }
  false
}

/// Pure, testable inbound `xshare.*` / outside `describe` peer RPC handler (1:1 with Node `xshare/index.ts:546-660`).
/// - `xshare.list`: enumerates `hosted_chats` authorized for `matched_guests` in workspace `here`.
/// - `xshare.changed` with `{ chat, gone: true }`: removes matching `(here, peer_id, chat)` from `borrowed` even without `from`.
/// - `describe` (outside): honestly advertises only capabilities currently implemented on `BusOutside` (`reads: false, messages: false, files: false`).
/// Returns `Ok((reply_json, optional_updated_state, optional_reconcile_host))` or `Err(msg)`.
pub fn w17e4d_handle_xshare_peer_rpc_pure(
  existing_state : base_codec::Json,
  peer_id : String,
  ws : String,
  home_ws : String,
  req : base_codec::Json,
  is_outside : Bool,
  hosted_chats : Array[XshareHostedChatInfo] = [],
  from_ws_name : String = "",
) -> Result[(base_codec::Json, Option[base_codec::Json], Option[(String, String, String)]), String] {
  let method = match live_json_str_f(req, "method") { Some(s) => s, None => "" }
  let here = if ws.length() > 0 { ws } else { home_ws }
  if !is_outside && method == "xshare.trusts" {
    let target_st = match live_json_str_f(req, "station") { Some(s) => s, None => "" }
    let hosts = match base_codec::json_get(existing_state, "hosts") {
      Some(base_codec::Json::Obj(fs)) => fs
      _ => []
    }
    let key = here + "/" + target_st
    for i in 0..<hosts.length() {
      let (hk, hv) = hosts[i]
      let h_as = match live_json_str_f(hv, "as") { Some(s) if s.length() > 0 => s, _ => home_ws }
      if hk == key || (hk == target_st && h_as == here) {
        return Ok((
          base_codec::json_obj([
            ("trusted", base_codec::json_bool(true)),
            ("workspace", base_codec::json_str(match live_json_str_f(hv, "workspace") { Some(s) => s, None => "" })),
            ("name", base_codec::json_str(match live_json_str_f(hv, "name") { Some(s) => s, None => "" })),
            ("stationName", base_codec::json_str(match live_json_str_f(hv, "stationName") { Some(s) => s, None => "" })),
          ]),
          None,
          None,
        ))
      }
    }
    return Ok((base_codec::json_obj([("trusted", base_codec::json_bool(false))]), None, None))
  }
  if method == "xshare.changed" {
    if live_json_bool_f(req, "gone") == Some(true) {
      // 1:1 with Node `xshare/index.ts:644-649`: `{ chat, gone: true }` revokes the borrowed chat even without `from`.
      let gone_chat = match live_json_str_f(req, "chat") {
        Some(s) => station_whole::xshare_trim_max_codepoints(s, 200)
        None => ""
      }
      if gone_chat.length() > 0 {
        let existing_borrowed = match base_codec::json_get(existing_state, "borrowed") {
          Some(base_codec::Json::Obj(fs)) => fs
          _ => []
        }
        let kept_borrowed : Array[(String, base_codec::Json)] = []
        let mut removed_any = false
        for i in 0..<existing_borrowed.length() {
          let b = existing_borrowed[i].1
          let b_st = match live_json_str_f(b, "station") { Some(s) => s, None => "" }
          let b_chat = match live_json_str_f(b, "chat") { Some(s) => s, None => "" }
          let b_as = match live_json_str_f(b, "as") { Some(s) if s.length() > 0 => s, _ => home_ws }
          if b_st == peer_id && b_chat == gone_chat && b_as == here {
            removed_any = true
          } else {
            kept_borrowed.push(existing_borrowed[i])
          }
        }
        if removed_any {
          let out_fs : Array[(String, base_codec::Json)] = []
          match existing_state {
            base_codec::Json::Obj(efs) => {
              for i in 0..<efs.length() {
                if efs[i].0 != "borrowed" { out_fs.push(efs[i]) }
              }
            }
            _ => ()
          }
          out_fs.push(("borrowed", base_codec::json_obj(kept_borrowed)))
          return Ok((base_codec::json_obj([("heard", base_codec::json_bool(true))]), Some(base_codec::json_obj(out_fs)), None))
        }
      }
      return Ok((base_codec::json_obj([("heard", base_codec::json_bool(true))]), None, None))
    }
    let from_ws = match live_json_str_f(req, "from") { Some(s) => s, None => "" }
    if station_whole::is_valid_xshare_id(from_ws) {
      return Ok((base_codec::json_obj([("heard", base_codec::json_bool(true))]), None, Some((here, peer_id, from_ws))))
    }
    return Ok((base_codec::json_obj([("heard", base_codec::json_bool(true))]), None, None))
  }
  // Check guest membership for `describe` (outside), `xshare.list`, `xshare.roster`.
  let ask_as = live_json_str_f(req, "as")
  let guests_obj = match base_codec::json_get(existing_state, "guests") {
    Some(base_codec::Json::Obj(fs)) => fs
    _ => []
  }
  let matched_guests : Array[String] = []
  for i in 0..<guests_obj.length() {
    let g_ws = guests_obj[i].0
    let g_val = guests_obj[i].1
    match ask_as {
      Some(a) if a.length() > 0 && a != g_ws => continue
      _ => ()
    }
    match base_codec::json_get(g_val, "stations") {
      Some(st_obj) if base_codec::json_get(st_obj, peer_id).is_some() => matched_guests.push(g_ws)
      _ => ()
    }
  }
  if matched_guests.length() == 0 {
    return Err("this station shares no chat with your workspace")
  }
  if method == "describe" {
    // Honest capability declaration: `whole_daemon.pion::on_peer_rpc` currently opens `describe`
    // and `xshare.*` on `BusOutside`; cross-workspace `session.{read,file,message,put}` are not yet wired.
    return Ok((
      base_codec::json_obj([
        ("protocol", base_codec::json_int(1)),
        ("outside", base_codec::json_bool(true)),
        ("reads", base_codec::json_bool(false)),
        ("messages", base_codec::json_bool(false)),
        ("files", base_codec::json_bool(false)),
      ]),
      None,
      None,
    ))
  }
  if method == "xshare.list" {
    let hosted_obj = match base_codec::json_get(existing_state, "hosted") {
      Some(base_codec::Json::Obj(fs)) => fs
      _ => []
    }
    let out_chats : Array[base_codec::Json] = []
    for i in 0..<hosted_chats.length() {
      let hc = hosted_chats[i]
      if hc.workspace != here || hc.link.length() == 0 {
        continue
      }
      let mut allowed = false
      for gi in 0..<matched_guests.length() {
        if w17e4d_str_arr_contains(hc.shared_workspaces, matched_guests[gi]) {
          allowed = true
          break
        }
      }
      if !allowed {
        continue
      }
      let mut ver = 0L
      for hi in 0..<hosted_obj.length() {
        if hosted_obj[hi].0 == hc.chat {
          match w17e4d_json_i64(base_codec::json_get(hosted_obj[hi].1, "version")) {
            Some(v) => ver = v
            None => ()
          }
          break
        }
      }
      out_chats.push(
        base_codec::json_obj([
          ("chat", base_codec::json_str(hc.chat)),
          ("title", base_codec::json_str(if hc.title.length() > 0 { hc.title } else { hc.chat })),
          ("link", base_codec::json_str(hc.link)),
          ("write", base_codec::json_bool(hc.write)),
          ("version", base_codec::json_int64(ver)),
        ]),
      )
    }
    let disp_name = if from_ws_name.length() > 0 { from_ws_name } else { here }
    return Ok((
      base_codec::json_obj([
        ("from", base_codec::json_str(here)),
        ("fromName", base_codec::json_str(disp_name)),
        ("chats", base_codec::json_arr(out_chats)),
      ]),
      None,
      None,
    ))
  }
  if method == "xshare.roster" {
    let st_entries : Array[(String, base_codec::Json)] = []
    let mut includes_peer = false
    match base_codec::json_get(req, "stations") {
      Some(base_codec::Json::Arr(xs)) => {
        for i in 0..<xs.length() {
          let sid = match live_json_str_f(xs[i], "id") { Some(s) => s, None => "" }
          if !station_whole::is_valid_xshare_id(sid) { continue }
          if sid == peer_id { includes_peer = true }
          let sn_raw = match live_json_str_f(xs[i], "name") { Some(s) => station_whole::xshare_trim_max_codepoints(s, 80), None => "" }
          let sn = if sn_raw.length() > 0 { sn_raw } else { sid }
          st_entries.push((sid, base_codec::json_str(sn)))
        }
      }
      _ => ()
    }
    if !includes_peer {
      return Err("the stations given must include the one giving them")
    }
    let g_ws = matched_guests[0]
    let next_guests : Array[(String, base_codec::Json)] = []
    let mut g_name = g_ws
    for i in 0..<guests_obj.length() {
      if guests_obj[i].0 == g_ws {
        match live_json_str_f(guests_obj[i].1, "name") {
          Some(n) if n.length() > 0 => g_name = n
          _ => ()
        }
      } else {
        next_guests.push(guests_obj[i])
      }
    }
    next_guests.push((g_ws, base_codec::json_obj([("name", base_codec::json_str(g_name)), ("stations", base_codec::json_obj(st_entries))])))
    let out_fs : Array[(String, base_codec::Json)] = []
    match existing_state {
      base_codec::Json::Obj(efs) => {
        for i in 0..<efs.length() {
          if efs[i].0 != "guests" { out_fs.push(efs[i]) }
        }
      }
      _ => ()
    }
    out_fs.push(("guests", base_codec::json_obj(next_guests)))
    return Ok((base_codec::json_obj([("ok", base_codec::json_bool(true))]), Some(base_codec::json_obj(out_fs)), None))
  }
  Err(method + " is not open to other workspaces: only reading and writing in the chats shared with them")
}

/// Filter `chat_shares.shared` JSON by Node's 6-hour idle expiry rule (`station/src/store/rows.ts:619-649`):
/// each entry's effective last-use time is `(used > 0 ? used : at_ms)`; kept iff `now_ms - eff < 6h`.
pub fn w17e4d_filter_live_shared_workspaces(
  shared_raw : String,
  at_ms : Int64,
  now_ms : Int64,
) -> Array[String] {
  let out : Array[String] = []
  match base_codec::json_parse(shared_raw) {
    base_codec::JsonParseResult::Ok(base_codec::Json::Arr(xs)) => {
      for j in 0..<xs.length() {
        match xs[j] {
          base_codec::Json::Str(w) if w.length() > 0 => {
            if now_ms - at_ms < W17E4D_XSHARE_IDLE_MS {
              out.push(w)
            }
          }
          base_codec::Json::Obj(_) => match live_json_str_f(xs[j], "workspace") {
            Some(w) if w.length() > 0 => {
              let used_ms = match w17e4d_json_i64(base_codec::json_get(xs[j], "used")) {
                Some(u) if u > 0L => u
                _ => at_ms
              }
              if now_ms - used_ms < W17E4D_XSHARE_IDLE_MS {
                out.push(w)
              }
            }
            _ => ()
          }
          _ => ()
        }
      }
    }
    _ => ()
  }
  out
}

/// Query live (non-lapsed, `< 6h` idle) `chat_shares` JOIN `sessions` from SQLite for `xshare.list`.
/// Fail-closed: returns `Err(...)` if the store is not open or SQL fails (NEVER collapses to empty `[]`!).
fn w17e4d_load_hosted_chats_from_store(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  now_ms : Int64,
) -> Result[Array[XshareHostedChatInfo], String] {
  let st_db = match st.core.store.require_open() {
    Ok(d) => d
    Err(e) => return Err("store not open: " + e)
  }
  let home_ws = st.core.config.home_workspace
  let station_id = match ctx.cloud.state {
    Some(cs) if cs.station.length() > 0 => cs.station
    _ => ctx.station_key.id
  }
  let origin = match ctx.cloud.state {
    Some(cs) if cs.origin.trim().length() > 0 => {
      let mut o = cs.origin.trim()
      while o.length() > 0 && o.ends_with("/") { o = o.slice(0, o.length() - 1) }
      o
    }
    _ => ""
  }
  if origin.length() == 0 || station_id.length() == 0 {
    return Err("station origin or id not ready")
  }
  let rows = match st_db.db.all(
    "SELECT cs.session, cs.shared, cs.write, cs.at, COALESCE(s.title, cs.session) AS title, COALESCE(s.ws, '') AS ws FROM chat_shares cs LEFT JOIN sessions s ON s.key = cs.session",
    [],
  ) {
    Err(e) => return Err("chat_shares query failed: " + e.message)
    Ok(rs) => rs
  }
  let out : Array[XshareHostedChatInfo] = []
  let row_str = fn(r : Map[String, base_codec::Json], k : String) -> String {
    match r.get(k) { Some(base_codec::Json::Str(s)) => s, _ => "" }
  }
  for i in 0..<rows.length() {
    let row = rows[i]
    let sess = row_str(row, "session")
    if sess.length() == 0 { continue }
    let at_ms = match w17e4d_json_i64(row.get("at")) { Some(n) => n, None => 0L }
    let shared_ws = w17e4d_filter_live_shared_workspaces(row_str(row, "shared"), at_ms, now_ms)
    if shared_ws.length() == 0 { continue }
    let wr = match w17e4d_json_i64(row.get("write")) { Some(n) => n != 0L, None => false }
    let title_raw = row_str(row, "title")
    let title = if title_raw.length() > 0 { title_raw } else { sess }
    let row_ws_raw = row_str(row, "ws")
    let row_ws = if row_ws_raw.length() > 0 { row_ws_raw } else { home_ws }
    let link = origin + "/o/" + row_ws + "/" + station_id + "/" + sess
    out.push(XshareHostedChatInfo::{
      chat: sess,
      title: title,
      link: link,
      write: wr,
      workspace: row_ws,
      shared_workspaces: shared_ws,
    })
  }
  Ok(out)
}

/// Inbound `xshare.*` peer RPC outcome distinguishing:
/// - `Reply(json)`: normal `{"result": ...}` response;
/// - `Refused(msg)`: true authorization/policy refusal (`{"error": msg}`, Node treats as `Refused`);
/// - `TransientUnavailable(msg)`: transient store/SQL/IO unavailability — caller closes the stream
///   without an application-level `{"error":...}` so Node `peer.ts:508,551` sees a retryable transport
///   EOF rather than `Refused` and NEVER wipes `borrowed`!
pub enum XsharePeerRpcOutcome {
  Reply(base_codec::Json)
  Refused(String)
  TransientUnavailable(String)
}

/// Live inbound `xshare.*` / outside `describe` peer RPC handler wired into `whole_daemon.pion::on_peer_rpc`.
pub fn w17e4d_handle_xshare_peer_rpc(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  peer_id : String,
  ws : String,
  req : base_codec::Json,
  is_outside : Bool,
) -> XsharePeerRpcOutcome {
  let existing = match w17e4d_read_xshare_state_anchored(ctx.data, ctx.sep) {
    Ok(j) => j
    Err(e) => return XsharePeerRpcOutcome::TransientUnavailable(e)
  }
  let method = match live_json_str_f(req, "method") { Some(s) => s, None => "" }
  let hosted_chats = if method == "xshare.list" {
    match w17e4d_load_hosted_chats_from_store(ctx, st, host_shim::wall_ms()) {
      Ok(cs) => cs
      Err(e) => return XsharePeerRpcOutcome::TransientUnavailable(e)
    }
  } else {
    []
  }
  let ws_name = match ctx.cloud.state {
    Some(cs) if (ws.length() == 0 || ws == cs.workspace) && cs.workspace_name.length() > 0 => cs.workspace_name
    _ => ""
  }
  match w17e4d_handle_xshare_peer_rpc_pure(
    existing,
    peer_id,
    ws,
    st.core.config.home_workspace,
    req,
    is_outside,
    hosted_chats=hosted_chats,
    from_ws_name=ws_name,
  ) {
    Err(e) => XsharePeerRpcOutcome::Refused(e)
    Ok((reply, updated_opt, reconcile_opt)) => {
      if method == "xshare.changed" {
        let here = if ws.length() > 0 { ws } else { st.core.config.home_workspace }
        let hk = here + "/" + peer_id
        let prev = match st.w17e4d.xshare_heard.get(hk) { Some(n) => n, None => 0L }
        st.w17e4d.xshare_heard.set(hk, prev + 1L)
      }
      match updated_opt {
        Some(next_st) => match w17e4d_write_xshare_state_anchored(ctx.data, ctx.sep, next_st) {
          Ok(_) => st.core.api.events.overview_changed("xshare")
          Err(e) => return XsharePeerRpcOutcome::TransientUnavailable(e)
        }
        None => ()
      }
      match reconcile_opt {
        Some((own_ws, host_st, target_ws)) => w17e4d_reconcile_xshare_host(ctx, st, own_ws, host_st, target_ws)
        None => ()
      }
      XsharePeerRpcOutcome::Reply(reply)
    }
  }
}

// ---------------------------------------------------------------------------
// 5. Daemon Event-Loop Dispatch (`on_role_done`, `on_sys_event`, `on_tick`, `on_shutdown`)
// ---------------------------------------------------------------------------

pub fn w17e4d_handle_role_done(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  kind : Int,
  sid : Int64,
  d : host_shim::ShellDone,
) -> Bool {
  // 1. Rollback archive streaming download (`5332` / `5333`)
  if kind == W17E4D_TOK_UPDATE_ARCHIVE_OPEN || kind == W17E4D_TOK_UPDATE_ARCHIVE_READ {
    match st.w17e4d.rollback_job {
      None => {
        if kind == W17E4D_TOK_UPDATE_ARCHIVE_OPEN {
          close_orphaned_async_stream_open(ctx, d)
        }
        return true
      }
      Some(job) => {
        if job.job_id != sid {
          if kind == W17E4D_TOK_UPDATE_ARCHIVE_OPEN {
            close_orphaned_async_stream_open(ctx, d)
          }
          return true
        }
        if kind == W17E4D_TOK_UPDATE_ARCHIVE_OPEN {
          match station_http::decode_stream_open_done(d) {
            Err(e) => {
              fail_rollback_download_job(ctx, st, "release download failed: " + e.message)
              return true
            }
            Ok(head) => {
              job.stream_id = Some(head.id)
              if head.status < 200 || head.status >= 300 {
                fail_rollback_download_job(ctx, st, "release download HTTP " + head.status.to_string())
                return true
              }
              job.stall_deadline_ms = host_shim::now_ms() + W17E4D_ARCHIVE_STALL_MS
              let read_args = base_codec::json_stringify(base_codec::json_obj([
                ("id", base_codec::json_int(head.id)),
                ("stallMs", base_codec::json_int(W17E4D_ARCHIVE_STALL_MS.to_int())),
              ]))
              let _ = ctx.mux_role.call_async_raw(
                builders_core::MuxToken::Tagged(0, W17E4D_TOK_UPDATE_ARCHIVE_READ, job.job_id),
                "stream.read",
                read_args,
                None,
              )
              return true
            }
          }
        }
        match station_http::decode_stream_read_done(d) {
          Err(e) => {
            fail_rollback_download_job(ctx, st, "release download read failed: " + e.message)
            return true
          }
          Ok(chunk) => match chunk {
            station_http::StreamChunk::End => {
              match job.stream_id {
                Some(id) => {
                  let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + id.to_string() + "}", None)
                  job.stream_id = None
                }
                None => ()
              }
              finish_rollback_archive_download(ctx, st, job)
              return true
            }
            station_http::StreamChunk::Data(data) => {
              if data.length() > 0 {
                let next_got = job.got_bytes + data.length().to_int64()
                if next_got > job.build.size {
                  fail_rollback_download_job(ctx, st, "release archive exceeded expected size")
                  return true
                }
                job.hasher.update(data)
                match station_sys::write_at(job.part_path, job.got_bytes, data, job.got_bytes == 0L, None, None, false) {
                  Ok(_) => job.got_bytes = next_got
                  Err(code) => {
                    fail_rollback_download_job(ctx, st, "failed writing rollback archive (code=" + code.to_string() + ")")
                    return true
                  }
                }
              }
              job.stall_deadline_ms = host_shim::now_ms() + W17E4D_ARCHIVE_STALL_MS
              let stream_id = match job.stream_id {
                Some(id) => id
                None => { fail_rollback_download_job(ctx, st, "release stream closed"); return true }
              }
              let read_args = base_codec::json_stringify(base_codec::json_obj([
                ("id", base_codec::json_int(stream_id)),
                ("stallMs", base_codec::json_int(W17E4D_ARCHIVE_STALL_MS.to_int())),
              ]))
              let _ = ctx.mux_role.call_async_raw(
                builders_core::MuxToken::Tagged(0, W17E4D_TOK_UPDATE_ARCHIVE_READ, job.job_id),
                "stream.read",
                read_args,
                None,
              )
              return true
            }
          }
        }
      }
    }
  }

  // 2. Background `copies.restore` S3 streaming fetch (`5334` / `5335`)
  if kind == W17E4D_TOK_RESTORE_S3_OPEN || kind == W17E4D_TOK_RESTORE_S3_READ {
    match st.w17e4d.restore_job {
      None => {
        if kind == W17E4D_TOK_RESTORE_S3_OPEN {
          close_orphaned_async_stream_open(ctx, d)
        }
        return true
      }
      Some(job) => {
        if job.job_id != sid {
          if kind == W17E4D_TOK_RESTORE_S3_OPEN {
            close_orphaned_async_stream_open(ctx, d)
          }
          return true
        }
        if kind == W17E4D_TOK_RESTORE_S3_OPEN {
          match station_http::decode_stream_open_done(d) {
            Err(e) => {
              fail_copies_restore_job(ctx, st, "S3 restore request failed: " + e.message, "offline")
              return true
            }
            Ok(head) => {
              job.stream_id = Some(head.id)
              job.status = head.status
              job.stall_deadline_ms = host_shim::now_ms() + W17E4D_RESTORE_OBJ_STALL_MS
              // For batches, chat attachments, and transcripts on HTTP 2xx, stream-decrypt directly
              // to `<dst>.part` via `Sfb1StreamOpener::push` + `write_at` (zero 64 MiB memory cap!).
              if head.status >= 200 && head.status < 300 {
                match (job.current_item, job.source) {
                  (Some(it), RestoreSourceKind::S3(_, enc_key, _, _)) => {
                    match w17e4d_s3_item_stream_spec(ctx.sep, job.stage_dir, job.gen, it) {
                      Some((logical_path, final_p, expected_hash_opt)) => {
                        match station_replica::Sfb1StreamOpener::new(
                          enc_key,
                          station_replica::Sfb1Context::{ ws: job.ws, origin: job.origin, logical_path: logical_path },
                        ) {
                          Err(e) => {
                            fail_copies_restore_job(ctx, st, "sfb1 init failed: " + e, "error")
                            return true
                          }
                          Ok(opener) => {
                            job.s3_streaming = true
                            job.s3_opener = Some(opener)
                            job.s3_part_path = Some(final_p + ".part")
                            job.s3_final_path = Some(final_p)
                            job.s3_write_offset = 0L
                            job.s3_hasher = match expected_hash_opt {
                              Some(_) => Some(crypto::Sha256::new())
                              None => None
                            }
                          }
                        }
                      }
                      None => ()
                    }
                  }
                  _ => ()
                }
              }
              let read_args = base_codec::json_stringify(base_codec::json_obj([
                ("id", base_codec::json_int(head.id)),
                ("stallMs", base_codec::json_int(W17E4D_RESTORE_OBJ_STALL_MS.to_int())),
              ]))
              let _ = ctx.mux_role.call_async_raw(
                builders_core::MuxToken::Tagged(0, W17E4D_TOK_RESTORE_S3_READ, job.job_id),
                "stream.read",
                read_args,
                None,
              )
              return true
            }
          }
        }
        match station_http::decode_stream_read_done(d) {
          Err(e) => {
            fail_copies_restore_job(ctx, st, "S3 restore read failed: " + e.message, "offline")
            return true
          }
          Ok(chunk) => match chunk {
            station_http::StreamChunk::End => {
              match job.stream_id {
                Some(id) => {
                  let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + id.to_string() + "}", None)
                  job.stream_id = None
                }
                None => ()
              }
              if job.s3_streaming {
                let it = match job.current_item {
                  Some(x) => x
                  None => { fail_copies_restore_job(ctx, st, "restore state machine missing current item", "error"); return true }
                }
                let opener = match job.s3_opener {
                  Some(o) => o
                  None => { fail_copies_restore_job(ctx, st, "missing sfb1 opener on stream end", "error"); return true }
                }
                let part_p = match job.s3_part_path {
                  Some(p) => p
                  None => { fail_copies_restore_job(ctx, st, "missing s3 part path", "error"); return true }
                }
                let final_p = match job.s3_final_path {
                  Some(p) => p
                  None => { fail_copies_restore_job(ctx, st, "missing s3 final path", "error"); return true }
                }
                match opener.finish() {
                  Err(e) => { fail_copies_restore_job(ctx, st, "sfb1 auth tag failed: " + e, "error"); return true }
                  Ok(_) => ()
                }
                if job.s3_write_offset == 0L {
                  match station_sys::write_at(part_p, 0L, Bytes::new(0), true, None, Some(0L), false) {
                    Err(code) => { fail_copies_restore_job(ctx, st, "s3 restore empty write failed (errno " + code.to_string() + ")", "error"); return true }
                    Ok(_) => ()
                  }
                }
                match (it, job.s3_hasher) {
                  (RestoreFetchItem::ChatFile(expected_h), Some(h)) => {
                    if h.finalize_hex() != expected_h {
                      fail_copies_restore_job(ctx, st, "restored file sha256 mismatch for " + expected_h, "error")
                      return true
                    }
                  }
                  _ => ()
                }
                match station_sys::sync_file(part_p) {
                  Err(_) => { fail_copies_restore_job(ctx, st, "s3 restore fsync failed", "error"); return true }
                  Ok(_) => ()
                }
                if !station_sys::rename(part_p, final_p) {
                  fail_copies_restore_job(ctx, st, "s3 restore rename failed", "error")
                  return true
                }
                w17e4d_clear_restore_item_cursors(job)
                job.current_item = None
                w17e4d_bump_restore_done(st, job)
                w17e4d_pump_restore_job(ctx, st, job)
                return true
              }
              let full = live_concat_chunks(job.chunks, job.total_bytes)
              match job.current_item {
                Some(it) => {
                  job.current_item = None
                  w17e4d_handle_restore_item_bytes(ctx, st, job, it, job.status, full, true)
                }
                None => fail_copies_restore_job(ctx, st, "restore state machine missing current item", "error")
              }
              return true
            }
            station_http::StreamChunk::Data(data) => {
              if data.length() > 0 {
                if job.s3_streaming {
                  let opener = match job.s3_opener {
                    Some(o) => o
                    None => { fail_copies_restore_job(ctx, st, "missing sfb1 opener", "error"); return true }
                  }
                  let part_p = match job.s3_part_path {
                    Some(p) => p
                    None => { fail_copies_restore_job(ctx, st, "missing s3 part path", "error"); return true }
                  }
                  let plain_parts = match opener.push(data) {
                    Ok(ps) => ps
                    Err(e) => { fail_copies_restore_job(ctx, st, "sfb1 decrypt failed: " + e, "error"); return true }
                  }
                  for pi in 0..<plain_parts.length() {
                    let pt = plain_parts[pi]
                    if pt.length() == 0 { continue }
                    match station_sys::write_at(part_p, job.s3_write_offset, pt, job.s3_write_offset == 0L, None, None, false) {
                      Err(code) => { fail_copies_restore_job(ctx, st, "s3 restore write_at failed (errno " + code.to_string() + ")", "error"); return true }
                      Ok(_) => ()
                    }
                    match job.s3_hasher {
                      Some(h) => h.update(pt)
                      None => ()
                    }
                    job.s3_write_offset = job.s3_write_offset + pt.length().to_int64()
                  }
                } else {
                  if job.total_bytes + data.length() > W17E4D_RESTORE_SMALL_JSON_CAP {
                    fail_copies_restore_job(ctx, st, "S3 restore metadata JSON exceeded 16 MiB cap", "error")
                    return true
                  }
                  job.chunks.push(data)
                  job.total_bytes = job.total_bytes + data.length()
                }
              }
              job.stall_deadline_ms = host_shim::now_ms() + W17E4D_RESTORE_OBJ_STALL_MS
              let stream_id = match job.stream_id {
                Some(id) => id
                None => { fail_copies_restore_job(ctx, st, "S3 restore stream closed", "offline"); return true }
              }
              let read_args = base_codec::json_stringify(base_codec::json_obj([
                ("id", base_codec::json_int(stream_id)),
                ("stallMs", base_codec::json_int(W17E4D_RESTORE_OBJ_STALL_MS.to_int())),
              ]))
              let _ = ctx.mux_role.call_async_raw(
                builders_core::MuxToken::Tagged(0, W17E4D_TOK_RESTORE_S3_READ, job.job_id),
                "stream.read",
                read_args,
                None,
              )
              return true
            }
          }
        }
      }
    }
  }

  // 3. Signed included-changes manifest fetch (`5336` / `5337`)
  if kind == W17E4D_TOK_INCLUDED_OPEN || kind == W17E4D_TOK_INCLUDED_READ {
    match st.w17e4d.included_job {
      None => {
        if kind == W17E4D_TOK_INCLUDED_OPEN { close_orphaned_async_stream_open(ctx, d) }
        return true
      }
      Some(job) => {
        if job.job_id != sid {
          if kind == W17E4D_TOK_INCLUDED_OPEN { close_orphaned_async_stream_open(ctx, d) }
          return true
        }
        if kind == W17E4D_TOK_INCLUDED_OPEN {
          match station_http::decode_stream_open_done(d) {
            Err(_) => { st.w17e4d.included_job = None; return true }
            Ok(head) => {
              job.stream_id = Some(head.id)
              job.status = head.status
              if head.status < 200 || head.status >= 300 {
                let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + head.id.to_string() + "}", None)
                st.w17e4d.included_job = None
                return true
              }
              let read_args = base_codec::json_stringify(base_codec::json_obj([
                ("id", base_codec::json_int(head.id)),
                ("stallMs", base_codec::json_int(15000)),
              ]))
              let _ = ctx.mux_role.call_async_raw(
                builders_core::MuxToken::Tagged(0, W17E4D_TOK_INCLUDED_READ, job.job_id),
                "stream.read",
                read_args,
                None,
              )
              return true
            }
          }
        }
        match station_http::decode_stream_read_done(d) {
          Err(_) => {
            match job.stream_id {
              Some(id) => { let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + id.to_string() + "}", None) }
              None => ()
            }
            st.w17e4d.included_job = None
            return true
          }
          Ok(chunk) => match chunk {
            station_http::StreamChunk::End => {
              match job.stream_id {
                Some(id) => { let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + id.to_string() + "}", None) }
                None => ()
              }
              let full = live_concat_chunks(job.chunks, job.total_bytes)
              st.w17e4d.included_job = None
              if full.length().to_int64() == job.expected_size && crypto::sha256_hex(full) == job.expected_sha256 {
                match base_codec::json_parse(full.to_string()) {
                  base_codec::JsonParseResult::Ok(j) => {
                    match w17e4d_parse_release_included(j) {
                      Some(inc) => {
                        st.w17e4d.last_included = Some((job.req_ch, job.base_url, job.release.version, job.inc_file, job.expected_sha256, inc))
                        w17e4d_reconcile_wait_and_auto(ctx, st, None)
                      }
                      None => ()
                    }
                  }
                  _ => ()
                }
              }
              return true
            }
            station_http::StreamChunk::Data(data) => {
              if job.total_bytes + data.length() > 4194304 {
                match job.stream_id {
                  Some(id) => { let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + id.to_string() + "}", None) }
                  None => ()
                }
                st.w17e4d.included_job = None
                return true
              }
              job.chunks.push(data)
              job.total_bytes = job.total_bytes + data.length()
              let stream_id = match job.stream_id { Some(id) => id, None => { st.w17e4d.included_job = None; return true } }
              let read_args = base_codec::json_stringify(base_codec::json_obj([
                ("id", base_codec::json_int(stream_id)),
                ("stallMs", base_codec::json_int(15000)),
              ]))
              let _ = ctx.mux_role.call_async_raw(
                builders_core::MuxToken::Tagged(0, W17E4D_TOK_INCLUDED_READ, job.job_id),
                "stream.read",
                read_args,
                None,
              )
              return true
            }
          }
        }
      }
    }
  }

  // 4. Background wait-rule feed check (`5338` / `5339`)
  if kind == W17E4D_TOK_WAIT_FEED_OPEN || kind == W17E4D_TOK_WAIT_FEED_READ {
    match st.w17e4d.wait_feed_job {
      None => {
        if kind == W17E4D_TOK_WAIT_FEED_OPEN { close_orphaned_async_stream_open(ctx, d) }
        return true
      }
      Some(job) => {
        if job.job_id != sid {
          if kind == W17E4D_TOK_WAIT_FEED_OPEN { close_orphaned_async_stream_open(ctx, d) }
          return true
        }
        if kind == W17E4D_TOK_WAIT_FEED_OPEN {
          match station_http::decode_stream_open_done(d) {
            Err(_) => { st.w17e4d.wait_feed_job = None; return true }
            Ok(head) => {
              job.stream_id = Some(head.id)
              job.status = head.status
              if head.status < 200 || head.status >= 300 {
                let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + head.id.to_string() + "}", None)
                st.w17e4d.wait_feed_job = None
                return true
              }
              let read_args = base_codec::json_stringify(base_codec::json_obj([
                ("id", base_codec::json_int(head.id)),
                ("stallMs", base_codec::json_int(15000)),
              ]))
              let _ = ctx.mux_role.call_async_raw(
                builders_core::MuxToken::Tagged(0, W17E4D_TOK_WAIT_FEED_READ, job.job_id),
                "stream.read",
                read_args,
                None,
              )
              return true
            }
          }
        }
        match station_http::decode_stream_read_done(d) {
          Err(_) => {
            match job.stream_id {
              Some(id) => { let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + id.to_string() + "}", None) }
              None => ()
            }
            st.w17e4d.wait_feed_job = None
            return true
          }
          Ok(chunk) => match chunk {
            station_http::StreamChunk::End => {
              match job.stream_id {
                Some(id) => { let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + id.to_string() + "}", None) }
                None => ()
              }
              let full = live_concat_chunks(job.chunks, job.total_bytes)
              let req_ch = job.req_ch
              let base_u = job.base_url
              st.w17e4d.wait_feed_job = None
              let cur_ch = resolve_station_update_channel(ctx.config_file.raw(), ctx.ops_fs, ctx.args.app, ctx.sep)
              let cur_base = w17e4d_release_base_url(station_sys::env_get("STILLFAIL_RELEASE_URL"), ctx.cloud.state)
              if w17e4d_feed_reply_matches_current(req_ch, base_u, cur_ch, cur_base) {
                match base_codec::json_parse(full.to_string()) {
                  base_codec::JsonParseResult::Ok(feed_j) => {
                    match station_cli::verify_feed(feed_j, live_trusted_release_keys(), verify_fn=st.core.api.auth_policy.verify_fn) {
                      Ok(rel) => {
                        st.core.updates.station.checked_channel = Some(req_ch)
                        st.core.updates.station.latest = Some(rel.version)
                        let cur_v = match st.core.updates.station.version { Some(v) => v, None => "" }
                        st.core.updates.station.updatable = live_version_newer(cur_v, rel.version)
                        st.core.updates.station.failed_text = None
                        st.core.api.events.overview_changed("updates")
                        w17e4d_reconcile_wait_and_auto(ctx, st, Some((req_ch, base_u, rel)))
                      }
                      Err(_) => ()
                    }
                  }
                  _ => ()
                }
              }
              return true
            }
            station_http::StreamChunk::Data(data) => {
              if job.total_bytes + data.length() > 262144 {
                match job.stream_id {
                  Some(id) => { let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + id.to_string() + "}", None) }
                  None => ()
                }
                st.w17e4d.wait_feed_job = None
                return true
              }
              job.chunks.push(data)
              job.total_bytes = job.total_bytes + data.length()
              let stream_id = match job.stream_id { Some(id) => id, None => { st.w17e4d.wait_feed_job = None; return true } }
              let read_args = base_codec::json_stringify(base_codec::json_obj([
                ("id", base_codec::json_int(stream_id)),
                ("stallMs", base_codec::json_int(15000)),
              ]))
              let _ = ctx.mux_role.call_async_raw(
                builders_core::MuxToken::Tagged(0, W17E4D_TOK_WAIT_FEED_READ, job.job_id),
                "stream.read",
                read_args,
                None,
              )
              return true
            }
          }
        }
      }
    }
  }

  false
}

/// Handle `station_sys` events in `[UPDATES_RESTORE_EVENT_BASE, UPDATES_RESTORE_EVENT_END)`.
/// Only closes the outer detached-launch wrapper handle once it returns (the installer itself runs detached!).
pub fn w17e4d_handle_sys_event(
  _ctx : DaemonCtx,
  st : WholeRuntimeState,
  ev_id : Int64,
  sev : station_sys::SysEvent,
) -> Bool {
  if ev_id < UPDATES_RESTORE_EVENT_BASE || ev_id >= UPDATES_RESTORE_EVENT_END {
    return false
  }
  if st.w17e4d.launcher_wrapper_ev_id == ev_id {
    match sev {
      station_sys::SysEvent::ProcExit(_) => {
        match st.w17e4d.launcher_wrapper_proc {
          Some(p) => { let _ = p.close(); st.w17e4d.launcher_wrapper_proc = None }
          None => ()
        }
        st.w17e4d.launcher_wrapper_ev_id = 0L
      }
      _ => ()
    }
    return true
  }
  true
}

/// Periodic tick:
/// - Poll `run/update.exit` while following a detached installer (throttled 500ms, NEVER kill detached installer!).
/// - Periodically drive `updates.wait` / auto-update coordinator when configured (`W17E4D_UPDATE_POLL_INTERVAL_MS`).
/// - Enforce per-object stall deadlines on rollback download, S3 restore, included/wait fetches.
/// - Step chunked `LocalKept` restore within bounded per-tick I/O budget.
/// - Drive exponential-backoff retries for transient `xshare` reconcile failures.
pub fn w17e4d_tick(ctx : DaemonCtx, st : WholeRuntimeState, now_ms : Int64) -> Unit {
  w17e4d_poll_update_follow(ctx, st, now_ms)
  if st.w17e4d.next_update_poll_ms > 0L && now_ms >= st.w17e4d.next_update_poll_ms {
    st.w17e4d.next_update_poll_ms = now_ms + W17E4D_UPDATE_POLL_INTERVAL_MS
    let raw_cfg = ctx.config_file.raw()
    let wants_poll = station_cli::parse_auto_update_when(raw_cfg).is_some()
    || live_json_bool_f(raw_cfg, "autoUpdate") == Some(true)
    || live_json_str_f(raw_cfg, "autoUpdateAfter").is_some()
    if wants_poll {
      w17e4d_trigger_wait_feed_check(ctx, st, true)
    }
  }
  if st.w17e4d.xshare_retry_at_ms > 0L && now_ms >= st.w17e4d.xshare_retry_at_ms {
    st.w17e4d.xshare_retry_at_ms = 0L
    let pending : Array[(String, String, String)] = []
    for i in 0..<st.w17e4d.xshare_retry_queue.length() {
      pending.push(st.w17e4d.xshare_retry_queue[i])
    }
    st.w17e4d.xshare_retry_queue.clear()
    for i in 0..<pending.length() {
      w17e4d_reconcile_xshare_host(ctx, st, pending[i].0, pending[i].1, pending[i].2)
    }
  }
  match st.w17e4d.rollback_job {
    Some(job) if now_ms >= job.stall_deadline_ms => {
      fail_rollback_download_job(ctx, st, "rollback archive download stalled")
    }
    _ => ()
  }
  match st.w17e4d.included_job {
    Some(job) if now_ms >= job.deadline_ms => {
      match job.stream_id {
        Some(id) => { let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + id.to_string() + "}", None) }
        None => ()
      }
      st.w17e4d.included_job = None
    }
    _ => ()
  }
  match st.w17e4d.wait_feed_job {
    Some(job) if now_ms >= job.deadline_ms => {
      match job.stream_id {
        Some(id) => { let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + id.to_string() + "}", None) }
        None => ()
      }
      st.w17e4d.wait_feed_job = None
    }
    _ => ()
  }
  match st.w17e4d.restore_job {
    Some(job) => match job.source {
      RestoreSourceKind::LocalKept(_) => {
        w17e4d_step_local_kept_tick(ctx, st, job)
      }
      _ => {
        if now_ms >= job.stall_deadline_ms {
          fail_copies_restore_job(ctx, st, "backup restore object stalled", "offline")
        }
      }
    }
    None => ()
  }
}

/// Shutdown cleanup:
/// - NEVER kills a detached station installer (`launcher_wrapper_proc` is only detached/closed, NEVER signaled)!
/// - Closes in-flight HTTP download streams and deletes incomplete staging directories.
pub fn w17e4d_shutdown(ctx : DaemonCtx, st : WholeRuntimeState) -> Unit {
  match st.w17e4d.launcher_wrapper_proc {
    Some(p) => {
      let _ = p.close()
      st.w17e4d.launcher_wrapper_proc = None
    }
    None => ()
  }
  match st.w17e4d.rollback_job {
    Some(_) => fail_rollback_download_job(ctx, st, "station shutting down")
    None => ()
  }
  match st.w17e4d.included_job {
    Some(job) => {
      match job.stream_id {
        Some(id) => { let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + id.to_string() + "}", None) }
        None => ()
      }
      st.w17e4d.included_job = None
    }
    None => ()
  }
  match st.w17e4d.wait_feed_job {
    Some(job) => {
      match job.stream_id {
        Some(id) => { let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + id.to_string() + "}", None) }
        None => ()
      }
      st.w17e4d.wait_feed_job = None
    }
    None => ()
  }
  match st.w17e4d.restore_job {
    Some(_) => fail_copies_restore_job(ctx, st, "station shutting down", "error")
    None => ()
  }
}
