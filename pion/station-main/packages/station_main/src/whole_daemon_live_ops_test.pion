// Wave 17D-2 R3 daemon-level unit tests for `whole_daemon_live_ops.pion` & R3 P0/P1 invariants:
// 1. `workspaces.join` two-phase contract: URL MUST be `/v1/stations/join` (NEVER `/enroll`), body MUST include
//    `"locks":true`, pre-checks run BEFORE network I/O, and `apply_join_workspace_response` preserves existing home workspace!
// 2. Late `stream.open` after disconnect/timeout/shutdown: `close_orphaned_async_stream_open_with` decodes `head.id`
//    and invokes `stream.close` so Rust handles never leak!
// 3. `AdminApi` async idempotency claim/conflict/replay/abort lifecycle.
// 4. Read-only `login_view_to_json` uses `login_limited` (strips `url`, `code`, and raw CLI `error` tail).
// 5. `LoginsManager::start_isolated` & `PeerAuthPolicy::add_workspace` & controlled S3/join error messages.

import "base64"
import "base_codec"
import "host_shim"
import "http1"
import "station_api"
import "station_cloud"
import "station_devices"
import "station_drivers"
import "station_http"
import "station_ops"
import "station_whole"

test "wave17d2 r3: workspaces.join prepares /v1/stations/join with locks:true and preserves original workspace" {
  let mem = station_cloud::MemCloudFs::new()
  let cfs = mem.as_fs()
  let data = "/tmp/w17d2-join-test"
  let seed = Bytes::new(32)
  for i in 0..<32 {
    seed[i] = (i + 7).to_byte()
  }
  let key = match station_cloud::StationKey::from_seed(seed) {
    Ok(k) => k
    Err(e) => panic("StationKey::from_seed failed: " + e)
  }
  let initial_state = "{\"origin\":\"https://api.still.fail\",\"workspace\":\"ws-home-orig\",\"workspaceName\":\"Home WS\",\"name\":\"My Box\",\"peers\":[],\"joined\":[]}"
  mem.files.set(station_cloud::state_path(data), initial_state)

  // Phase 1: prepare_join_workspace MUST hit `/v1/stations/join` (NEVER `/enroll`) and include `"locks":true`!
  let prep = match station_cloud::prepare_join_workspace(data, cfs, key, "tok_join_123", "0.1.9999", 1700000000L) {
    Ok(p) => p
    Err(e) => panic("prepare_join_workspace failed: " + e)
  }
  if prep.url != "https://api.still.fail/v1/stations/join" {
    panic("join URL MUST be /v1/stations/join, got: " + prep.url)
  }
  if prep.bodies.length() == 0 || !prep.bodies[0].contains("\"locks\":true") || !prep.bodies[0].contains("\"token\":\"tok_join_123\"") {
    panic("join body missing locks:true or token: " + prep.bodies[0])
  }

  // Phase 2: apply_join_workspace_response adds ws-second while PRESERVING ws-home-orig!
  let resp_json = "{\"workspace\":\"ws-second\",\"workspace_name\":\"Second WS\",\"name\":\"My Box\"}"
  match station_cloud::apply_join_workspace_response(data, cfs, prep, 200, resp_json, 1700000001L) {
    Ok(jr) => {
      if jr.workspace != "ws-second" || jr.became_home {
        panic("unexpected join result")
      }
    }
    Err(e) => panic("apply_join_workspace_response failed: " + e)
  }
  match station_cloud::read_state(data, cfs) {
    Ok(Some(st)) => {
      if st.workspace != "ws-home-orig" {
        panic("original home workspace was overwritten! got: " + st.workspace)
      }
      let mut has_second = false
      for i in 0..<st.joined.length() {
        if st.joined[i].workspace == "ws-second" {
          has_second = true
        }
      }
      if !has_second {
        panic("ws-second missing from joined list")
      }
    }
    _ => panic("failed to read updated cloud state")
  }
}

test "wave17d2 r3: late stream.open after timeout/disconnect closes orphaned stream handle" {
  let done_ok = host_shim::ShellDone::{
    id: 99L,
    error: "",
    json: "{\"id\":42,\"status\":200,\"headers\":[]}",
    bytes: None,
  }
  let closed : Array[Int] = []
  let got = close_orphaned_async_stream_open_with(done_ok, fn(id : Int) -> Unit { closed.push(id) })
  if got != Some(42) || closed.length() != 1 || closed[0] != 42 {
    panic("late stream.open MUST decode stream id 42 and call stream.close!")
  }
}

test "wave17d2 r3: AdminApi async idempotency claim, in-flight 409 conflict, and replay" {
  let host = station_api::ApiHost::stub()
  let seen = station_api::SeenStore::empty()
  let admin = station_api::AdminApi::new(host, seen, "9999")
  let viewer = station_api::Viewer::owner("alice@example.com", "ws-1")
  let hdrs = [http1::Header::{ name: "Idempotency-Key", value: "idem-async-1" }]

  // 1. First claim succeeds
  let (sk, ik) = match admin.claim_async_idempotency(viewer, "POST", "/profiles", hdrs, 1000L) {
    station_api::AsyncIdemClaim::Claimed(s, k) => (s, k)
    _ => panic("expected Claimed")
  }
  // 2. Concurrent duplicate while in-flight -> 409 Conflict
  match admin.claim_async_idempotency(viewer, "POST", "/profiles", hdrs, 1001L) {
    station_api::AsyncIdemClaim::Conflict(r) => if r.status != 409 { panic("expected 409 conflict") }
    _ => panic("expected Conflict while in-flight")
  }
  // 3. Complete with 200 -> subsequent retry gets Replay(200)
  admin.complete_async_idempotency(sk, ik, viewer, "POST", "/profiles", station_api::json_ok(base_codec::json_obj([("id", base_codec::json_str("openai"))])), 1002L)
  match admin.claim_async_idempotency(viewer, "POST", "/profiles", hdrs, 1003L) {
    station_api::AsyncIdemClaim::Replay(r) => if r.status != 200 || !r.body.to_string().contains("\"openai\"") { panic("expected cached 200 replay") }
    _ => panic("expected Replay after completion")
  }
}

test "wave17d2 r3: read-only login_view_to_json uses login_limited to strip url, code, and raw CLI error" {
  let view = station_devices::LoginView::{
    id: "plogin-1",
    name: "claude",
    command: ["claude", "auth", "login"],
    state: station_devices::LoginState::Failed,
    step: Some(station_devices::LoginStep::Open),
    url: Some("https://claude.ai/oauth?secret=xyz"),
    domain: Some("claude.ai"),
    callback: None,
    code: Some("ABCD-9999"),
    code_url: Some("https://claude.ai/device"),
    waiting: false,
    paste: false,
    by: station_devices::LoginPerson::{ email: "a@example.com", name: "A" },
    workspace: Some("ws-1"),
    chat: None,
    chat_title: None,
    done_by: None,
    started_at: 1000L,
    expires_at: 2000L,
    ended_at: Some(1500L),
    error: Some("visit https://claude.ai/oauth?secret=xyz and enter ABCD-9999"),
    timed_out: false,
    browser: true,
    screen: Some("scr-1"),
    again: None,
    from: None,
    by_code: false,
  }
  let ro_json = base_codec::json_stringify(login_view_to_json(view, true))
  if ro_json.contains("secret=xyz") || ro_json.contains("ABCD-9999") || ro_json.contains("127.0.0.1:9999") {
    panic("read-only login_view_to_json leaked url/code/error: " + ro_json)
  }
}

test "wave17d2 r3: live_current_platform, start_isolated, PeerAuthPolicy::add_workspace, and controlled errors" {
  if live_current_platform("linux", "aarch64") != "linux-arm64" || live_current_platform("linux", "x86_64") != "linux-x64" {
    panic("live_current_platform mismatch")
  }
  let lm = station_devices::LoginsManager::new(None)
  let s1 = station_devices::LoginStarter::{ workspace: Some("ws-a"), by: station_devices::LoginPerson::{ email: "a@example.com", name: "A" }, chat: None, chat_title: None }
  let s2 = station_devices::LoginStarter::{ workspace: Some("ws-b"), by: station_devices::LoginPerson::{ email: "b@example.com", name: "B" }, chat: None, chat_title: None }
  let r1 = match lm.start_isolated("claude auth login", s1, None, false, 1000L) { Ok(v) => v, Err(e) => panic(e.message) }
  let r2 = match lm.start_isolated("claude auth login", s2, None, false, 1000L) { Ok(v) => v, Err(e) => panic(e.message) }
  if r1.id == r2.id {
    panic("isolated profile logins must not collide")
  }
  let pol = station_whole::PeerAuthPolicy::{ station_id: "st-1", station_build: "9999", home_workspace: "ws-home", allowed_workspaces: ["ws-home"], verify_fn: None }
  pol.add_workspace("ws-joined")
  pol.add_workspace("ws-joined")
  if pol.allowed_workspaces.length() != 2 {
    panic("expected 2 workspaces after idempotent add_workspace")
  }
  if controlled_s3_error_message(403).contains("<Error>") || controlled_join_error_message(401).length() == 0 {
    panic("controlled error check failed")
  }
}

test "wave17d2 r4: profile logins manager is completely isolated from machine logins manager" {
  let machine_logins = station_devices::LoginsManager::new(None)
  let profile_logins = station_devices::LoginsManager::new(None)
  let starter = station_devices::LoginStarter::{
    workspace: Some("ws-secret"),
    by: station_devices::LoginPerson::{ email: "alice@example.com", name: "Alice" },
    chat: None,
    chat_title: None,
  }
  let prof_view = match profile_logins.start_isolated("claude auth login", starter, None, false, 1000L) {
    Ok(v) => v
    Err(e) => panic("profile start_isolated failed: " + e.message)
  }
  // `/machine-logins` list MUST remain completely empty and MUST NOT see or cancel profile login IDs!
  if machine_logins.list().length() != 0 {
    panic("machine_logins MUST NOT expose profile logins")
  }
  if machine_logins.get(prof_view.id).is_some() {
    panic("machine_logins MUST NOT find profile login by id")
  }
  if profile_logins.get(prof_view.id).is_none() {
    panic("profile_logins should track its own login")
  }
}

test "wave17d2 r4: updates.check feed URL uses station_cli::feed_url, live_version_newer, and executable probe" {
  let mem = station_cloud::MemCloudFs::new()
  let cfs = mem.as_fs()
  mem.files.set(station_cloud::state_path("/tmp/w17d2-feed"), "{\"origin\":\"https://api.still.fail\",\"workspace\":\"ws-1\",\"name\":\"Box\",\"peers\":[],\"joined\":[]}")
  let st_opt = match station_cloud::read_state("/tmp/w17d2-feed", cfs) {
    Ok(s) => s
    Err(e) => panic("read_state failed: " + e)
  }
  let stable_u = live_release_feed_url_for(None, st_opt, "stable")
  let beta_u = live_release_feed_url_for(None, st_opt, "beta")
  if stable_u != Some("https://api.still.fail/releases/station.json") {
    panic("unexpected stable feed URL: " + match stable_u { Some(s) => s, None => "none" })
  }
  if beta_u != Some("https://api.still.fail/releases/station-beta.json") {
    panic("unexpected beta feed URL: " + match beta_u { Some(s) => s, None => "none" })
  }
  if !live_version_newer("0.1.9", "0.1.10") || live_version_newer("0.1.10", "0.1.9") || live_version_newer("0.1.10", "0.1.10") || live_version_newer("", "0.1.10") || live_version_newer("0.1.10", "") {
    panic("live_version_newer parity check failed")
  }
  // Executable probe rejects directories and non-executable files (0644), accepts 0755 files
  let mfs = station_ops::MemFs::new()
  let _ = mfs.put_text("/bin/not-exec", "hi", 420) // 0644
  let _ = mfs.put_text("/bin/is-exec", "#!/bin/sh", 493) // 0755
  let _ = (mfs.ops().mkdir_p)("/bin/a-dir")
  if live_is_executable_file(mfs.ops(), "/bin/not-exec", "/") {
    panic("0644 file must not be treated as executable")
  }
  if live_is_executable_file(mfs.ops(), "/bin/a-dir", "/") {
    panic("directory must not be treated as executable")
  }
  if !live_is_executable_file(mfs.ops(), "/bin/is-exec", "/") {
    panic("0755 file should be executable")
  }
  // `<app>/BUILD` + `<app>/CHANNEL` resolution (`station/src/updates/versions.ts:48-69`)
  let _ = mfs.put_text("/app/BUILD", "11999\n", 420)
  let _ = mfs.put_text("/app/CHANNEL", "beta\n", 420)
  let cur_ver = match station_ops::station_version(mfs.ops(), "/app", sep="/") {
    Some(v) => v
    None => panic("expected 0.1.11999 from /app/BUILD")
  }
  if cur_ver != "0.1.11999" || !live_version_newer(cur_ver, "0.1.12005") || live_version_newer(cur_ver, "0.1.11998") {
    panic("installed version newer() check failed for " + cur_ver)
  }
  // When config.updateChannel is absent, resolve_station_update_channel falls back to `<app>/CHANNEL` ("beta")
  let ch_from_app = resolve_station_update_channel(base_codec::json_obj([]), mfs.ops(), Some("/app"), "/")
  if ch_from_app != "beta" {
    panic("expected beta from /app/CHANNEL, got " + ch_from_app)
  }
  // Explicit config.updateChannel overrides `<app>/CHANNEL`
  let ch_from_cfg = resolve_station_update_channel(base_codec::json_obj([("updateChannel", base_codec::json_str("stable"))]), mfs.ops(), Some("/app"), "/")
  if ch_from_cfg != "stable" {
    panic("expected stable from config.updateChannel, got " + ch_from_cfg)
  }
}

test "wave17d2 r4: downgraded member rejected before idempotency replay" {
  let host = station_api::ApiHost::stub()
  let seen = station_api::SeenStore::empty()
  let admin = station_api::AdminApi::new(host, seen, "9999")
  let owner = station_api::Viewer::owner("alice@example.com", "ws-1")
  let downgraded_member = station_api::Viewer::member("alice@example.com", "ws-1")
  let hdrs = [http1::Header::{ name: "Idempotency-Key", value: "idem-downgrade-1" }]

  // Owner caches a 200 admin response
  match admin.claim_async_idempotency(owner, "POST", "/profiles", hdrs, 1000L) {
    station_api::AsyncIdemClaim::Claimed(sk, ik) => {
      admin.complete_async_idempotency(sk, ik, owner, "POST", "/profiles", station_api::json_ok(base_codec::json_obj([("id", base_codec::json_str("openai"))])), 1001L)
    }
    _ => panic("expected Claimed")
  }
  // Authorization check MUST run before claim_async_idempotency: downgraded member is NOT a manager!
  if downgraded_member.manages_station() {
    panic("downgraded member must not manage station")
  }
  if !owner.manages_station() {
    panic("owner must manage station")
  }
}

test "wave17d2 r6: updates.check binds beta channel without updateChannel and drops stale cross-channel completion" {
  let mfs = station_ops::MemFs::new()
  let _ = mfs.put_text("/app/BUILD", "11999\n", 420)
  let _ = mfs.put_text("/app/CHANNEL", "beta\n", 420)
  let raw_cfg = base_codec::json_obj([]) // no explicit `updateChannel`
  let cur_ch = resolve_station_update_channel(raw_cfg, mfs.ops(), Some("/app"), "/")
  if cur_ch != "beta" {
    panic("expected resolved channel beta, got " + cur_ch)
  }

  let updates = station_drivers::RuntimeUpdatesManager::new()
  updates.station.version = station_ops::station_version(mfs.ops(), "/app", sep="/")

  // Valid signed beta release feed (verified with test verifier)
  let trusted : Map[String, String] = Map::new()
  trusted.set("test-key", "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=")
  let always_ok : Option[(String, Bytes, Bytes, Bytes) -> Bool] = Some(fn(_k : String, _p : Bytes, _m : Bytes, _s : Bytes) -> Bool { true })
  let make_signed_feed = fn(ver : String, bld : Int) -> String {
    let words = "{\"kind\":\"stillfail-station-release\",\"version\":\"" + ver + "\",\"build\":" + bld.to_string() + ",\"builds\":{}}"
    let rel_b64 = base64::encode(words.to_bytes())
    "{\"version\":\"" + ver + "\",\"release\":\"" + rel_b64 + "\",\"key\":\"test-key\",\"signature\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\"}"
  }
  let beta_feed = make_signed_feed("0.1.12050", 12050)
  let applied_beta = apply_updates_check_result(
    updates,
    "beta",
    cur_ch,
    Ok((200, beta_feed.to_bytes())),
    trusted,
    always_ok,
  )
  if !applied_beta {
    panic("matching beta updates.check result should be applied")
  }
  let view = station_whole::updates_view_json(updates, raw_cfg, resolved_channel=Some(cur_ch))
  let view_s = base_codec::json_stringify(view)
  if !view_s.contains("\"channel\":\"beta\"") || !view_s.contains("\"version\":\"0.1.11999\"") || !view_s.contains("\"latest\":\"0.1.12050\"") || !view_s.contains("\"newer\":true") {
    panic("beta updates.check view inconsistent: " + view_s)
  }

  // Late/stale completion for `"stable"` after channel switched to `"beta"` MUST be discarded!
  let stale_feed = make_signed_feed("0.1.11900", 11900)
  let applied_stale = apply_updates_check_result(
    updates,
    "stable",
    "beta",
    Ok((200, stale_feed.to_bytes())),
    trusted,
    always_ok,
  )
  if applied_stale {
    panic("stale cross-channel completion must be discarded")
  }
  if updates.station.latest != Some("0.1.12050") || !updates.station.updatable || updates.station.failed_text.is_some() {
    panic("stale cross-channel completion corrupted updates.station state")
  }

  // Stale cross-channel error MUST also NOT overwrite current channel state!
  let applied_stale_err = apply_updates_check_result(
    updates,
    "stable",
    "beta",
    Err("network timeout"),
    trusted,
    always_ok,
  )
  if applied_stale_err || updates.station.latest != Some("0.1.12050") || updates.station.failed_text.is_some() {
    panic("stale cross-channel error must not clear or overwrite active channel state")
  }

  // R7 P1: Switch channel from `beta` to `stable` (with no `stable` check run yet):
  // a late `beta` completion is discarded, AND `updates_view_json(..., resolved_channel=Some("stable"))`
  // MUST mask the cached `beta` `latest`/`newer`/`failed` so it never leaks under `"channel":"stable"`!
  let late_beta_applied = apply_updates_check_result(
    updates,
    "beta",
    "stable",
    Ok((200, make_signed_feed("0.1.12099", 12099).to_bytes())),
    trusted,
    always_ok,
  )
  if late_beta_applied {
    panic("late beta completion after switching to stable must be discarded")
  }
  let stable_cfg = base_codec::json_obj([("updateChannel", base_codec::json_str("stable"))])
  let stable_view_s = base_codec::json_stringify(station_whole::updates_view_json(updates, stable_cfg, resolved_channel=Some("stable")))
  if !stable_view_s.contains("\"channel\":\"stable\"") ||
  !stable_view_s.contains("\"newer\":false") ||
  !stable_view_s.contains("\"state\":\"idle\"") ||
  stable_view_s.contains("\"latest\":") ||
  stable_view_s.contains("\"message\":") {
    panic("stable view leaked cached beta check state: " + stable_view_s)
  }
}

test "wave17e4b: durable join constants, CloudStore::reload, PeerAuthPolicy::set_home_workspace, and disconnect detach" {
  // Verify pre-allocated disjoint event & MuxToken::Tagged ranges
  if PROJECTS_WS_EVENT_BASE != 55834574848L || PROJECTS_WS_EVENT_END != 60129542144L {
    panic("PROJECTS_WS_EVENT_BASE/END mismatch")
  }
  if JOIN_TOK_HTTP_OPEN < 5310 || JOIN_TOK_HTTP_OPEN > 5319 || JOIN_TOK_HTTP_READ < 5310 || JOIN_TOK_HTTP_READ > 5319 {
    panic("JOIN_TOK_HTTP_OPEN/READ outside allocated 5310..5319 range")
  }
  // Verify CloudStore::reload picks up newly joined workspace written to cloud.json
  let mem = station_cloud::MemCloudFs::new()
  let cfs = mem.as_fs()
  let data = "/tmp/w17e4b-reload-test"
  mem.files.set(station_cloud::state_path(data), "{\"origin\":\"https://api.still.fail\",\"workspace\":\"ws-home\",\"workspaceName\":\"Home\",\"name\":\"Box\",\"peers\":[],\"joined\":[]}")
  let cs = station_cloud::CloudStore::open(data, cfs)
  if cs.memberships(1700000000.0).length() != 1 {
    panic("expected 1 membership before join")
  }
  let seed = Bytes::new(32)
  for i in 0..<32 {
    seed[i] = (i + 13).to_byte()
  }
  let key = match station_cloud::StationKey::from_seed(seed) { Ok(k) => k, Err(e) => panic(e) }
  let prep = match station_cloud::prepare_join_workspace(data, cfs, key, "tok_dur_1", "0.1.9999", 1700000000L, store=Some(cs)) {
    Ok(p) => p
    Err(e) => panic("prepare_join_workspace failed: " + e)
  }
  let _ = match station_cloud::apply_join_workspace_response(
    data,
    cfs,
    prep,
    200,
    "{\"workspace\":\"ws-new\",\"workspace_name\":\"New WS\",\"name\":\"Box\"}",
    1700000001L,
  ) {
    Ok(jr) => jr
    Err(e) => panic("apply_join_workspace_response failed: " + e)
  }
  if !cs.reload() {
    panic("CloudStore::reload returned false")
  }
  if cs.memberships(1700000001.0).length() != 2 {
    panic("expected 2 memberships after reload")
  }
  // Verify PeerAuthPolicy::set_home_workspace promotes home and adds to allowed_workspaces
  let pol = station_whole::PeerAuthPolicy::{
    station_id: "st-1",
    station_build: "9999",
    home_workspace: "ws-home",
    allowed_workspaces: ["ws-home"],
    verify_fn: None,
  }
  pol.set_home_workspace("ws-new")
  if pol.home_workspace != "ws-new" || pol.allowed_workspaces.length() != 2 {
    panic("PeerAuthPolicy::set_home_workspace failed")
  }
  // Verify DurableJoinTx detaching waiter_sid preserves tx state and idem_claim (disconnect/timeout resilience)
  let tx = DurableJoinTx::{
    join_id: 77L,
    waiter_sid: Some(999L),
    conn_id: 1L,
    viewer: station_api::Viewer::owner("alice@example.com", "ws-home"),
    lang: station_api::Lang::En,
    method_name: "POST",
    norm_path: "/workspaces/join",
    prep: prep,
    body_idx: 0,
    lock_hash: None,
    rig_person_hash: None,
    stream_id: Some(42),
    status: 0,
    body_chunks: [],
    total_bytes: 0,
    max_bytes: 262144,
    deadline_ms: 20000L,
    idem_claim: Some(("slot-1", "idem-1")),
  }
  tx.waiter_sid = None
  if tx.stream_id != Some(42) || tx.idem_claim.is_none() {
    panic("detaching waiter_sid must NOT close outbound stream or abort idem_claim")
  }
  // Verify P0: cloud.json peers WITHOUT `online` field MUST default to online=true (only explicit online:false is offline)
  let peer_no_online = base_codec::json_obj([
    ("id", base_codec::json_str("peer-no-online")),
    ("name", base_codec::json_str("Box B")),
    ("version", base_codec::json_str("0.1.0")),
  ])
  let peer_explicit_offline = base_codec::json_obj([
    ("id", base_codec::json_str("peer-offline")),
    ("name", base_codec::json_str("Box C")),
    ("online", base_codec::json_bool(false)),
  ])
  let peer_rig = base_codec::json_obj([
    ("id", base_codec::json_str("peer-rig")),
    ("mode", base_codec::json_str("tasks")),
  ])
  let parsed_peers = full_peer_stations_from_json([peer_no_online, peer_explicit_offline, peer_rig], "self-id")
  if parsed_peers.length() != 2 {
    panic("expected 2 non-rig peers, got " + parsed_peers.length().to_string())
  }
  if parsed_peers[0].id != "peer-no-online" || !parsed_peers[0].online {
    panic("peer without online field MUST default to online=true")
  }
  if parsed_peers[1].id != "peer-offline" || parsed_peers[1].online {
    panic("peer with explicit online=false MUST be offline")
  }
}

test "wave17e4b R3: join journal I/O preservation, promoted-home crash recovery, and ws_rename_owner mutex" {
  // 1. Local disk I/O errors MUST NOT be classified as deterministic invalid payload errors
  if is_deterministic_invalid_join_payload_err("EIO: disk full") {
    panic("local disk error must NOT clear redeemed 2xx join journal")
  }
  if !is_deterministic_invalid_join_payload_err("invalid join response JSON: unexpected EOF") {
    panic("invalid JSON payload must be classified as deterministic invalid payload")
  }
  // 2. Re-entrant promoted-home lock cleanup + new home pending pin recovery
  let files : Map[String, String] = Map::new()
  let data = "/tmp/w17e4b-r3-promo"
  let old_lock = station_cloud::lock_path(data, sep="/")
  let old_off = station_cloud::turned_off_path(old_lock)
  let new_pend = station_cloud::pending_lock_path(data, sep="/")
  files.set(old_lock, "{\"stale\":true}")
  files.set(old_off, "1")
  let cfs = station_cloud::CloudFs::{
    read_text: fn(p : String) -> Result[Option[String], String] { Ok(files.get(p)) },
    write_private_text: fn(p : String, t : String) -> Result[Unit, String] { files.set(p, t); Ok(()) },
    mkdir_p: fn(_p : String) -> Result[Unit, String] { Ok(()) },
    remove_file: fn(p : String) -> Result[Unit, String] { files.remove(p); Ok(()) },
    rename_file: fn(a : String, b : String) -> Result[Unit, String] {
      match files.get(a) { Some(v) => { files.set(b, v); files.remove(a) }, None => () }
      Ok(())
    },
    exists: fn(p : String) -> Bool { files.get(p).is_some() },
  }
  let pin_hash = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  match finalize_promoted_home_locks_with_fs(data, cfs, Some(pin_hash), "/") {
    Ok(_) => ()
    Err(e) => panic("finalize_promoted_home_locks_with_fs failed: " + e)
  }
  if files.get(old_lock).is_some() || files.get(old_off).is_some() {
    panic("promoted-home recovery must clear stale old home locks")
  }
  match files.get(new_pend) {
    Some(t) => if !t.contains(pin_hash) { panic("new home pending-lock missing pin_hash: " + t) }
    None => panic("promoted-home recovery must write new home pending-lock")
  }
}

test "wave17e4b R4: promoted-home lock cleanup propagates unlink errors and stages old_home_ws lock before removal" {
  let files : Map[String, String] = Map::new()
  let data = "/tmp/w17e4b-r4-promo"
  let old_lock = station_cloud::lock_path(data, sep="/")
  let staged_lock = station_cloud::joined_lock_path(data, "ws-old-home", sep="/")
  files.set(old_lock, "{\"head\":\"old-head\"}")
  // 1. Failing remove_file MUST propagate Err (never silently clear join journal!)
  let fail_cfs = station_cloud::CloudFs::{
    read_text: fn(p : String) -> Result[Option[String], String] { Ok(files.get(p)) },
    write_private_text: fn(p : String, t : String) -> Result[Unit, String] { files.set(p, t); Ok(()) },
    mkdir_p: fn(_p : String) -> Result[Unit, String] { Ok(()) },
    remove_file: fn(p : String) -> Result[Unit, String] { Err("EPERM: cannot unlink " + p) },
    rename_file: fn(_a : String, _b : String) -> Result[Unit, String] { Ok(()) },
    exists: fn(p : String) -> Bool { files.get(p).is_some() },
  }
  match finalize_promoted_home_locks_with_fs(data, fail_cfs, None, "/", old_home_ws="ws-old-home") {
    Ok(_) => panic("expected EPERM unlink failure to return Err, not Ok")
    Err(e) => if !e.contains("EPERM") { panic("unexpected error: " + e) }
  }
  // Old lock was safely staged under joined/ws-old-home/ before attempted removal!
  if files.get(staged_lock) != Some("{\"head\":\"old-head\"}") {
    panic("old home lock must be staged under joined/<old_home>/ before removal")
  }
  // 2. When remove_file succeeds, old lock is removed and staged copy remains intact
  let ok_cfs = station_cloud::CloudFs::{
    read_text: fn(p : String) -> Result[Option[String], String] { Ok(files.get(p)) },
    write_private_text: fn(p : String, t : String) -> Result[Unit, String] { files.set(p, t); Ok(()) },
    mkdir_p: fn(_p : String) -> Result[Unit, String] { Ok(()) },
    remove_file: fn(p : String) -> Result[Unit, String] { files.remove(p); Ok(()) },
    rename_file: fn(_a : String, _b : String) -> Result[Unit, String] { Ok(()) },
    exists: fn(p : String) -> Bool { files.get(p).is_some() },
  }
  match finalize_promoted_home_locks_with_fs(data, ok_cfs, None, "/", old_home_ws="ws-old-home") {
    Ok(_) => ()
    Err(e) => panic("finalize_promoted_home_locks_with_fs ok_cfs failed: " + e)
  }
  if files.get(old_lock).is_some() {
    panic("old home lock must be removed on success")
  }
  if files.get(staged_lock) != Some("{\"head\":\"old-head\"}") {
    panic("staged old home lock must remain intact")
  }
}

test "wave17e4b R5: join journal fail-closed, queued outbound RPC finite timeout, and CloudFs remove_file ENOENT vs error" {
  // 1. has_pending_redeemed_join_journal_with_fs fail-closed semantics
  let jpath = "/tmp/w17e4b-r5-join-pending.json"
  let make_fs = fn(res : Result[Option[String], String]) -> station_cloud::CloudFs {
    station_cloud::CloudFs::{
      read_text: fn(_p : String) -> Result[Option[String], String] { res },
      write_private_text: fn(_p : String, _t : String) -> Result[Unit, String] { Ok(()) },
      mkdir_p: fn(_p : String) -> Result[Unit, String] { Ok(()) },
      remove_file: fn(_p : String) -> Result[Unit, String] { Ok(()) },
      rename_file: fn(_a : String, _b : String) -> Result[Unit, String] { Ok(()) },
      exists: fn(_p : String) -> Bool { true },
    }
  }
  if has_pending_redeemed_join_journal_with_fs(jpath, make_fs(Ok(None))) {
    panic("missing join journal must return false")
  }
  if has_pending_redeemed_join_journal_with_fs(jpath, make_fs(Ok(Some("{\"phase\":\"intent\"}")))) {
    panic("explicit intent join journal must return false")
  }
  if !has_pending_redeemed_join_journal_with_fs(jpath, make_fs(Ok(Some("{\"phase\":\"redeemed\"}")))) {
    panic("redeemed join journal must return true")
  }
  if !has_pending_redeemed_join_journal_with_fs(jpath, make_fs(Ok(Some("{\"status\":200,\"body\":\"{}\"}")))) {
    panic("legacy join journal missing phase must fail-closed (true)")
  }
  if !has_pending_redeemed_join_journal_with_fs(jpath, make_fs(Ok(Some("{corrupt")))) {
    panic("corrupt join journal must fail-closed (true)")
  }
  if !has_pending_redeemed_join_journal_with_fs(jpath, make_fs(Err("EACCES"))) {
    panic("unreadable join journal must fail-closed (true)")
  }

  // 2. expire_queued_outbound_tells expires finite 15s continuation RPC even when mesh is offline
  let q : Array[OutboundTell] = [
    OutboundTell::{
      ask_id: 1L,
      peer: "peer-offline",
      method: "thread.classify",
      ref_id: "",
      payload: Bytes::new(0),
      attempts: 0,
      next_at_ms: 1000L,
      created_at_ms: 1000L,
      max_retry_ms: 15000L,
      on_ask_done: None,
    },
    OutboundTell::{
      ask_id: 2L,
      peer: "peer-default",
      method: "thread.classify",
      ref_id: "",
      payload: Bytes::new(0),
      attempts: 0,
      next_at_ms: 1000L,
      created_at_ms: 1000L,
      max_retry_ms: TELL_RETRY_MAX_MS,
      on_ask_done: None,
    },
  ]
  let expired = expire_queued_outbound_tells(q, 16000L)
  if expired.length() != 1 || expired[0].ask_id != 1L {
    panic("expected ask_id=1 to expire at 16000ms")
  }
  if q.length() != 1 || q[0].ask_id != 2L {
    panic("expected ask_id=2 to remain queued at 16000ms")
  }

  // 3. classify_unlink_result: unlinked / ENOENT -> Ok(()), real unlink failure -> Err(...)
  match classify_unlink_result(true, Ok("{}"), "/tmp/a") {
    Ok(_) => ()
    Err(e) => panic("unlinked=true must be Ok(()), got: " + e)
  }
  match classify_unlink_result(false, Err(-2), "/tmp/missing") {
    Ok(_) => ()
    Err(e) => panic("ENOENT (-2) must be Ok(()), got: " + e)
  }
  match classify_unlink_result(false, Err(-3), "/tmp/eacces") {
    Ok(_) => panic("EACCES (-3) must return Err")
    Err(e) => if !e.contains("err=-3") { panic("unexpected err: " + e) }
  }
  match classify_unlink_result(false, Ok("{\"type\":\"dir\"}"), "/tmp/dir") {
    Ok(_) => panic("existing entry after failed unlink must return Err")
    Err(e) => if !e.contains("unlink failed") { panic("unexpected err: " + e) }
  }

  // 4. First-time home promotion in station_cloud::apply_join_workspace_response propagates remove_file Err
  let p_files : Map[String, String] = Map::new()
  let p_data = "/tmp/w17e4b-r5-promote-unlink"
  p_files.set(station_cloud::state_path(p_data), "{\"origin\":\"https://api.still.fail\",\"workspace\":\"ws-old\",\"workspaceName\":\"Old\",\"name\":\"Box\",\"peers\":[],\"joined\":[]}")
  p_files.set(station_cloud::lock_path(p_data), "{\"head\":\"old\"}")
  let fail_rm_fs = station_cloud::CloudFs::{
    read_text: fn(p : String) -> Result[Option[String], String] { Ok(p_files.get(p)) },
    write_private_text: fn(p : String, t : String) -> Result[Unit, String] { p_files.set(p, t); Ok(()) },
    mkdir_p: fn(_p : String) -> Result[Unit, String] { Ok(()) },
    remove_file: fn(p : String) -> Result[Unit, String] { Err("EPERM: " + p) },
    rename_file: fn(_a : String, _b : String) -> Result[Unit, String] { Ok(()) },
    exists: fn(p : String) -> Bool { p_files.get(p).is_some() },
  }
  let p_seed = Bytes::new(32)
  for i in 0..<32 {
    p_seed[i] = (i + 31).to_byte()
  }
  let p_key = match station_cloud::StationKey::from_seed(p_seed) { Ok(k) => k, Err(e) => panic(e) }
  let p_pin = Some("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
  let p_prep = match station_cloud::prepare_join_workspace(p_data, fail_rm_fs, p_key, "tok_r5_1", "0.1.9999", 1700000000L, lock_hash=p_pin) {
    Ok(p) => p
    Err(e) => panic("prepare_join_workspace failed: " + e)
  }
  match station_cloud::apply_join_workspace_response(
    p_data,
    fail_rm_fs,
    p_prep,
    200,
    "{\"workspace\":\"ws-new\",\"workspace_name\":\"New\",\"name\":\"Box\",\"home\":\"ws-new\"}",
    1700000001L,
    lock_hash=p_pin,
  ) {
    Ok(_) => panic("first-time home promotion must propagate remove_file Err")
    Err(e) => if !e.contains("EPERM") { panic("expected EPERM from remove_file, got: " + e) }
  }
}
