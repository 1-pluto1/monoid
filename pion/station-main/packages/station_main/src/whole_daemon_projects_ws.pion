// Wave 17E-4B:
// 1. Durable async `workspaces.join` (`DurableJoinTx` owned by `WholeRuntimeState`, decoupled from
//    single HTTP connection/stream lifecycle; persists redeemed cloud result in `mesh/join-pending.json`
//    for crash recovery, fail-closed on `CloudStore::reload`, hot-switches `home_workspace`).
// 2. Durable async `projects.rename` & `projects.merge` (CSPRNG UUID v4 `opId`, cross-station
//    `projects.names` preflight, atomic SQLite + `preset_projects` migration + `PROJECTS.jsonl`
//    consumer with `forward_resolve_target` & CAS retry, single-flight cancellable peer RPCs,
//    shared durable continuation runner with `claim_rename_roster_result_sql`, and partial-outcome
//    `noCache` guard against `AdminApi` permanent success cache).
// 3. Inbound peer RPC handlers (`projects.names` with real `tags` + sorting + cap 200 + `countCapped`,
//    and `thread.classify` with `rename` + `effectiveWatermark`).

import "base_codec"
import "builders_core"
import "host_shim"
import "nodepath"
import "station_api"
import "station_cloud"
import "station_http"
import "station_ops"
import "station_sys"
import "station_whole"

/// Pre-allocated disjoint `station_sys` event ID range for Wave 17E-4B (`[13 << 32, 14 << 32)`).
pub let PROJECTS_WS_EVENT_BASE : Int64 = 55834574848L
pub let PROJECTS_WS_EVENT_END : Int64 = 60129542144L

/// Pre-allocated disjoint `MuxToken::Tagged` kinds (`5310..5319`) on `ctx.mux_role`.
pub let JOIN_TOK_HTTP_OPEN : Int = 5310
pub let JOIN_TOK_HTTP_READ : Int = 5311

// ---------------------------------------------------------------------------
// Shared JSON, Path & SSE helpers
// ---------------------------------------------------------------------------

fn pw_json_str(obj : base_codec::Json, key : String) -> Option[String] {
  match base_codec::json_get(obj, key) {
    Some(base_codec::Json::Str(s)) => Some(s)
    _ => None
  }
}

fn pw_json_bool(obj : base_codec::Json, key : String) -> Option[Bool] {
  match base_codec::json_get(obj, key) {
    Some(base_codec::Json::Bool(b)) => Some(b)
    _ => None
  }
}

fn pw_json_i64(obj : base_codec::Json, key : String) -> Option[Int64] {
  match base_codec::json_get(obj, key) {
    Some(base_codec::Json::Num(n, raw)) => match base_codec::parse_int64_str(raw) {
      Some(v) => Some(v)
      None => Some(n.to_int64())
    }
    _ => None
  }
}

/// Resolve configured `agentHome` from the active `ConfigFile` path (supporting `STILLFAIL_CONFIG`).
fn pw_agent_home(ctx : DaemonCtx, st : WholeRuntimeState) -> String {
  let cfg_override = match st.core.config_file {
    Some(cf) => Some(cf.path)
    None => None
  }
  station_whole::resolve_agent_home_ops(ctx.ops_fs, ctx.data, ctx.sep, config_path_override=cfg_override)
}

fn pw_home_ws(ctx : DaemonCtx, st : WholeRuntimeState) -> String {
  match ctx.cloud.home() {
    Some(h) if h.length() > 0 => h
    _ => st.core.api.auth_policy.home_workspace
  }
}

fn pw_is_read_only(v : station_api::Viewer) -> Bool {
  v.role == "read-only" || v.role == "readonly" || v.role == "viewer"
}

fn pw_emit_projects_sse(st : WholeRuntimeState, ws : String, now_ms : Int64) -> Unit {
  let target = station_api::EventTarget::{
    lang: None,
    viewer: None,
    device: None,
    email: None,
    workspace: Some(ws),
    subs: None,
    read_only: None,
    managers: None,
    vault: None,
    sees_ws: Some(Some(ws)),
    sees_session: None,
    sees_thread: None,
    sees_job: None,
  }
  let _ = st.core.api.events.emit(
    "projects",
    base_codec::json_obj([("workspace", base_codec::json_str(ws))]),
    target,
    now_ms,
    Some("projects:" + ws),
  )
}

/// Emit `chat-changed { thread }` SSE (aligned with `station/src/api/events.ts:1504`; NOT message stream `"thread"`).
fn pw_emit_thread_sse(st : WholeRuntimeState, tid : Int64, now_ms : Int64) -> Unit {
  let target = station_api::EventTarget::{
    lang: None,
    viewer: None,
    device: None,
    email: None,
    workspace: None,
    subs: None,
    read_only: None,
    managers: None,
    vault: None,
    sees_ws: None,
    sees_session: None,
    sees_thread: Some(tid.to_int()),
    sees_job: None,
  }
  let _ = st.core.api.events.emit(
    "chat-changed",
    base_codec::json_obj([("thread", base_codec::json_int64(tid))]),
    target,
    now_ms,
    Some("chat-changed:" + tid.to_string()),
  )
}

/// Emit private `presetProjects` SSE for a user `(ws, sub)` whose preset defaults were migrated.
fn pw_emit_preset_projects_sse(st : WholeRuntimeState, ws : String, sub : String, now_ms : Int64) -> Unit {
  let target = station_api::EventTarget::{
    lang: None,
    viewer: None,
    device: None,
    email: None,
    workspace: if ws.length() > 0 { Some(ws) } else { None },
    subs: Some([sub]),
    read_only: None,
    managers: None,
    vault: None,
    sees_ws: None,
    sees_session: None,
    sees_thread: None,
    sees_job: None,
  }
  let _ = st.core.api.events.emit(
    "presetProjects",
    base_codec::json_obj([("workspace", base_codec::json_str(ws))]),
    target,
    now_ms,
    Some("presetProjects:" + ws + ":" + sub),
  )
}

/// Build the 1:1 `GET /workspaces` / `POST /workspaces/join` workspace list view
/// matching `station/src/api/routes/workspaces.ts:14-21`.
pub fn workspaces_view_json(
  ctx : DaemonCtx,
  viewer : station_api::Viewer,
  now_s : Double,
) -> base_codec::Json {
  let memberships = ctx.cloud.memberships(now_s)
  let arr : Array[base_codec::Json] = []
  let can_manage = viewer.manages_station()
  for i in 0..<memberships.length() {
    let m = memberships[i]
    if can_manage || m.workspace == viewer.workspace {
      let mode = match m.rig {
        Some(_) => "tasks"
        None => "full"
      }
      arr.push(base_codec::json_obj([
        ("id", base_codec::json_str(m.workspace)),
        ("workspace", base_codec::json_str(m.workspace)),
        ("workspaceName", base_codec::json_str(m.workspace_name)),
        ("name", base_codec::json_str(m.name)),
        ("home", base_codec::json_bool(m.home)),
        ("mode", base_codec::json_str(mode)),
      ]))
    }
  }
  base_codec::json_obj([
    ("workspaces", base_codec::json_arr(arr)),
    ("canJoin", base_codec::json_bool(can_manage)),
  ])
}

// ---------------------------------------------------------------------------
// 1. Durable Async `workspaces.join` Transaction Owner (`WholeRuntimeState.durable_joins`)
// ---------------------------------------------------------------------------

fn join_pending_journal_path(ctx : DaemonCtx) -> String {
  nodepath::join(ctx.sep, [ctx.data, "mesh", "join-pending.json"])
}

fn persist_pending_join_intent(
  ctx : DaemonCtx,
  lock_hash : Option[String],
  rig_person_hash : Option[String],
  now_secs : Int64,
  provider : String,
  old_home_ws : String,
) -> Result[Unit, String] {
  let path = join_pending_journal_path(ctx)
  let parent = nodepath::dirname(ctx.sep, path)
  match (ctx.cloud.fs.mkdir_p)(parent) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let fields : Array[(String, base_codec::Json)] = [
    ("phase", base_codec::json_str("intent")),
    ("nowSecs", base_codec::json_int64(now_secs)),
    ("provider", base_codec::json_str(provider)),
    ("oldHome", base_codec::json_str(old_home_ws)),
  ]
  match lock_hash {
    Some(h) => fields.push(("lockHash", base_codec::json_str(h)))
    None => ()
  }
  match rig_person_hash {
    Some(h) => fields.push(("rigPersonHash", base_codec::json_str(h)))
    None => ()
  }
  (ctx.cloud.fs.write_private_text)(path, base_codec::json_stringify(base_codec::json_obj(fields)))
}

fn persist_pending_join_journal(
  ctx : DaemonCtx,
  status : Int,
  body_text : String,
  lock_hash : Option[String],
  rig_person_hash : Option[String],
  now_secs : Int64,
  provider : String,
  promoted_home : Bool,
  old_home_ws : String,
) -> Result[Unit, String] {
  let path = join_pending_journal_path(ctx)
  let parent = nodepath::dirname(ctx.sep, path)
  match (ctx.cloud.fs.mkdir_p)(parent) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let fields : Array[(String, base_codec::Json)] = [
    ("phase", base_codec::json_str("redeemed")),
    ("status", base_codec::json_int(status)),
    ("body", base_codec::json_str(body_text)),
    ("nowSecs", base_codec::json_int64(now_secs)),
    ("provider", base_codec::json_str(provider)),
    ("promotedHome", base_codec::json_bool(promoted_home)),
    ("oldHome", base_codec::json_str(old_home_ws)),
  ]
  match lock_hash {
    Some(h) => fields.push(("lockHash", base_codec::json_str(h)))
    None => ()
  }
  match rig_person_hash {
    Some(h) => fields.push(("rigPersonHash", base_codec::json_str(h)))
    None => ()
  }
  (ctx.cloud.fs.write_private_text)(path, base_codec::json_stringify(base_codec::json_obj(fields)))
}

/// Fail-closed check for an unfinished redeemed (or corrupt/unreadable/legacy-format) join journal.
/// Only returns `false` when the journal does not exist OR explicitly parses as `phase == "intent"`.
pub fn has_pending_redeemed_join_journal_with_fs(path : String, fs : station_cloud::CloudFs) -> Bool {
  let raw = match (fs.read_text)(path) {
    Ok(None) => return false
    Ok(Some(t)) => {
      if t.trim().length() == 0 {
        return true
      }
      t
    }
    Err(_) => return true
  }
  match base_codec::json_parse(raw) {
    base_codec::JsonParseResult::Ok(j) => {
      match pw_json_str(j, "phase") {
        Some("intent") => false
        _ => true
      }
    }
    _ => true
  }
}

fn has_pending_redeemed_join_journal(ctx : DaemonCtx) -> Bool {
  has_pending_redeemed_join_journal_with_fs(join_pending_journal_path(ctx), ctx.cloud.fs)
}

fn clear_pending_join_journal(ctx : DaemonCtx) -> Unit {
  let _ = (ctx.cloud.fs.remove_file)(join_pending_journal_path(ctx))
}

/// Deterministic check: returns true ONLY when a 2xx join response payload is invalid/unusable
/// (NOT on local filesystem/I/O errors, which MUST preserve `join-pending.json` for restart recovery).
pub fn is_deterministic_invalid_join_payload_err(msg : String) -> Bool {
  msg.contains("invalid join response JSON")
  || msg.contains("did not say which workspace")
  || msg.contains("did not say whose rig")
  || msg.contains("enrollment token is for workspace")
}

/// Idempotently finalize promoted-home lock cleanup + new home pending pin when recovering
/// a crash that occurred after `cloud.json` was promoted to the new home workspace.
/// Verifies old-home ownership if `old_home_ws` is given, and NEVER swallows unlink failures!
pub fn finalize_promoted_home_locks_with_fs(
  data : String,
  fs : station_cloud::CloudFs,
  lock_hash : Option[String],
  sep : String,
  old_home_ws : String = "",
) -> Result[Unit, String] {
  let remove_if_exists = fn(p : String) -> Result[Unit, String] {
    if !(fs.exists)(p) {
      return Ok(())
    }
    match (fs.remove_file)(p) {
      Ok(_) => Ok(())
      Err(e) => Err("failed to remove promoted old home lock " + p + ": " + e)
    }
  }
  // If `old_home_ws` was recorded and old home lock still exists, ensure it was staged under `joined/<old_home>/` before deleting!
  if old_home_ws.length() > 0 {
    let old_lock = station_cloud::lock_path(data, sep=sep)
    let staged_lock = station_cloud::joined_lock_path(data, old_home_ws, sep=sep)
    if (fs.exists)(old_lock) && !(fs.exists)(staged_lock) {
      match (fs.mkdir_p)(nodepath::dirname(sep, staged_lock)) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match (fs.read_text)(old_lock) {
        Ok(Some(content)) => match (fs.write_private_text)(staged_lock, content) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        Ok(None) => ()
        Err(e) => return Err(e)
      }
    }
  }
  match remove_if_exists(station_cloud::lock_path(data, sep=sep)) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match remove_if_exists(station_cloud::turned_off_path(station_cloud::lock_path(data, sep=sep))) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match remove_if_exists(station_cloud::pending_lock_path(data, sep=sep)) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match lock_hash {
    Some(h) => {
      (fs.write_private_text)(
        station_cloud::pending_lock_path(data, sep=sep),
        base_codec::json_stringify(base_codec::json_obj([("hash", base_codec::json_str(h))])),
      )
    }
    None => Ok(())
  }
}

/// Recover any redeemed-but-uncommitted `workspaces.join` journal (`mesh/join-pending.json`) on startup.
/// Re-entrant even when `cloud.json` was already promoted to the new home before a crash!
pub fn recover_pending_workspace_join(ctx : DaemonCtx, st : WholeRuntimeState) -> Unit {
  if st.core.api.read_only_handover {
    return
  }
  let path = join_pending_journal_path(ctx)
  let raw = match (ctx.cloud.fs.read_text)(path) {
    Ok(Some(t)) if t.trim().length() > 0 => t
    _ => return
  }
  let doc = match base_codec::json_parse(raw) {
    base_codec::JsonParseResult::Ok(j) => j
    _ => return
  }
  let phase = match pw_json_str(doc, "phase") { Some(p) => p, None => "redeemed" }
  if phase != "redeemed" {
    // Unredeemed intent left over from a crash/timeout before cloud returned 2xx: leave intact or wait for retry.
    return
  }
  let status = match pw_json_i64(doc, "status") { Some(v) => v.to_int(), None => 200 }
  let body_text = match pw_json_str(doc, "body") { Some(s) => s, None => return }
  let now_secs = match pw_json_i64(doc, "nowSecs") { Some(v) if v > 0L => v, _ => host_shim::wall_ms() / 1000L }
  let lock_hash = pw_json_str(doc, "lockHash")
  let rig_person_hash = pw_json_str(doc, "rigPersonHash")
  let promoted_home = pw_json_bool(doc, "promotedHome") == Some(true)
  let old_home_ws = match pw_json_str(doc, "oldHome") { Some(s) => s, None => "" }
  let state = match station_cloud::read_state(ctx.data, ctx.cloud.fs, sep=ctx.sep) {
    Ok(Some(s)) => s
    _ => return
  }
  let provider : station_cloud::Provider = match pw_json_str(doc, "provider") {
    Some(p) if p.length() > 0 => station_cloud::provider_of(p)
    _ => match state.provider {
      Some(p) => p
      None => station_cloud::Provider::Stillfail
    }
  }
  let prep = station_cloud::PreparedJoinRequest::{
    state: state,
    provider: provider,
    plane: station_cloud::spec_of(provider),
    url: "",
    bodies: [],
    is_rig: rig_person_hash.is_some(),
    verify_fn: st.core.api.auth_policy.verify_fn,
  }
  match station_cloud::apply_join_workspace_response(
    ctx.data,
    ctx.cloud.fs,
    prep,
    status,
    body_text,
    now_secs,
    lock_hash=lock_hash,
    at_machine=false,
    rig_person_hash=rig_person_hash,
    sep=ctx.sep,
  ) {
    Ok(jr) => {
      let eff_promoted = jr.became_home || promoted_home
      if eff_promoted {
        match finalize_promoted_home_locks_with_fs(ctx.data, ctx.cloud.fs, lock_hash, ctx.sep, old_home_ws=old_home_ws) {
          Ok(_) => ()
          Err(_) => return
        }
      }
      match apply_durable_join_reload(ctx, st, jr.workspace, eff_promoted) {
        Ok(_) => clear_pending_join_journal(ctx)
        Err(_) => ()
      }
    }
    Err(msg) => {
      if msg.contains("keeps another security mode record") {
        match apply_durable_join_reload(ctx, st, "", false) {
          Ok(_) => clear_pending_join_journal(ctx)
          Err(_) => ()
        }
      }
    }
  }
}

pub struct DurableJoinTx {
  pub join_id : Int64
  pub mut waiter_sid : Option[Int64]
  pub conn_id : Int64
  pub viewer : station_api::Viewer
  pub lang : station_api::Lang
  pub method_name : String
  pub norm_path : String
  pub prep : station_cloud::PreparedJoinRequest
  pub mut body_idx : Int
  pub lock_hash : Option[String]
  pub rig_person_hash : Option[String]
  pub mut stream_id : Option[Int]
  pub mut status : Int
  pub body_chunks : Array[Bytes]
  pub mut total_bytes : Int
  pub max_bytes : Int
  pub deadline_ms : Int64
  pub mut idem_claim : Option[(String, String)]
}

fn start_join_http_attempt(ctx : DaemonCtx, tx : DurableJoinTx) -> Unit {
  let body_str = if tx.body_idx < tx.prep.bodies.length() { tx.prep.bodies[tx.body_idx] } else { "{}" }
  let rem = tx.deadline_ms - host_shim::now_ms()
  let timeout = if rem > 1000L { rem } else { 1000L }
  let _ = ctx.mux_role.call_async_raw(
    builders_core::MuxToken::Tagged(0, JOIN_TOK_HTTP_OPEN, tx.join_id),
    "stream.open",
    live_build_stream_open_args("POST", tx.prep.url, [("content-type", "application/json")], timeout),
    Some(body_str.to_bytes()),
  )
}

/// Detach an HTTP waiter from an in-flight `DurableJoinTx` on client disconnect or HTTP timeout.
/// The durable transaction CONTINUES running to completion so `cloud.json` and `AdminApi`
/// idempotency never end up half-applied after a one-time token was already redeemed!
pub fn detach_durable_join_waiter(st : WholeRuntimeState, join_id : Int64) -> Unit {
  match st.durable_joins.get(join_id) {
    Some(tx) => {
      tx.waiter_sid = None
    }
    None => ()
  }
}

fn finish_durable_join_tx(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  tx : DurableJoinTx,
  resp : station_http::HttpResponse,
  cache_idem : Bool,
  send_resp : (DaemonCtx, Int64, station_http::HttpResponse) -> Unit,
) -> Unit {
  match tx.stream_id {
    Some(id) => {
      let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + id.to_string() + "}", None)
      tx.stream_id = None
    }
    None => ()
  }
  match tx.idem_claim {
    Some((slot_key, idem_key)) => {
      if cache_idem {
        st.core.api.admin.complete_async_idempotency(
          slot_key,
          idem_key,
          tx.viewer,
          tx.method_name,
          tx.norm_path,
          resp,
          host_shim::wall_ms(),
        )
      } else {
        st.core.api.admin.abort_async_idempotency(slot_key)
      }
      tx.idem_claim = None
    }
    None => ()
  }
  st.durable_joins.remove(tx.join_id)
  match tx.waiter_sid {
    Some(sid) => {
      tx.waiter_sid = None
      match st.admin_streams.get(sid) {
        Some(astream) => {
          astream.mode = AdminStreamMode::Done
          send_resp(ctx, sid, resp)
        }
        None => ()
      }
    }
    None => ()
  }
}

/// Reload `CloudStore` and update `PeerAuthPolicy` fail-closed: if `ctx.cloud.reload()` fails,
/// do NOT mutate `auth_policy` allowlist or `home_workspace`!
fn apply_durable_join_reload(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  joined_ws : String,
  became_home : Bool,
) -> Result[Unit, String] {
  if !ctx.cloud.reload() {
    return Err("failed to reload cloud state")
  }
  if became_home && joined_ws.length() > 0 {
    st.core.set_home_workspace(joined_ws)
  } else if joined_ws.length() > 0 {
    st.core.api.auth_policy.add_workspace(joined_ws)
  }
  let ms = ctx.cloud.memberships((host_shim::wall_ms() / 1000L).to_double())
  for i in 0..<ms.length() {
    st.core.api.auth_policy.add_workspace(ms[i].workspace)
  }
  st.core.api.events.overview_changed("workspaces")
  Ok(())
}

/// Start a durable, non-blocking `POST /workspaces/join` transaction.
pub fn start_durable_workspace_join(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  sid : Int64,
  conn_id : Int64,
  method_name : String,
  norm_path : String,
  body_bytes : Bytes,
  viewer : station_api::Viewer,
  lang : station_api::Lang,
  idem_claim : Option[(String, String)],
) -> Result[AsyncAdminHttpState, station_http::HttpResponse] {
  if !viewer.manages_station() {
    return Err(station_api::json_error(403, "only the owners and admins of this station's workspaces add it to another workspace"))
  }
  let raw_s = body_bytes.to_string().trim()
  let body = if raw_s.length() == 0 {
    base_codec::json_obj([])
  } else {
    match base_codec::json_parse(raw_s) {
      base_codec::JsonParseResult::Ok(j) => j
      base_codec::JsonParseResult::Err(_) => return Err(station_api::json_error(400, "invalid JSON"))
    }
  }
  let token = match pw_json_str(body, "token") {
    Some(t) if t.length() > 0 => t
    _ => return Err(station_api::json_error(400, "token is required"))
  }
  let lock_hash : Option[String] = match base_codec::json_get(body, "lock") {
    None | Some(base_codec::Json::Null) => None
    Some(base_codec::Json::Str(lh)) if live_is_hex64(lh) => Some(lh)
    _ => return Err(station_api::json_error(400, "lock: a lock's hash"))
  }
  let rig_person_hash : Option[String] = if pw_json_bool(body, "rig") == Some(true) {
    match pw_json_str(body, "person") {
      Some(ph) if live_is_hex64(ph) => Some(ph)
      _ => return Err(station_api::json_error(400, "person: owner's personal lock hash"))
    }
  } else {
    None
  }
  // Single-flight guard + redeemed journal protection: NEVER overwrite an unfinished `redeemed` journal!
  if st.durable_joins.keys().length() > 0 {
    return Err(station_api::json_error(409, "another workspace join is already in progress"))
  }
  if has_pending_redeemed_join_journal(ctx) {
    recover_pending_workspace_join(ctx, st)
    if has_pending_redeemed_join_journal(ctx) {
      return Err(station_api::json_error(409, "a previously redeemed workspace join is still pending local recovery; retry once storage is healthy"))
    }
  }
  let now_s = host_shim::wall_ms() / 1000L
  let ver = match st.core.updates.station.version {
    Some(v) if v.length() > 0 => v
    _ => "0.1." + st.core.api.auth_policy.station_build
  }
  let prep = match station_cloud::prepare_join_workspace(
    ctx.data,
    ctx.cloud.fs,
    ctx.station_key,
    token,
    ver,
    now_s,
    lock_hash=lock_hash,
    rig_person_hash=rig_person_hash,
    store=Some(ctx.cloud),
    verify_fn=st.core.api.auth_policy.verify_fn,
    sep=ctx.sep,
  ) {
    Ok(p) => p
    Err(e) => return Err(station_api::json_error(409, e))
  }
  let join_id = st.next_durable_op_id
  st.next_durable_op_id = st.next_durable_op_id + 1L
  let now_mono = host_shim::now_ms()
  let tx = DurableJoinTx::{
    join_id: join_id,
    waiter_sid: Some(sid),
    conn_id: conn_id,
    viewer: viewer,
    lang: lang,
    method_name: method_name,
    norm_path: norm_path,
    prep: prep,
    body_idx: 0,
    lock_hash: lock_hash,
    rig_person_hash: rig_person_hash,
    stream_id: None,
    status: 0,
    body_chunks: [],
    total_bytes: 0,
    max_bytes: 262144,
    deadline_ms: now_mono + 20000L,
    idem_claim: idem_claim,
  }
  // Persist durable join intent BEFORE outbound cloud redemption so a crash/timeout window never loses intent.
  match persist_pending_join_intent(
    ctx,
    lock_hash,
    rig_person_hash,
    now_s,
    station_cloud::provider_to_string(prep.provider),
    prep.state.workspace,
  ) {
    Ok(_) => ()
    Err(e) => return Err(station_api::json_error(500, "failed to persist join intent: " + e))
  }
  st.durable_joins.set(join_id, tx)
  start_join_http_attempt(ctx, tx)
  Ok(AsyncAdminHttpState::{
    sid: sid,
    conn_id: conn_id,
    method_name: method_name,
    norm_path: norm_path,
    op: AsyncAdminOpKind::WorkspaceJoin(join_id),
    viewer: viewer,
    lang: lang,
    stream_id: None,
    status: 0,
    body_chunks: [],
    total_bytes: 0,
    max_bytes: 0,
    deadline_ms: now_mono + 20000L,
    idem_claim: None,
  })
}

/// Drive `JOIN_TOK_HTTP_OPEN` / `JOIN_TOK_HTTP_READ` completions for a `DurableJoinTx`.
pub fn step_durable_join_http_done(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  kind : Int,
  join_id : Int64,
  d : host_shim::ShellDone,
  send_resp : (DaemonCtx, Int64, station_http::HttpResponse) -> Unit,
) -> Unit {
  let tx = match st.durable_joins.get(join_id) {
    Some(t) => t
    None => {
      if kind == JOIN_TOK_HTTP_OPEN {
        close_orphaned_async_stream_open(ctx, d)
      }
      return
    }
  }
  if kind == JOIN_TOK_HTTP_OPEN {
    match station_http::decode_stream_open_done(d) {
      Err(e) => {
        finish_durable_join_tx(ctx, st, tx, station_api::json_error(409, "join request failed: " + e.message), false, send_resp)
        return
      }
      Ok(head) => {
        tx.stream_id = Some(head.id)
        tx.status = head.status
        tx.body_chunks.clear()
        tx.total_bytes = 0
        let rem = tx.deadline_ms - host_shim::now_ms()
        if rem <= 0L {
          finish_durable_join_tx(ctx, st, tx, station_api::json_error(504, "join request timed out"), false, send_resp)
          return
        }
        let stall = if rem > 2147483647L { 2147483647 } else { rem.to_int() }
        let read_args = base_codec::json_stringify(base_codec::json_obj([
          ("id", base_codec::json_int(head.id)),
          ("stallMs", base_codec::json_int(stall)),
        ]))
        let _ = ctx.mux_role.call_async_raw(
          builders_core::MuxToken::Tagged(0, JOIN_TOK_HTTP_READ, tx.join_id),
          "stream.read",
          read_args,
          None,
        )
        return
      }
    }
  }
  if kind == JOIN_TOK_HTTP_READ {
    match station_http::decode_stream_read_done(d) {
      Err(e) => {
        finish_durable_join_tx(ctx, st, tx, station_api::json_error(409, "join response read failed: " + e.message), false, send_resp)
        return
      }
      Ok(chunk) => {
        match chunk {
          station_http::StreamChunk::End => {
            match tx.stream_id {
              Some(id) => {
                let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + id.to_string() + "}", None)
                tx.stream_id = None
              }
              None => ()
            }
            let body_text = live_concat_chunks(tx.body_chunks, tx.total_bytes).to_string()
            // Multi-prefix fallback on 401 `invalid_signature` (1:1 with `station/src/cli.ts:228-234`).
            if tx.status == 401 && tx.body_idx + 1 < tx.prep.bodies.length() {
              let mut is_bad_sig = false
              match base_codec::json_parse(body_text) {
                base_codec::JsonParseResult::Ok(j) => {
                  if pw_json_str(j, "error") == Some("invalid_signature") {
                    is_bad_sig = true
                  }
                }
                _ => ()
              }
              if is_bad_sig {
                tx.body_idx = tx.body_idx + 1
                start_join_http_attempt(ctx, tx)
                return
              }
            }
            let now_s = host_shim::wall_ms() / 1000L
            // Persist redeemed 2xx cloud response (including `promotedHome` flag) BEFORE local disk mutations
            // so a crash/restart or local I/O failure after one-time token redemption can still converge!
            if tx.status >= 200 && tx.status < 300 {
              let mut promoted_home = false
              match base_codec::json_parse(body_text) {
                base_codec::JsonParseResult::Ok(j) => {
                  let jws = match pw_json_str(j, "workspace") { Some(s) => s, None => "" }
                  let nh = match pw_json_str(j, "home") { Some(s) => s, None => "" }
                  if nh.length() > 0 && nh == jws && jws != tx.prep.state.workspace {
                    promoted_home = true
                  }
                }
                _ => ()
              }
              match persist_pending_join_journal(
                ctx,
                tx.status,
                body_text,
                tx.lock_hash,
                tx.rig_person_hash,
                now_s,
                station_cloud::provider_to_string(tx.prep.provider),
                promoted_home,
                tx.prep.state.workspace,
              ) {
                Ok(_) => ()
                Err(e) => {
                  finish_durable_join_tx(ctx, st, tx, station_api::json_error(500, "failed to persist join journal: " + e), false, send_resp)
                  return
                }
              }
            } else {
              // Explicit non-2xx cloud error response (token was not redeemed): safe to clear unredeemed intent journal.
              clear_pending_join_journal(ctx)
            }
            match station_cloud::apply_join_workspace_response(
              ctx.data,
              ctx.cloud.fs,
              tx.prep,
              tx.status,
              body_text,
              now_s,
              lock_hash=tx.lock_hash,
              at_machine=false,
              rig_person_hash=tx.rig_person_hash,
              sep=ctx.sep,
            ) {
              Ok(jr) => {
                match apply_durable_join_reload(ctx, st, jr.workspace, jr.became_home) {
                  Ok(_) => {
                    clear_pending_join_journal(ctx)
                    let view_j = workspaces_view_json(ctx, tx.viewer, now_s.to_double())
                    let joined_j = base_codec::json_obj([
                      ("workspace", base_codec::json_str(jr.workspace)),
                      ("workspaceName", base_codec::json_str(jr.workspace_name)),
                      ("name", base_codec::json_str(jr.name)),
                    ])
                    let out_fields : Array[(String, base_codec::Json)] = [("joined", joined_j)]
                    match view_j {
                      base_codec::Json::Obj(fs) => {
                        for fi in 0..<fs.length() {
                          out_fields.push(fs[fi])
                        }
                      }
                      _ => ()
                    }
                    finish_durable_join_tx(ctx, st, tx, station_api::json_ok(base_codec::json_obj(out_fields)), true, send_resp)
                  }
                  Err(re) => {
                    // Fail-closed: `CloudStore::reload` failed; keep `join-pending.json` for recovery and do NOT cache 200.
                    finish_durable_join_tx(ctx, st, tx, station_api::json_error(500, re), false, send_resp)
                  }
                }
              }
              Err(msg) => {
                // KeptLock: station DID join and updated `cloud.json`, so reload & notify before returning 409!
                if msg.contains("keeps another security mode record") {
                  match apply_durable_join_reload(ctx, st, "", false) {
                    Ok(_) => {
                      clear_pending_join_journal(ctx)
                      finish_durable_join_tx(ctx, st, tx, station_api::json_error(409, msg), true, send_resp)
                    }
                    Err(re) => {
                      finish_durable_join_tx(ctx, st, tx, station_api::json_error(500, re), false, send_resp)
                    }
                  }
                } else {
                  // NEVER delete a valid 2xx redeemed journal on local disk/I/O error!
                  // Only clear on deterministic invalid payload errors.
                  if tx.status >= 200 && tx.status < 300 && is_deterministic_invalid_join_payload_err(msg) {
                    clear_pending_join_journal(ctx)
                  }
                  let err_msg = if tx.status >= 400 && tx.status < 600 && !msg.contains("cannot add a station") {
                    controlled_join_error_message(tx.status)
                  } else {
                    msg
                  }
                  let err_status = if tx.status >= 200 && tx.status < 300 && !is_deterministic_invalid_join_payload_err(msg) {
                    500
                  } else {
                    409
                  }
                  finish_durable_join_tx(ctx, st, tx, station_api::json_error(err_status, err_msg), false, send_resp)
                }
              }
            }
            return
          }
          station_http::StreamChunk::Data(data) => {
            if data.length() > 0 {
              if tx.total_bytes + data.length() > tx.max_bytes {
                finish_durable_join_tx(ctx, st, tx, station_api::json_error(409, "join response body exceeded limit"), false, send_resp)
                return
              }
              tx.body_chunks.push(data)
              tx.total_bytes = tx.total_bytes + data.length()
            }
          }
        }
        let rem = tx.deadline_ms - host_shim::now_ms()
        if rem <= 0L {
          finish_durable_join_tx(ctx, st, tx, station_api::json_error(504, "join request timed out"), false, send_resp)
          return
        }
        let stream_id = match tx.stream_id {
          Some(id) => id
          None => {
            finish_durable_join_tx(ctx, st, tx, station_api::json_error(409, "join stream closed"), false, send_resp)
            return
          }
        }
        let stall = if rem > 2147483647L { 2147483647 } else { rem.to_int() }
        let read_args = base_codec::json_stringify(base_codec::json_obj([
          ("id", base_codec::json_int(stream_id)),
          ("stallMs", base_codec::json_int(stall)),
        ]))
        let _ = ctx.mux_role.call_async_raw(
          builders_core::MuxToken::Tagged(0, JOIN_TOK_HTTP_READ, tx.join_id),
          "stream.read",
          read_args,
          None,
        )
      }
    }
  }
}

/// Tick all in-flight durable join transactions (even those whose HTTP waiter detached).
pub fn tick_durable_joins(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  now_mono : Int64,
  send_resp : (DaemonCtx, Int64, station_http::HttpResponse) -> Unit,
) -> Unit {
  let ids = st.durable_joins.keys()
  for i in 0..<ids.length() {
    let jid = ids[i]
    match st.durable_joins.get(jid) {
      Some(tx) if now_mono >= tx.deadline_ms => {
        finish_durable_join_tx(ctx, st, tx, station_api::json_error(504, "join request timed out"), false, send_resp)
      }
      _ => ()
    }
  }
}

/// Cleanly close any open join streams on daemon shutdown.
pub fn shutdown_durable_joins(ctx : DaemonCtx, st : WholeRuntimeState) -> Unit {
  let ids = st.durable_joins.keys()
  for i in 0..<ids.length() {
    let jid = ids[i]
    match st.durable_joins.get(jid) {
      Some(tx) => {
        match tx.stream_id {
          Some(id) => {
            let _ = ctx.edge_hub.call_async_discard("stream.close", "{\"id\":" + id.to_string() + "}", None)
            tx.stream_id = None
          }
          None => ()
        }
        match tx.idem_claim {
          Some((slot_key, _)) => {
            st.core.api.admin.abort_async_idempotency(slot_key)
            tx.idem_claim = None
          }
          None => ()
        }
        st.durable_joins.remove(jid)
      }
      None => ()
    }
  }
}

// ---------------------------------------------------------------------------
// 2. Durable Async `projects.rename` & `projects.merge` + Continuation Runner
// ---------------------------------------------------------------------------

pub struct PeerStationTarget {
  pub id : String
  pub name : String
  pub online : Bool
}

/// Parse non-rig workspace peer stations from `cloud.json` (1:1 with `station/src/sessions/projects.ts:1564`):
/// ONLY explicit `online: false` marks a peer offline; missing `online` field is treated as online (`true`).
pub fn full_peer_stations_from_json(
  peers : Array[base_codec::Json],
  self_id : String,
) -> Array[PeerStationTarget] {
  let out : Array[PeerStationTarget] = []
  for i in 0..<peers.length() {
    let p = peers[i]
    let pid = match pw_json_str(p, "id") { Some(s) => s, None => "" }
    let pname = match pw_json_str(p, "name") { Some(s) => s, None => "" }
    let online = match pw_json_bool(p, "online") { Some(false) => false, _ => true }
    let mode = match pw_json_str(p, "mode") { Some(s) => s, None => "" }
    let has_rig = match base_codec::json_get(p, "rig") {
      None | Some(base_codec::Json::Null) => false
      _ => true
    }
    if pid.length() > 0 && pid != self_id && !has_rig && mode != "tasks" && mode != "rig" {
      out.push(PeerStationTarget::{ id: pid, name: pname, online: online })
    }
  }
  out
}

fn full_peer_stations_for_ws(ctx : DaemonCtx, ws : String) -> Array[PeerStationTarget] {
  let state = match ctx.cloud.state {
    Some(s) => s
    None => return []
  }
  let peers : Array[base_codec::Json] = if ws == state.workspace || ws.length() == 0 {
    state.peers
  } else {
    let mut found : Array[base_codec::Json] = []
    for i in 0..<state.joined.length() {
      if state.joined[i].workspace == ws {
        found = state.joined[i].peers
        break
      }
    }
    found
  }
  full_peer_stations_from_json(peers, ctx.station_key.id)
}

fn inflight_rpc_key(event_seq : Int64, peer_id : String) -> String {
  event_seq.to_string() + ":" + peer_id
}

pub struct DurableProjectOp {
  pub op_num : Int64
  pub mut waiter_sid : Option[Int64]
  pub viewer : station_api::Viewer
  pub ws : String
  pub action : String
  pub from_name : String
  pub to_name : String
  pub op_key : Option[String]
  pub method_name : String
  pub norm_path : String
  pub mut idem_claim : Option[(String, String)]
  pub mut phase : String
  pub mut settled : Bool
  pub mut preflight_remaining : Int
  pub mut preflight_from_known : Bool
  pub mut preflight_from_local : Bool
  pub mut preflight_to_known : Bool
  pub mut preflight_to_local : Bool
  pub mut preflight_to_uncertain : Option[String]
  pub preflight_rpc_ids : Array[Int64]
  pub mut all_peers : Array[PeerStationTarget]
  pub mut event_seq : Int64
  pub mut origin_seq : Int64
  pub mut op_id : String
  pub mut renamed_at : Int64
  pub mut wall_at : Int64
  pub mut is_continuation : Bool
  pub mut local_updated : Int
  pub mut local_skipped_locked : Int
  pub mut phase1_info_error : Option[String]
  pub mut roster_error : Option[String]
  pub mut remaining_rpcs : Int
  pub fanout_pending : Map[String, (String, Int64)]
  pub peer_results : Array[base_codec::Json]
  pub peer_statuses : Array[String]
  pub resolved_peer_ids : Array[String]
  pub mut any_remote_updated : Bool
  pub mut deadline_ms : Int64
}

pub fn detach_durable_project_op_waiter(st : WholeRuntimeState, op_num : Int64) -> Unit {
  match st.durable_project_ops.get(op_num) {
    Some(op) => {
      op.waiter_sid = None
    }
    None => ()
  }
}

fn release_ws_rename_owner(st : WholeRuntimeState, ws : String, op_num : Int64) -> Unit {
  if st.ws_rename_owner.get(ws) == Some(op_num) {
    st.ws_rename_owner.remove(ws)
  }
}

fn finish_project_op_error(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  op : DurableProjectOp,
  resp : station_http::HttpResponse,
  no_cache : Bool,
  send_resp : (DaemonCtx, Int64, station_http::HttpResponse) -> Unit,
) -> Unit {
  if op.settled {
    return
  }
  op.settled = true
  op.phase = "finalized"
  release_ws_rename_owner(st, op.ws, op.op_num)
  let to_cancel : Array[Int64] = []
  for i in 0..<op.preflight_rpc_ids.length() {
    to_cancel.push(op.preflight_rpc_ids[i])
  }
  op.preflight_rpc_ids.clear()
  for i in 0..<to_cancel.length() {
    let _ = ctx.cancel_peer_rpc(to_cancel[i])
  }
  match op.idem_claim {
    Some((slot_key, idem_key)) => {
      if no_cache {
        st.core.api.admin.abort_async_idempotency(slot_key)
      } else {
        st.core.api.admin.complete_async_idempotency(
          slot_key,
          idem_key,
          op.viewer,
          op.method_name,
          op.norm_path,
          resp,
          host_shim::wall_ms(),
        )
      }
      op.idem_claim = None
    }
    None => ()
  }
  st.durable_project_ops.remove(op.op_num)
  match op.waiter_sid {
    Some(sid) => {
      op.waiter_sid = None
      match st.admin_streams.get(sid) {
        Some(astream) => {
          astream.mode = AdminStreamMode::Done
          send_resp(ctx, sid, resp)
        }
        None => ()
      }
    }
    None => ()
  }
}

/// Enforce monotonic deadlines on in-flight `DurableProjectOp` preflight & peer fan-outs.
/// Cancels straggling peer RPCs immediately (never leaves 1h background retries!) and marks
/// timed-out peers as `status: "error"` so partial failures never enter `AdminApi` success cache.
pub fn tick_durable_project_ops(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  now_mono : Int64,
  send_resp : (DaemonCtx, Int64, station_http::HttpResponse) -> Unit,
) -> Unit {
  // Bounded local tick paging for continuation runner when a full 200-row batch was processed.
  if st.continuation_next_tick_ms > 0L && now_mono >= st.continuation_next_tick_ms {
    st.continuation_next_tick_ms = 0L
    run_pending_project_rename_continuations(ctx, st)
  }
  let ids = st.durable_project_ops.keys()
  for i in 0..<ids.length() {
    let op_num = ids[i]
    match st.durable_project_ops.get(op_num) {
      Some(op) if !op.settled && now_mono >= op.deadline_ms => {
        if op.phase == "preflight" {
          // Single completion entry: advance phase & detach pending RPC handles BEFORE cancelling
          // so any synchronous cancel callback NEVER triggers a second commit or duplicate UUID!
          op.phase = "preflight_timed_out"
          let to_cancel : Array[Int64] = []
          for ri in 0..<op.preflight_rpc_ids.length() {
            to_cancel.push(op.preflight_rpc_ids[ri])
          }
          op.preflight_rpc_ids.clear()
          for ri in 0..<to_cancel.length() {
            let _ = ctx.cancel_peer_rpc(to_cancel[ri])
          }
          if op.action == "rename" && op.preflight_to_uncertain.is_none() {
            op.preflight_to_uncertain = Some("peer lookup timed out")
          }
          let _ = complete_project_preflight_and_commit(ctx, st, op, send_resp)
        } else if op.phase == "fanout" {
          // Single completion entry: detach fanout_pending BEFORE cancelling!
          op.phase = "fanout_timed_out"
          let pks = op.fanout_pending.keys()
          let to_cancel : Array[Int64] = []
          for pi in 0..<pks.length() {
            let pid = pks[pi]
            match op.fanout_pending.get(pid) {
              Some((pname, rpc_id)) => {
                to_cancel.push(rpc_id)
                let key = inflight_rpc_key(op.event_seq, pid)
                match st.inflight_project_rpcs.get(key) {
                  Some((cur_id, _)) if cur_id == rpc_id => st.inflight_project_rpcs.remove(key)
                  _ => ()
                }
                let pfs : Array[(String, base_codec::Json)] = [
                  ("station", base_codec::json_str(pid)),
                  ("status", base_codec::json_str("error")),
                  ("error", base_codec::json_str("peer " + pid + " timed out")),
                ]
                if pname.length() > 0 {
                  pfs.push(("name", base_codec::json_str(pname)))
                }
                op.peer_results.push(base_codec::json_obj(pfs))
                op.peer_statuses.push("error")
              }
              None => ()
            }
            op.fanout_pending.remove(pid)
          }
          op.remaining_rpcs = 0
          for ri in 0..<to_cancel.length() {
            let _ = ctx.cancel_peer_rpc(to_cancel[ri])
          }
          let _ = finalize_project_rename_op(ctx, st, op, send_resp)
        }
      }
      _ => ()
    }
  }
}

fn project_has_entry_in_jsonl(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  ws : String,
  name : String,
  skip_private : Bool,
) -> Bool {
  let agent_home = pw_agent_home(ctx, st)
  let home = pw_home_ws(ctx, st)
  match station_whole::read_projects_jsonl_for_ws(ctx.ops_fs, agent_home, ws, home, ctx.sep, skip_private) {
    Ok(parsed) => {
      for i in 0..<parsed.entries.length() {
        if parsed.entries[i].name == name {
          return true
        }
      }
      false
    }
    Err(_) => false
  }
}

fn is_known_project_locally(ctx : DaemonCtx, st : WholeRuntimeState, ws : String, name : String) -> Bool {
  if name.length() == 0 {
    return true
  }
  let home = pw_home_ws(ctx, st)
  if station_whole::has_active_project_in_workspace_sql(st.core.store, ws, home, name) {
    return true
  }
  project_has_entry_in_jsonl(ctx, st, ws, name, false)
}

fn build_rename_result_json(
  action : String,
  from_name : String,
  to_name : String,
  local_updated : Int,
  local_skipped_locked : Int,
  info_error : Option[String],
  roster_error : Option[String],
  peers : Array[base_codec::Json],
) -> base_codec::Json {
  let fields : Array[(String, base_codec::Json)] = [
    ("action", base_codec::json_str(action)),
    ("from", base_codec::json_str(from_name)),
    ("to", base_codec::json_str(to_name)),
    (
      "local",
      base_codec::json_obj([
        ("updated", base_codec::json_int(local_updated)),
        ("skippedLocked", base_codec::json_int(local_skipped_locked)),
      ]),
    ),
  ]
  match info_error {
    Some(e) => fields.push(("infoError", base_codec::json_str(e)))
    None => ()
  }
  match roster_error {
    Some(e) => fields.push(("rosterError", base_codec::json_str(e)))
    None => ()
  }
  fields.push(("peers", base_codec::json_arr(peers)))
  base_codec::json_obj(fields)
}

/// Shared 4-state `pending_info` (`0|1|2|3`) convergence function used by BOTH foreground
/// `finalize_project_rename_op` and background `run_pending_project_rename_continuations`.
/// Never swallows SQLite errors (returns `Some(err)` so caller never caches 200 on DB failure).
fn converge_rename_info_state(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  event_seq : Int64,
  ws : String,
  from_name : String,
  to_name : String,
  renamed_at : Int64,
  wall_at : Int64,
  origin_seq : Int64,
  op_id : Option[String],
  allow_state_1 : Bool,
  extra_updated : Bool,
  initial_info_error : Option[String],
) -> Option[String] {
  let store = st.core.store
  let agent_home = pw_agent_home(ctx, st)
  let home = pw_home_ws(ctx, st)
  let now_ms = host_shim::wall_ms()
  let mut info_error = initial_info_error

  match station_whole::get_project_rename_event_sql(store, event_seq) {
    Err(e) => {
      if info_error.is_none() {
        info_error = Some(e)
      }
    }
    Ok(Some(latest)) => {
      if latest.pending_info_state == 1 && allow_state_1 {
        let events = match station_whole::list_project_rename_events_sql(store, ws) {
          Ok(evs) => evs
          Err(e) => return Some(e)
        }
        let eff_to = station_api::forward_resolve_target(
          events,
          to_name,
          renamed_at,
          origin_seq,
          op_id,
          wall_at,
        ).target
        let had_any = extra_updated || latest.local_updated > 0 || latest.remote_updated
        let keep_ops = station_whole::list_pending_rename_info_op_ids_sql(store, ws)
        match station_whole::apply_rename_project_info_file(
          ctx.ops_fs,
          agent_home,
          ws,
          home,
          ctx.sep,
          from_name,
          eff_to,
          renamed_at,
          had_any,
          op_id,
          Some(keep_ops),
        ) {
          Ok(ires) => {
            if ires.changed {
              pw_emit_projects_sse(st, ws, now_ms)
            }
            let next_st = if ires.already_applied || ires.changed || had_any || (latest.pending_peers.length() == 0 && !latest.pending_roster) {
              0
            } else {
              2
            }
            match station_whole::mark_rename_info_state_sql(store, event_seq, next_st) {
              Ok(_) => {
                match op_id {
                  Some(oid) if oid.length() > 0 => {
                    let keep_after = station_whole::list_pending_rename_info_op_ids_sql(store, ws)
                    let _ = station_whole::apply_prune_applied_op_ids_file(
                      ctx.ops_fs,
                      agent_home,
                      ws,
                      home,
                      ctx.sep,
                      [oid],
                      Some(keep_after),
                    )
                  }
                  _ => ()
                }
              }
              Err(e) => info_error = Some(e)
            }
          }
          Err(e) => info_error = Some(e)
        }
      } else if latest.pending_info_state == 3 {
        let events = match station_whole::list_project_rename_events_sql(store, ws) {
          Ok(evs) => evs
          Err(e) => return Some(e)
        }
        let eff_to = station_api::forward_resolve_target(
          events,
          to_name,
          renamed_at,
          origin_seq,
          op_id,
          wall_at,
        ).target
        if eff_to.length() > 0 {
          let keep_ops = station_whole::list_pending_rename_info_op_ids_sql(store, ws)
          match station_whole::apply_ensure_project_registered_file(
            ctx.ops_fs,
            agent_home,
            ws,
            home,
            ctx.sep,
            eff_to,
            renamed_at,
            Some(keep_ops),
          ) {
            Ok(changed) => {
              if changed {
                pw_emit_projects_sse(st, ws, now_ms)
              }
              match station_whole::mark_rename_info_state_sql(store, event_seq, 0) {
                Ok(_) => ()
                Err(e) => info_error = Some(e)
              }
            }
            Err(e) => info_error = Some(e)
          }
        } else {
          match station_whole::mark_rename_info_state_sql(store, event_seq, 0) {
            Ok(_) => ()
            Err(e) => info_error = Some(e)
          }
        }
      } else if latest.pending_info_state == 2 && latest.pending_peers.length() == 0 && !latest.pending_roster {
        match station_whole::mark_rename_info_state_sql(store, event_seq, 0) {
          Ok(_) => ()
          Err(e) => info_error = Some(e)
        }
      }
    }
    Ok(None) => ()
  }
  info_error
}

fn finalize_project_rename_op(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  op : DurableProjectOp,
  send_resp : (DaemonCtx, Int64, station_http::HttpResponse) -> Unit,
) -> station_http::HttpResponse {
  if op.settled {
    return station_api::json_ok(build_rename_result_json(
      op.action,
      op.from_name,
      op.to_name,
      op.local_updated,
      op.local_skipped_locked,
      op.phase1_info_error,
      op.roster_error,
      op.peer_results,
    ))
  }
  op.settled = true
  op.phase = "finalized"
  let store = st.core.store
  let now_ms = host_shim::wall_ms()
  let mut info_error = op.phase1_info_error
  let mut roster_error = op.roster_error

  match station_whole::mark_rename_peers_resolved_sql(store, op.event_seq, op.resolved_peer_ids, op.any_remote_updated) {
    Ok(_) => ()
    Err(e) => if info_error.is_none() { info_error = Some(e) }
  }

  info_error = converge_rename_info_state(
    ctx,
    st,
    op.event_seq,
    op.ws,
    op.from_name,
    op.to_name,
    op.renamed_at,
    op.wall_at,
    op.origin_seq,
    Some(op.op_id),
    op.is_continuation,
    op.local_updated > 0 || op.any_remote_updated,
    info_error,
  )

  // Verify durable SQLite state before allowing 200 to enter `AdminApi` permanent success idempotency cache!
  let mut durable_incomplete = false
  match station_whole::get_project_rename_event_sql(store, op.event_seq) {
    Ok(Some(latest)) => {
      if latest.pending_roster {
        durable_incomplete = true
        if roster_error.is_none() {
          roster_error = Some("pending_roster not yet claimed")
        }
      }
      if latest.pending_info_state != 0 || latest.pending_peers.length() > 0 {
        durable_incomplete = true
      }
    }
    Ok(None) => {
      durable_incomplete = true
      if info_error.is_none() {
        info_error = Some("durable project rename event missing during final verification")
      }
    }
    Err(e) => {
      durable_incomplete = true
      if info_error.is_none() {
        info_error = Some(e)
      }
    }
  }

  pw_emit_projects_sse(st, op.ws, now_ms)
  let res_json = build_rename_result_json(
    op.action,
    op.from_name,
    op.to_name,
    op.local_updated,
    op.local_skipped_locked,
    info_error,
    roster_error,
    op.peer_results,
  )
  let resp = station_api::json_ok(res_json)
  // Partial failure or unconfirmed durable state MUST NEVER be cached in `AdminApi` permanent success idempotency cache!
  let is_partial = durable_incomplete || station_whole::is_partial_rename_result(info_error, roster_error, op.peer_statuses)
  match op.idem_claim {
    Some((slot_key, idem_key)) => {
      if is_partial {
        st.core.api.admin.abort_async_idempotency(slot_key)
      } else {
        st.core.api.admin.complete_async_idempotency(
          slot_key,
          idem_key,
          op.viewer,
          op.method_name,
          op.norm_path,
          resp,
          now_ms,
        )
      }
      op.idem_claim = None
    }
    None => ()
  }
  st.durable_project_ops.remove(op.op_num)
  match op.waiter_sid {
    Some(sid) => {
      op.waiter_sid = None
      match st.admin_streams.get(sid) {
        Some(astream) => {
          astream.mode = AdminStreamMode::Done
          send_resp(ctx, sid, resp)
        }
        None => ()
      }
    }
    None => ()
  }
  resp
}

/// Start Phase 2 (peer fan-out) for `op` after Phase 1 has committed locally.
/// Returns `Some(resp)` if completed synchronously (no online peers), or `None` if async fan-out started.
fn start_project_op_fanout(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  op : DurableProjectOp,
  pending_peer_ids : Array[String],
  send_resp : (DaemonCtx, Int64, station_http::HttpResponse) -> Unit,
) -> Option[station_http::HttpResponse] {
  op.phase = "fanout"
  op.deadline_ms = host_shim::now_ms() + 30000L
  let online_targets : Array[PeerStationTarget] = []
  for pi in 0..<pending_peer_ids.length() {
    let pid = pending_peer_ids[pi]
    let mut found : Option[PeerStationTarget] = None
    for ai in 0..<op.all_peers.length() {
      if op.all_peers[ai].id == pid {
        found = Some(op.all_peers[ai])
        break
      }
    }
    let target = match found {
      Some(t) => t
      None => PeerStationTarget::{ id: pid, name: "", online: false }
    }
    if !target.online {
      let pfs : Array[(String, base_codec::Json)] = [
        ("station", base_codec::json_str(target.id)),
        ("status", base_codec::json_str("offline")),
      ]
      if target.name.length() > 0 {
        pfs.push(("name", base_codec::json_str(target.name)))
      }
      op.peer_results.push(base_codec::json_obj(pfs))
      op.peer_statuses.push("offline")
      if op.action == "merge" {
        op.resolved_peer_ids.push(target.id)
      }
    } else {
      online_targets.push(target)
    }
  }

  if online_targets.length() == 0 {
    return Some(finalize_project_rename_op(ctx, st, op, send_resp))
  }

  op.remaining_rpcs = online_targets.length()
  st.durable_project_ops.set(op.op_num, op)
  let rpc_req = base_codec::json_obj([
    ("method", base_codec::json_str("thread.classify")),
    (
      "rename",
      base_codec::json_obj([
        ("from", base_codec::json_str(op.from_name)),
        ("to", base_codec::json_str(op.to_name)),
        ("action", base_codec::json_str(op.action)),
        ("opId", base_codec::json_str(op.op_id)),
        ("renamedAt", base_codec::json_int64(op.renamed_at)),
        ("wallAt", base_codec::json_int64(op.wall_at)),
        ("originSeq", base_codec::json_int64(op.origin_seq)),
      ]),
    ),
  ])

  let op_num = op.op_num
  let ev_seq = op.event_seq
  for oi in 0..<online_targets.length() {
    let target = online_targets[oi]
    let sf_key = inflight_rpc_key(ev_seq, target.id)
    // Ownership-isolated single-flight `(event_seq, peer_id)`:
    // NEVER cancel another foreground request's in-flight RPC! Only take over a background continuation RPC.
    match st.inflight_project_rpcs.get(sf_key) {
      Some((_, true)) => {
        let pfs : Array[(String, base_codec::Json)] = [
          ("station", base_codec::json_str(target.id)),
          ("status", base_codec::json_str("error")),
          ("error", base_codec::json_str("peer rename RPC already in flight")),
        ]
        if target.name.length() > 0 {
          pfs.push(("name", base_codec::json_str(target.name)))
        }
        op.peer_results.push(base_codec::json_obj(pfs))
        op.peer_statuses.push("error")
        op.remaining_rpcs = op.remaining_rpcs - 1
        continue
      }
      Some((prev_rpc_id, false)) => {
        st.inflight_project_rpcs.remove(sf_key)
        let _ = ctx.cancel_peer_rpc(prev_rpc_id)
      }
      None => ()
    }
    let rpc_id = ctx.ask_peer_rpc_cancellable(target.id, op.ws, rpc_req, fn(res : Result[base_codec::Json, String]) -> Unit {
      match st.durable_project_ops.get(op_num) {
        None => ()
        Some(cur) if cur.settled || cur.phase != "fanout" => ()
        Some(cur) => {
          match cur.fanout_pending.get(target.id) {
            Some((_, expected_id)) => {
              cur.fanout_pending.remove(target.id)
              match st.inflight_project_rpcs.get(sf_key) {
                Some((cur_id, _)) if cur_id == expected_id => st.inflight_project_rpcs.remove(sf_key)
                _ => ()
              }
            }
            None => return
          }
          match res {
            Ok(ans) => {
              let upd = match pw_json_i64(ans, "updated") { Some(v) => v.to_int(), None => 0 }
              let skp = match pw_json_i64(ans, "skippedLocked") { Some(v) => v.to_int(), None => 0 }
              if upd > 0 {
                cur.any_remote_updated = true
              }
              let pfs : Array[(String, base_codec::Json)] = [
                ("station", base_codec::json_str(target.id)),
                ("status", base_codec::json_str("ok")),
                ("updated", base_codec::json_int(upd)),
                ("skippedLocked", base_codec::json_int(skp)),
              ]
              if target.name.length() > 0 {
                pfs.push(("name", base_codec::json_str(target.name)))
              }
              cur.peer_results.push(base_codec::json_obj(pfs))
              cur.peer_statuses.push("ok")
              cur.resolved_peer_ids.push(target.id)
            }
            Err(msg) => {
              let lower = wd_ascii_lower(msg)
              let status_s = if lower.contains("a rig does not") {
                cur.resolved_peer_ids.push(target.id)
                "rig"
              } else if lower.contains("unknown peer method") || lower.contains("unsupported") {
                cur.resolved_peer_ids.push(target.id)
                "unsupported"
              } else if lower.contains("timed out") || lower.contains("connection closed") || lower.contains("connection reset") {
                "error"
              } else if lower.contains("offline") || lower.contains("not connected") || lower.contains("unreachable") {
                if cur.action == "merge" {
                  cur.resolved_peer_ids.push(target.id)
                }
                "offline"
              } else {
                "error"
              }
              let pfs : Array[(String, base_codec::Json)] = [
                ("station", base_codec::json_str(target.id)),
                ("status", base_codec::json_str(status_s)),
                ("error", base_codec::json_str(msg)),
              ]
              if target.name.length() > 0 {
                pfs.push(("name", base_codec::json_str(target.name)))
              }
              cur.peer_results.push(base_codec::json_obj(pfs))
              cur.peer_statuses.push(status_s)
            }
          }
          cur.remaining_rpcs = cur.remaining_rpcs - 1
          if cur.remaining_rpcs <= 0 {
            let _ = finalize_project_rename_op(ctx, st, cur, send_resp)
          }
        }
      }
    })
    if rpc_id > 0L {
      op.fanout_pending.set(target.id, (target.name, rpc_id))
      st.inflight_project_rpcs.set(sf_key, (rpc_id, true))
    }
  }
  if op.remaining_rpcs <= 0 {
    return Some(finalize_project_rename_op(ctx, st, op, send_resp))
  }
  None
}

/// Complete async preflight checks, execute Phase 1 (atomic SQLite + `preset_projects` + `PROJECTS.jsonl`),
/// and transition into Phase 2 (peer fan-out).
fn complete_project_preflight_and_commit(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  op : DurableProjectOp,
  send_resp : (DaemonCtx, Int64, station_http::HttpResponse) -> Unit,
) -> Option[station_http::HttpResponse] {
  if op.settled || (op.phase != "preflight" && op.phase != "preflight_timed_out" && op.phase != "local_commit") {
    return None
  }
  op.phase = "committing"
  // Re-verify request identity (op_key) and live workspace invariants right before commit (under `ws_rename_owner`)!
  match op.op_key {
    Some(ok_s) => {
      match station_whole::find_project_rename_by_op_key_sql(st.core.store, op.ws, ok_s) {
        Some(ex) => {
          if ex.action != op.action || ex.from_name != op.from_name || ex.to_name != op.to_name {
            let r = station_api::json_error(409, "idempotency key already used for a different project rename/merge")
            finish_project_op_error(ctx, st, op, r, false, send_resp)
            return Some(r)
          }
        }
        None => ()
      }
    }
    None => ()
  }
  let from_still_known = if op.preflight_from_local {
    is_known_project_locally(ctx, st, op.ws, op.from_name)
  } else {
    op.preflight_from_known
  }
  if !from_still_known {
    let r = station_api::json_error(404, "unknown project \"" + op.from_name + "\": pick an existing project")
    finish_project_op_error(ctx, st, op, r, false, send_resp)
    return Some(r)
  }
  let to_still_known = if op.preflight_to_local && op.to_name.length() > 0 {
    is_known_project_locally(ctx, st, op.ws, op.to_name)
  } else {
    op.preflight_to_known
  }
  if op.action == "merge" && op.to_name.length() > 0 && !to_still_known {
    let r = station_api::json_error(404, "unknown project \"" + op.to_name + "\": pick an existing project")
    finish_project_op_error(ctx, st, op, r, false, send_resp)
    return Some(r)
  }
  // Re-verify workspace invariants right before atomic SQLite commit (under `ws_rename_owner`).
  if station_whole::has_unfinished_rename_from_sql(st.core.store, op.ws, op.from_name, op.to_name) {
    let r = station_api::json_error(
      409,
      "previous rename/merge from \"" + op.from_name + "\" still has pending work; retry it to completion before renaming \"" + op.from_name + "\" again",
    )
    finish_project_op_error(ctx, st, op, r, true, send_resp)
    return Some(r)
  }
  if op.action == "rename" {
    if station_whole::has_pending_project_target_sql(st.core.store, op.ws, op.to_name) {
      let r = station_api::json_error(409, "project \"" + op.to_name + "\" is already targeted by an unfinished rename/merge")
      finish_project_op_error(ctx, st, op, r, true, send_resp)
      return Some(r)
    }
    if op.preflight_to_known || is_known_project_locally(ctx, st, op.ws, op.to_name) {
      let r = station_api::json_error(409, "project \"" + op.to_name + "\" already exists; use merge instead")
      finish_project_op_error(ctx, st, op, r, false, send_resp)
      return Some(r)
    }
    match op.preflight_to_uncertain {
      Some(reason) => {
        let r = station_api::json_error(
          503,
          "cannot verify whether project \"" + op.to_name + "\" exists on peers (" + reason + "); retry when peers are reachable",
        )
        finish_project_op_error(ctx, st, op, r, true, send_resp)
        return Some(r)
      }
      None => ()
    }
  }

  let store = st.core.store
  let home = pw_home_ws(ctx, st)
  let agent_home = pw_agent_home(ctx, st)
  let now_ms = host_shim::wall_ms()
  let op_id = match station_whole::generate_project_op_id() {
    Ok(id) => id
    Err(e) => {
      let r = station_api::json_error(500, e)
      finish_project_op_error(ctx, st, op, r, true, send_resp)
      return Some(r)
    }
  }
  let wall_at = now_ms
  let last_at = station_whole::max_project_rename_at_sql(store, op.ws)
  let renamed_at = if wall_at > last_at { wall_at } else { last_at + 1L }
  let pending_peer_ids : Array[String] = []
  for pi in 0..<op.all_peers.length() {
    pending_peer_ids.push(op.all_peers[pi].id)
  }
  let committed = match station_whole::commit_local_project_rename_atomic_sql(
    store,
    op.ws,
    home,
    op.action,
    op.from_name,
    op.to_name,
    op.to_name,
    renamed_at,
    wall_at,
    None,
    op.op_key,
    Some(op_id),
    pending_peer_ids,
    false,
    true,
  ) {
    Ok(c) => c
    Err(e) => {
      let r = station_api::json_error(500, e)
      finish_project_op_error(ctx, st, op, r, true, send_resp)
      return Some(r)
    }
  }
  op.event_seq = committed.seq
  op.origin_seq = committed.origin_seq
  op.op_id = op_id
  op.renamed_at = renamed_at
  op.wall_at = wall_at
  op.local_updated = committed.updated
  op.local_skipped_locked = committed.skipped_locked
  for ti in 0..<committed.updated_thread_ids.length() {
    pw_emit_thread_sse(st, committed.updated_thread_ids[ti], now_ms)
  }
  for pi in 0..<committed.preset_notifies.length() {
    let (wk, sub) = committed.preset_notifies[pi]
    pw_emit_preset_projects_sse(st, wk, sub, now_ms)
  }

  // Phase 1 local PROJECTS.jsonl migration (pure local disk I/O with CAS retry).
  let keep_ops = station_whole::list_pending_rename_info_op_ids_sql(store, op.ws)
  match station_whole::apply_rename_project_info_file(
    ctx.ops_fs,
    agent_home,
    op.ws,
    home,
    ctx.sep,
    op.from_name,
    op.to_name,
    renamed_at,
    op.local_updated > 0,
    Some(op_id),
    Some(keep_ops),
  ) {
    Ok(ires) => {
      if ires.changed {
        pw_emit_projects_sse(st, op.ws, now_ms)
      }
      let next_st = if ires.already_applied || ires.changed || op.local_updated > 0 || pending_peer_ids.length() == 0 {
        0
      } else {
        2
      }
      match station_whole::mark_rename_info_state_sql(store, op.event_seq, next_st) {
        Ok(_) => {
          let keep_after = station_whole::list_pending_rename_info_op_ids_sql(store, op.ws)
          let _ = station_whole::apply_prune_applied_op_ids_file(
            ctx.ops_fs,
            agent_home,
            op.ws,
            home,
            ctx.sep,
            [op_id],
            Some(keep_after),
          )
        }
        Err(e) => op.phase1_info_error = Some(e)
      }
    }
    Err(e) => op.phase1_info_error = Some(e)
  }

  // Release per-workspace Phase 1 mutex BEFORE Phase 2 peer RPC fan-out (prevents AB-BA deadlock).
  release_ws_rename_owner(st, op.ws, op.op_num)
  start_project_op_fanout(ctx, st, op, pending_peer_ids, send_resp)
}

fn peer_projects_names_has(ans : base_codec::Json, target_name : String) -> Bool {
  match pw_json_bool(ans, "exists") {
    Some(true) => return true
    Some(false) => return false
    None => ()
  }
  // Legacy peer fallback: `{ projects: [{ name }] }`.
  match base_codec::json_get(ans, "projects") {
    Some(base_codec::Json::Arr(items)) => {
      for i in 0..<items.length() {
        if pw_json_str(items[i], "name") == Some(target_name) {
          return true
        }
      }
    }
    _ => ()
  }
  false
}

/// Start durable `POST /projects/rename` or `POST /projects/merge`.
/// Owns `idem_claim` completely (completes on clean success/4xx, aborts on `no_cache` or partial failure).
/// Returns `Ok(async_st)` when peer preflight or fan-out is in flight (zero blocking), or `Err(resp)` when
/// completed synchronously (or rejected with 4xx/5xx).
pub fn start_durable_project_rename_or_merge(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  sid : Int64,
  conn_id : Int64,
  method_name : String,
  norm_path : String,
  body_bytes : Bytes,
  viewer : station_api::Viewer,
  lang : station_api::Lang,
  idem_claim : Option[(String, String)],
  raw_idem_key : Option[String],
  send_resp : (DaemonCtx, Int64, station_http::HttpResponse) -> Unit,
) -> Result[AsyncAdminHttpState, station_http::HttpResponse] {
  let finish_sync = fn(resp : station_http::HttpResponse, no_cache : Bool) -> Result[AsyncAdminHttpState, station_http::HttpResponse] {
    match idem_claim {
      Some((slot_key, idem_key)) => {
        if no_cache {
          st.core.api.admin.abort_async_idempotency(slot_key)
        } else {
          st.core.api.admin.complete_async_idempotency(
            slot_key,
            idem_key,
            viewer,
            method_name,
            norm_path,
            resp,
            host_shim::wall_ms(),
          )
        }
      }
      None => ()
    }
    Err(resp)
  }
  let ws = viewer.workspace.trim()
  if ws.length() == 0 {
    return finish_sync(station_api::json_error(400, "workspace is required"), false)
  }
  if pw_is_read_only(viewer) {
    return finish_sync(station_api::json_error(403, "read-only members cannot rename or merge projects"), false)
  }
  if ctx.cloud.rig_in(ws).is_some() {
    return finish_sync(station_api::json_error(403, "a rig does not manage workspace projects"), false)
  }
  if body_bytes.length() > 262144 {
    return finish_sync(station_api::json_error(413, "request too large"), false)
  }
  let raw_s = body_bytes.to_string().trim()
  let body = if raw_s.length() == 0 {
    base_codec::json_obj([])
  } else {
    match base_codec::json_parse(raw_s) {
      base_codec::JsonParseResult::Ok(base_codec::Json::Obj(fs)) => base_codec::json_obj(fs)
      _ => return finish_sync(station_api::json_error(400, "invalid JSON body"), false)
    }
  }
  let action = if norm_path == "/projects/merge" { "merge" } else { "rename" }
  let raw_from = match pw_json_str(body, "from") {
    Some(s) => s
    None => return finish_sync(station_api::json_error(400, "from and to must be strings"), false)
  }
  let raw_to = match pw_json_str(body, "to") {
    Some(s) => s
    None => return finish_sync(station_api::json_error(400, "from and to must be strings"), false)
  }
  let from_name = match station_api::normalize_project_name(raw_from) {
    Ok(s) if s.length() > 0 => s
    Ok(_) => return finish_sync(station_api::json_error(400, "from is required"), false)
    Err(e) => return finish_sync(station_api::json_error(400, e), false)
  }
  let to_name = match station_api::normalize_project_name(raw_to) {
    Ok(s) => {
      if action == "rename" && s.length() == 0 {
        return finish_sync(station_api::json_error(400, "to is required for rename"), false)
      }
      s
    }
    Err(e) => return finish_sync(station_api::json_error(400, e), false)
  }
  if from_name == to_name {
    return finish_sync(station_api::json_error(400, "from and to must differ"), false)
  }

  let store = st.core.store
  let actor_id = if viewer.sub.length() > 0 { viewer.sub } else { viewer.email }
  let op_key : Option[String] = match raw_idem_key {
    Some(rk) if rk.trim().length() > 0 => Some(actor_id + "\u{0}" + action + "\u{0}" + rk.trim())
    _ => None
  }

  // Per-workspace Phase 1 mutex: serialize preflight + local SQLite commit so concurrent renames
  // (e.g. `X -> Z` and `Y -> Z`) can NEVER both pass preflight and silently merge!
  if st.ws_rename_owner.get(ws).is_some() {
    return finish_sync(
      station_api::json_error(409, "another project rename/merge is already in progress in this workspace; retry shortly"),
      true,
    )
  }

  let existing_by_op : Option[station_whole::DurableProjectRenameRow] = match op_key {
    Some(ok_s) => station_whole::find_project_rename_by_op_key_sql(store, ws, ok_s)
    None => None
  }
  match existing_by_op {
    Some(ex) => {
      if ex.action != action || ex.from_name != from_name || ex.to_name != to_name {
        return finish_sync(station_api::json_error(409, "idempotency key already used for a different project rename/merge"), false)
      }
      if ex.pending_peers.length() == 0 && !ex.pending_roster && ex.pending_info_state == 0 {
        let done_json = build_rename_result_json(action, ex.from_name, ex.to_name, 0, 0, None, None, [])
        return finish_sync(station_api::json_ok(done_json), false)
      }
    }
    None => ()
  }

  let unfinished : Option[station_whole::DurableProjectRenameRow] = match existing_by_op {
    Some(ex) => Some(ex)
    None => station_whole::find_unfinished_project_rename_sql(store, ws, action, from_name, to_name)
  }
  let is_continuation = unfinished.is_some()

  if !is_continuation && station_whole::has_unfinished_rename_from_sql(store, ws, from_name, to_name) {
    return finish_sync(
      station_api::json_error(
        409,
        "previous rename/merge from \"" + from_name + "\" still has pending work; retry it to completion before renaming \"" + from_name + "\" again",
      ),
      true,
    )
  }

  let all_peers = full_peer_stations_for_ws(ctx, ws)
  let all_peer_ids : Array[String] = []
  let online_peers : Array[PeerStationTarget] = []
  let offline_peers : Array[PeerStationTarget] = []
  for pi in 0..<all_peers.length() {
    all_peer_ids.push(all_peers[pi].id)
    if all_peers[pi].online {
      online_peers.push(all_peers[pi])
    } else {
      offline_peers.push(all_peers[pi])
    }
  }

  let op_num = st.next_durable_op_id
  st.next_durable_op_id = st.next_durable_op_id + 1L
  let op = DurableProjectOp::{
    op_num: op_num,
    waiter_sid: Some(sid),
    viewer: viewer,
    ws: ws,
    action: action,
    from_name: from_name,
    to_name: to_name,
    op_key: op_key,
    method_name: method_name,
    norm_path: norm_path,
    idem_claim: idem_claim,
    phase: "local_commit",
    settled: false,
    preflight_remaining: 0,
    preflight_from_known: true,
    preflight_from_local: false,
    preflight_to_known: false,
    preflight_to_local: false,
    preflight_to_uncertain: None,
    preflight_rpc_ids: [],
    all_peers: all_peers,
    event_seq: 0L,
    origin_seq: 0L,
    op_id: "",
    renamed_at: 0L,
    wall_at: 0L,
    is_continuation: is_continuation,
    local_updated: 0,
    local_skipped_locked: 0,
    phase1_info_error: None,
    roster_error: None,
    remaining_rpcs: 0,
    fanout_pending: Map::new(),
    peer_results: [],
    peer_statuses: [],
    resolved_peer_ids: [],
    any_remote_updated: false,
    deadline_ms: host_shim::now_ms() + 30000L,
  }

  match unfinished {
    Some(un) => {
      match op_key {
        Some(ok_s) if existing_by_op.is_none() => station_whole::bind_project_rename_op_key_sql(store, ws, ok_s, un.seq)
        _ => ()
      }
      op.event_seq = un.seq
      op.origin_seq = un.origin_seq
      op.op_id = match un.op_id {
        Some(id) if id.length() > 0 => id
        _ => match station_whole::generate_project_op_id() {
          Ok(id) => id
          Err(e) => return finish_sync(station_api::json_error(500, e), true)
        }
      }
      op.renamed_at = un.renamed_at
      op.wall_at = un.wall_at
      // Align 1:1 with `station/src/sessions/projects.ts:1549-1557`: claim `pending_roster=1` atomically!
      // Propagate SQLite errors explicitly (never fold SQL errors into `false`/`[]` and cache 200).
      let pending_peer_ids = if un.pending_roster {
        match station_whole::claim_rename_roster_result_sql(store, un.seq, all_peer_ids) {
          Ok(true) => all_peer_ids
          Ok(false) => match station_whole::get_project_rename_event_sql(store, un.seq) {
            Ok(Some(latest)) => latest.pending_peers
            Ok(None) => []
            Err(e) => {
              op.roster_error = Some(e)
              []
            }
          }
          Err(e) => {
            op.roster_error = Some(e)
            []
          }
        }
      } else {
        un.pending_peers
      }
      match start_project_op_fanout(ctx, st, op, pending_peer_ids, send_resp) {
        Some(resp) => {
          op.waiter_sid = None
          return Err(resp)
        }
        None => {
          return Ok(AsyncAdminHttpState::{
            sid: sid,
            conn_id: conn_id,
            method_name: method_name,
            norm_path: norm_path,
            op: AsyncAdminOpKind::ProjectRenameMerge(op_num),
            viewer: viewer,
            lang: lang,
            stream_id: None,
            status: 0,
            body_chunks: [],
            total_bytes: 0,
            max_bytes: 0,
            deadline_ms: op.deadline_ms + 5000L,
            idem_claim: None,
          })
        }
      }
    }
    None => ()
  }

  // Acquire per-workspace Phase 1 mutex across preflight -> local SQLite commit.
  st.ws_rename_owner.set(ws, op_num)

  // Fresh rename/merge: local preflight + optional async cross-station `projects.names` preflight.
  let local_from = is_known_project_locally(ctx, st, ws, from_name)
  let local_to = if to_name.length() == 0 { true } else { is_known_project_locally(ctx, st, ws, to_name) }
  if action == "rename" {
    if station_whole::has_pending_project_target_sql(store, ws, to_name) {
      release_ws_rename_owner(st, ws, op_num)
      return finish_sync(
        station_api::json_error(409, "project \"" + to_name + "\" is already targeted by an unfinished rename/merge"),
        true,
      )
    }
    if local_to {
      release_ws_rename_owner(st, ws, op_num)
      return finish_sync(
        station_api::json_error(409, "project \"" + to_name + "\" already exists; use merge instead"),
        false,
      )
    }
  }
  op.preflight_from_known = local_from
  op.preflight_from_local = local_from
  op.preflight_to_known = local_to
  op.preflight_to_local = local_to

  let need_from_peer = !local_from && online_peers.length() > 0
  let need_to_peer_merge = action == "merge" && to_name.length() > 0 && !local_to && online_peers.length() > 0
  let need_to_peer_rename = action == "rename" && (online_peers.length() > 0 || offline_peers.length() > 0)

  if !need_from_peer && !need_to_peer_merge && !need_to_peer_rename {
    // Pure local preflight succeeded or failed immediately without peer RPCs.
    if !local_from {
      release_ws_rename_owner(st, ws, op_num)
      return finish_sync(
        station_api::json_error(404, "unknown project \"" + from_name + "\": pick an existing project"),
        false,
      )
    }
    if action == "merge" && to_name.length() > 0 && !local_to {
      release_ws_rename_owner(st, ws, op_num)
      return finish_sync(
        station_api::json_error(404, "unknown project \"" + to_name + "\": pick an existing project"),
        false,
      )
    }
    op.waiter_sid = None
    match complete_project_preflight_and_commit(ctx, st, op, send_resp) {
      Some(resp) => return Err(resp)
      None => {
        op.waiter_sid = Some(sid)
        return Ok(AsyncAdminHttpState::{
          sid: sid,
          conn_id: conn_id,
          method_name: method_name,
          norm_path: norm_path,
          op: AsyncAdminOpKind::ProjectRenameMerge(op_num),
          viewer: viewer,
          lang: lang,
          stream_id: None,
          status: 0,
          body_chunks: [],
          total_bytes: 0,
          max_bytes: 0,
          deadline_ms: op.deadline_ms + 5000L,
          idem_claim: None,
        })
      }
    }
  }

  // Async cross-station preflight via `projects.names` (non-blocking, bounded to 10s matching Node PEER_RPC_TIMEOUT_MS).
  op.phase = "preflight"
  op.deadline_ms = host_shim::now_ms() + 10000L
  if action == "rename" && offline_peers.length() > 0 {
    op.preflight_to_uncertain = Some("peer " + offline_peers[0].id + " is offline")
  }
  let mut total_checks = 0
  if need_from_peer {
    total_checks = total_checks + online_peers.length()
  }
  if need_to_peer_merge || (need_to_peer_rename && online_peers.length() > 0) {
    total_checks = total_checks + online_peers.length()
  }
  if total_checks == 0 {
    // Only offline peers for `rename` -> immediate 503 uncertain!
    release_ws_rename_owner(st, ws, op_num)
    let reason = match op.preflight_to_uncertain { Some(r) => r, None => "peer offline" }
    return finish_sync(
      station_api::json_error(
        503,
        "cannot verify whether project \"" + to_name + "\" exists on peers (" + reason + "); retry when peers are reachable",
      ),
      true,
    )
  }

  op.preflight_remaining = total_checks
  st.durable_project_ops.set(op_num, op)

  let launch_preflight_check = fn(peer : PeerStationTarget, check_name : String, is_from : Bool) -> Unit {
    let req = base_codec::json_obj([
      ("method", base_codec::json_str("projects.names")),
      ("check", base_codec::json_str(check_name)),
    ])
    let rpc_id = ctx.ask_peer_rpc_cancellable(peer.id, ws, req, fn(res : Result[base_codec::Json, String]) -> Unit {
      match st.durable_project_ops.get(op_num) {
        None => ()
        Some(cur) if cur.settled || cur.phase != "preflight" => ()
        Some(cur) => {
          match res {
            Ok(ans) => {
              if peer_projects_names_has(ans, check_name) {
                if is_from {
                  cur.preflight_from_known = true
                } else {
                  cur.preflight_to_known = true
                }
              }
            }
            Err(msg) => {
              if !is_from && cur.action == "rename" {
                let lower = wd_ascii_lower(msg)
                let ignore = lower.contains("a rig does not") || lower.contains("unknown peer method") || lower.contains("unsupported")
                if !ignore && cur.preflight_to_uncertain.is_none() {
                  cur.preflight_to_uncertain = Some("peer " + peer.id + " lookup failed: " + msg)
                }
              }
            }
          }
          cur.preflight_remaining = cur.preflight_remaining - 1
          if cur.preflight_remaining <= 0 {
            cur.preflight_rpc_ids.clear()
            let _ = complete_project_preflight_and_commit(ctx, st, cur, send_resp)
          }
        }
      }
    })
    if rpc_id > 0L {
      op.preflight_rpc_ids.push(rpc_id)
    }
  }

  if need_from_peer {
    for i in 0..<online_peers.length() {
      launch_preflight_check(online_peers[i], from_name, true)
    }
  }
  if need_to_peer_merge || (need_to_peer_rename && online_peers.length() > 0) {
    for i in 0..<online_peers.length() {
      launch_preflight_check(online_peers[i], to_name, false)
    }
  }

  Ok(AsyncAdminHttpState::{
    sid: sid,
    conn_id: conn_id,
    method_name: method_name,
    norm_path: norm_path,
    op: AsyncAdminOpKind::ProjectRenameMerge(op_num),
    viewer: viewer,
    lang: lang,
    stream_id: None,
    status: 0,
    body_chunks: [],
    total_bytes: 0,
    max_bytes: 0,
    deadline_ms: op.deadline_ms + 5000L,
    idem_claim: None,
  })
}

/// Durable continuation runner: executed on startup (after store opens) and on cloud peer updates
/// to converge any unfinished `project_rename_events` (`pending_info != 0`, `pending_roster = 1`, or `pending_peers != '[]'`).
/// Shares `converge_rename_info_state` and `claim_rename_roster_result_sql` with foreground rename/merge,
/// and enforces single-flight `(event_seq, peer_id)` via `st.inflight_project_rpcs`.
pub fn run_pending_project_rename_continuations(ctx : DaemonCtx, st : WholeRuntimeState) -> Unit {
  if st.core.api.read_only_handover {
    return
  }
  let store = st.core.store
  let batch_limit = 200
  let unfinished = match station_whole::list_unfinished_project_renames_sql(
    store,
    after_seq=st.continuation_cursor_seq,
    limit=batch_limit,
  ) {
    Ok(rows) => rows
    Err(_) => return
  }
  if unfinished.length() == 0 {
    if st.continuation_cursor_seq > 0L {
      // Wrap cursor back to beginning for next pass so earlier rows are retried too.
      st.continuation_cursor_seq = 0L
    }
    return
  }
  // Advance cursor past the last seq in this batch (or wrap to 0 when fewer than `batch_limit` rows remain)
  // so >200 offline-blocked rows at the head NEVER starve later recoverable rows!
  // When a full page was returned, schedule bounded next-page local tick without waiting for a cloud frame.
  if unfinished.length() >= batch_limit {
    st.continuation_cursor_seq = unfinished[unfinished.length() - 1].seq
    st.continuation_next_tick_ms = host_shim::now_ms() + 1000L
  } else {
    st.continuation_cursor_seq = 0L
    st.continuation_next_tick_ms = 0L
  }

  for i in 0..<unfinished.length() {
    let ev = unfinished[i]
    let ws = ev.workspace
    let all_peers = full_peer_stations_for_ws(ctx, ws)
    let all_peer_ids : Array[String] = []
    for ai in 0..<all_peers.length() {
      all_peer_ids.push(all_peers[ai].id)
    }

    // Claim `pending_roster=1` atomically if needed (1:1 with `projects.ts:1549-1557`).
    let pending_peers = if ev.pending_roster {
      match station_whole::claim_rename_roster_result_sql(store, ev.seq, all_peer_ids) {
        Ok(true) => all_peer_ids
        Ok(false) => match station_whole::get_project_rename_event_sql(store, ev.seq) {
          Ok(Some(latest)) => latest.pending_peers
          _ => []
        }
        Err(_) => continue
      }
    } else {
      ev.pending_peers
    }

    let _ = converge_rename_info_state(
      ctx,
      st,
      ev.seq,
      ws,
      ev.from_name,
      ev.to_name,
      ev.renamed_at,
      ev.wall_at,
      ev.origin_seq,
      ev.op_id,
      true,
      false,
      None,
    )

    // Fan out any remaining pending peers that are currently online (single-flight per `(event_seq, peer_id)`).
    if pending_peers.length() > 0 {
      let oid_str = match ev.op_id { Some(s) => s, None => "" }
      let rpc_req = base_codec::json_obj([
        ("method", base_codec::json_str("thread.classify")),
        (
          "rename",
          base_codec::json_obj([
            ("from", base_codec::json_str(ev.from_name)),
            ("to", base_codec::json_str(ev.to_name)),
            ("action", base_codec::json_str(ev.action)),
            ("opId", base_codec::json_str(oid_str)),
            ("renamedAt", base_codec::json_int64(ev.renamed_at)),
            ("wallAt", base_codec::json_int64(ev.wall_at)),
            ("originSeq", base_codec::json_int64(ev.origin_seq)),
          ]),
        ),
      ])
      for pi in 0..<pending_peers.length() {
        let pid = pending_peers[pi]
        let sf_key = inflight_rpc_key(ev.seq, pid)
        if st.inflight_project_rpcs.get(sf_key).is_some() {
          continue
        }
        let mut is_online = false
        for ai in 0..<all_peers.length() {
          if all_peers[ai].id == pid && all_peers[ai].online {
            is_online = true
            break
          }
        }
        if is_online {
          let seq_cap = ev.seq
          let ws_cap = ws
          let from_cap = ev.from_name
          let to_cap = ev.to_name
          let ren_at_cap = ev.renamed_at
          let wall_at_cap = ev.wall_at
          let orig_cap = ev.origin_seq
          let op_id_cap = ev.op_id
          let rpc_id = ctx.ask_peer_rpc_cancellable(pid, ws, rpc_req, fn(res : Result[base_codec::Json, String]) -> Unit {
            match st.inflight_project_rpcs.get(sf_key) {
              Some((_, false)) => st.inflight_project_rpcs.remove(sf_key)
              _ => ()
            }
            match res {
              Ok(ans) => {
                let upd = match pw_json_i64(ans, "updated") { Some(v) => v.to_int(), None => 0 }
                match station_whole::mark_rename_peers_resolved_sql(st.core.store, seq_cap, [pid], upd > 0) {
                  Ok(_) => {
                    // Re-run shared info convergence so `pending_info=3` (remote updated) immediately registers in `PROJECTS.jsonl`!
                    let _ = converge_rename_info_state(
                      ctx,
                      st,
                      seq_cap,
                      ws_cap,
                      from_cap,
                      to_cap,
                      ren_at_cap,
                      wall_at_cap,
                      orig_cap,
                      op_id_cap,
                      true,
                      upd > 0,
                      None,
                    )
                  }
                  Err(_) => ()
                }
              }
              Err(msg) => {
                let lower = wd_ascii_lower(msg)
                if lower.contains("a rig does not") || lower.contains("unknown peer method") || lower.contains("unsupported") {
                  let _ = station_whole::mark_rename_peers_resolved_sql(st.core.store, seq_cap, [pid], false)
                }
              }
            }
          }, timeout_ms=15000L)
          if rpc_id > 0L {
            st.inflight_project_rpcs.set(sf_key, (rpc_id, false))
          }
        }
      }
    }
  }
}

// ---------------------------------------------------------------------------
// 3. Inbound Peer RPC Handlers (`projects.names` & `thread.classify` rename)
// ---------------------------------------------------------------------------

pub fn handle_peer_projects_names(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  ws : String,
  req : base_codec::Json,
) -> Result[base_codec::Json, String] {
  let home = pw_home_ws(ctx, st)
  let eff_ws = if ws.length() > 0 { ws } else { home }
  if ctx.cloud.rig_in(eff_ws).is_some() {
    return Err("a rig does not answer projects.names")
  }
  match pw_json_str(req, "check") {
    Some(raw_check) if raw_check.trim().length() > 0 => {
      let norm = match station_api::normalize_project_name(raw_check) {
        Ok(s) if s.length() > 0 => s
        _ => return Ok(base_codec::json_obj([("exists", base_codec::json_bool(false))]))
      }
      if station_whole::has_active_project_in_workspace_sql(st.core.store, eff_ws, home, norm) {
        return Ok(base_codec::json_obj([("exists", base_codec::json_bool(true))]))
      }
      let has_info = project_has_entry_in_jsonl(ctx, st, eff_ws, norm, true)
      return Ok(base_codec::json_obj([("exists", base_codec::json_bool(has_info))]))
    }
    _ => ()
  }
  let (local_projects, local_tags) = station_whole::workspace_project_names_and_tags_sql(st.core.store, eff_ws, home, 200)
  let by_name : Map[String, (Int, Bool)] = Map::new()
  for i in 0..<local_projects.length() {
    let (name, cnt, capped) = local_projects[i]
    by_name.set(name, (cnt, capped))
  }
  let agent_home = pw_agent_home(ctx, st)
  match station_whole::read_projects_jsonl_for_ws(ctx.ops_fs, agent_home, eff_ws, home, ctx.sep, true) {
    Ok(parsed) => {
      for i in 0..<parsed.entries.length() {
        let name = parsed.entries[i].name
        if by_name.get(name).is_none() {
          by_name.set(name, (0, false))
        }
      }
    }
    Err(_) => ()
  }
  let merged : Array[(String, Int, Bool)] = []
  let ks = by_name.keys()
  for i in 0..<ks.length() {
    let k = ks[i]
    match by_name.get(k) {
      Some((c, cap)) => merged.push((k, c, cap))
      None => ()
    }
  }
  station_whole::sort_name_counts(merged)
  let p_arr : Array[base_codec::Json] = []
  let p_limit = if merged.length() < 200 { merged.length() } else { 200 }
  for i in 0..<p_limit {
    let (name, cnt, capped) = merged[i]
    let fs : Array[(String, base_codec::Json)] = [
      ("name", base_codec::json_str(name)),
      ("count", base_codec::json_int(cnt)),
    ]
    if capped {
      fs.push(("countCapped", base_codec::json_bool(true)))
    }
    p_arr.push(base_codec::json_obj(fs))
  }
  let t_arr : Array[base_codec::Json] = []
  let t_limit = if local_tags.length() < 200 { local_tags.length() } else { 200 }
  for i in 0..<t_limit {
    let (name, cnt, capped) = local_tags[i]
    let fs : Array[(String, base_codec::Json)] = [
      ("name", base_codec::json_str(name)),
      ("count", base_codec::json_int(cnt)),
    ]
    if capped {
      fs.push(("countCapped", base_codec::json_bool(true)))
    }
    t_arr.push(base_codec::json_obj(fs))
  }
  Ok(base_codec::json_obj([
    ("projects", base_codec::json_arr(p_arr)),
    ("tags", base_codec::json_arr(t_arr)),
  ]))
}

pub fn handle_peer_thread_classify_rename(
  ctx : DaemonCtx,
  st : WholeRuntimeState,
  ws : String,
  req : base_codec::Json,
) -> Result[base_codec::Json, String] {
  let home = pw_home_ws(ctx, st)
  let eff_ws = if ws.length() > 0 { ws } else { home }
  if ctx.cloud.rig_in(eff_ws).is_some() {
    return Err("a rig does not answer thread.classify")
  }
  if st.core.api.read_only_handover {
    return Err("this station is in read-only handover mode")
  }
  let ren = match base_codec::json_get(req, "rename") {
    Some(base_codec::Json::Obj(fs)) => base_codec::json_obj(fs)
    _ => return Err("unsupported thread.classify payload")
  }
  let raw_from = match pw_json_str(ren, "from") {
    Some(s) => s
    None => return Err("rename.from and rename.to must be strings")
  }
  let raw_to = match pw_json_str(ren, "to") {
    Some(s) => s
    None => return Err("rename.from and rename.to must be strings")
  }
  let from_name = match station_api::normalize_project_name(raw_from) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let to_name = match station_api::normalize_project_name(raw_to) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let action = match pw_json_str(ren, "action") {
    Some("merge") => "merge"
    _ => "rename"
  }
  let op_id : Option[String] = match pw_json_str(ren, "opId") {
    Some(s) if s.trim().length() > 0 => Some(s.trim())
    _ => None
  }
  let now_ms = host_shim::wall_ms()
  let renamed_at = match pw_json_i64(ren, "renamedAt") { Some(v) if v > 0L => v, _ => now_ms }
  let wall_at = match pw_json_i64(ren, "wallAt") { Some(v) if v > 0L => v, _ => renamed_at }
  let origin_seq = match pw_json_i64(ren, "originSeq") { Some(v) => v, None => 0L }

  // Share per-workspace write owner with HTTP rename/merge so inbound peer renames never race local preflight/commit!
  if st.ws_rename_owner.get(eff_ws).is_some() {
    return Err("workspace project rename/merge is currently in progress; retry shortly")
  }
  st.ws_rename_owner.set(eff_ws, -1L)

  let events = match station_whole::list_project_rename_events_sql(st.core.store, eff_ws) {
    Ok(evs) => evs
    Err(e) => {
      release_ws_rename_owner(st, eff_ws, -1L)
      return Err(e)
    }
  }
  let resolved = station_api::forward_resolve_target(events, to_name, renamed_at, origin_seq, op_id, wall_at)
  let eff_wm : Option[station_whole::EffectiveWatermark] = if resolved.advanced {
    Some(station_whole::EffectiveWatermark::{
      at: resolved.at,
      wall_at: resolved.wall_at,
      origin_seq: resolved.origin_seq,
      seq: resolved.seq,
    })
  } else {
    None
  }
  let committed = match station_whole::commit_local_project_rename_atomic_sql(
    st.core.store,
    eff_ws,
    home,
    action,
    from_name,
    to_name,
    resolved.target,
    renamed_at,
    wall_at,
    Some(origin_seq),
    None,
    op_id,
    [],
    false,
    false,
    effective_watermark=eff_wm,
  ) {
    Ok(c) => {
      release_ws_rename_owner(st, eff_ws, -1L)
      c
    }
    Err(e) => {
      release_ws_rename_owner(st, eff_ws, -1L)
      return Err(e)
    }
  }
  for ti in 0..<committed.updated_thread_ids.length() {
    pw_emit_thread_sse(st, committed.updated_thread_ids[ti], now_ms)
  }
  for pi in 0..<committed.preset_notifies.length() {
    let (wk, sub) = committed.preset_notifies[pi]
    pw_emit_preset_projects_sse(st, wk, sub, now_ms)
  }
  pw_emit_projects_sse(st, eff_ws, now_ms)
  Ok(base_codec::json_obj([
    ("updated", base_codec::json_int(committed.updated)),
    ("skippedLocked", base_codec::json_int(committed.skipped_locked)),
  ]))
}
